{# templates/home/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🏠 Accueil - LOBBY.GG</title>
    <link rel="stylesheet" href="{{ asset('css/neon-cyber.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #8B3DFF;
            --secondary: #ff0080;
            --accent: #00f2ff;
            --bg-dark: #0a0a0a;
            --glass: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            background: var(--bg-dark);
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(139, 61, 255, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(255, 0, 128, 0.15) 0%, transparent 40%);
            margin: 0;
            padding: 0;
            font-family: 'Courier New', monospace;
            color: #fff;
            overflow-x: hidden;
            display: block; /* Override the flex display from neon-cyber.css */
            min-height: auto;
        }

        /* --- HERO SECTION --- */
        .hero-container {
            position: relative;
            min-height: 100vh;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 120px 20px 60px;
            box-sizing: border-box;
        }

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url("{{ asset('images/user/home.jpg') }}") no-repeat center center;
            background-size: cover;
            filter: brightness(0.3) saturate(1.2);
            z-index: -1;
            transform: scale(1.1);
        }

        .hero-content {
            text-align: center;
            z-index: 1;
            width: 100%;
            max-width: 1200px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .hero-title {
            font-size: clamp(3.5rem, 12vw, 8rem);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: clamp(5px, 2vw, 20px);
            margin-bottom: 20px;
            background: linear-gradient(to bottom, #fff 40%, rgba(255,255,255,0.5));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 30px rgba(139, 61, 255, 0.6));
            line-height: 0.9;
            width: 100%;
        }

        .hero-subtitle {
            font-size: clamp(1rem, 2vw, 1.4rem);
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 8px;
            margin-bottom: 30px;
            opacity: 0.9;
            font-weight: bold;
        }

        .hero-description {
            margin-bottom: 50px;
            color: rgba(255,255,255,0.8);
            font-size: clamp(1rem, 1.5vw, 1.2rem);
            line-height: 1.8;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-btns {
            display: flex;
            gap: 25px;
            justify-content: center;
            width: 100%;
        }

        .btn-cyber {
            position: relative;
            padding: 15px 40px;
            font-size: 1.1rem;
            text-transform: uppercase;
            font-weight: 900;
            letter-spacing: 3px;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            clip-path: polygon(10% 0%, 100% 0%, 90% 100%, 0% 100%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 220px;
        }

        .btn-cyber-primary {
            background: var(--primary);
            color: #fff;
            border: none;
            box-shadow: 0 0 20px rgba(139, 61, 255, 0.4);
        }

        .btn-cyber-primary:hover {
            background: #fff;
            color: var(--primary);
            box-shadow: 0 0 40px rgba(255, 255, 255, 0.6);
            transform: translateY(-5px) scale(1.05);
        }

        .btn-cyber-outline {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(5px);
        }

        .btn-cyber-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-5px) scale(1.05);
        }

        /* --- STATS SECTION --- */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2px;
            background: var(--glass-border);
            border-top: 1px solid var(--glass-border);
            border-bottom: 1px solid var(--glass-border);
            margin: 0;
            width: 100%;
        }

        .stat-card {
            background: rgba(10, 10, 10, 0.9);
            padding: 40px 20px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            background: rgba(139, 61, 255, 0.1);
        }

        .stat-number {
            display: block;
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 900;
            color: var(--accent);
            margin-bottom: 5px;
            font-family: 'Courier New', monospace;
        }

        .stat-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: rgba(255,255,255,0.5);
            font-weight: bold;
        }

        /* --- FEATURES SECTION --- */
        .section-container {
            padding: 100px 40px;
            max-width: 1400px;
            margin: 0 auto;
            position: relative;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title {
            font-size: clamp(2rem, 5vw, 3rem);
            text-transform: uppercase;
            letter-spacing: 10px;
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
        }

        .section-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: var(--primary);
            box-shadow: 0 0 15px var(--primary);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
        }

        .feature-card {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            padding: 50px 30px;
            border-radius: 20px;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            backdrop-filter: blur(10px);
        }

        .feature-card:hover {
            border-color: var(--primary);
            transform: translateY(-10px);
            background: rgba(139, 61, 255, 0.08);
            box-shadow: 0 10px 30px rgba(139, 61, 255, 0.2);
        }

        .feature-icon {
            font-size: 3rem;
            color: var(--primary);
            margin-bottom: 25px;
            display: inline-block;
            filter: drop-shadow(0 0 10px var(--primary));
        }

        .feature-card h3 {
            font-size: 1.5rem;
            text-transform: uppercase;
            margin-bottom: 15px;
            letter-spacing: 2px;
        }

        .feature-card p {
            color: rgba(255,255,255,0.6);
            line-height: 1.6;
            font-size: 0.95rem;
        }

        /* --- MARKET PREVIEW --- */
        .market-preview {
            background: rgba(139, 61, 255, 0.03);
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .product-card {
            background: rgba(20, 20, 20, 0.8);
            border: 1px solid var(--glass-border);
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .product-card:hover {
            border-color: var(--accent);
            transform: scale(1.02);
        }

        .product-img {
            height: 200px;
            background: #111;
            position: relative;
            overflow: hidden;
        }

        .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-img img {
            transform: scale(1.1);
        }

        .product-info {
            padding: 25px;
            text-align: center;
        }

        .product-price {
            color: var(--accent);
            font-weight: bold;
            font-size: 1.2rem;
            display: block;
            margin-bottom: 10px;
        }

        .product-name {
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }

        /* --- FOOTER --- */
        .cyber-footer {
            padding: 60px 40px;
            background: #050505;
            border-top: 1px solid var(--glass-border);
            text-align: center;
        }

        .footer-logo {
            font-size: 2rem;
            letter-spacing: 5px;
            margin-bottom: 30px;
            display: block;
            text-decoration: none;
            color: #fff;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 40px;
        }

        .social-link {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--glass);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-decoration: none;
            font-size: 1.2rem;
            transition: all 0.3s ease;
            border: 1px solid var(--glass-border);
        }

        .social-link:hover {
            background: var(--primary);
            border-color: var(--primary);
            box-shadow: 0 0 15px var(--primary);
            transform: translateY(-5px);
        }

        .copyright {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.3);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* Scanline effect */
        .scanlines {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                to bottom,
                transparent 50%,
                rgba(0, 0, 0, 0.05) 51%,
                transparent 51%
            );
            background-size: 100% 4px;
            z-index: 9999;
            pointer-events: none;
            opacity: 0.3;
        }

        @media (max-width: 768px) {
            .hero-btns { flex-direction: column; }
            .section-container { padding: 60px 20px; }
        }
    </style>
</head>
<body>
    <div class="scanlines"></div>
    {% include 'partials/_cyber_navbar.html.twig' %}

    <main>
        <!-- HERO -->
        <section class="hero-container">
            <div class="hero-bg"></div>
            <div class="hero-content">
                <div class="hero-subtitle">THE NEXT GEN GAMING HUB</div>
                <h1 class="hero-title">LOBBY.GG</h1>
                <p class="hero-description">
                    Rejoignez l'élite. Participez à des tournois, dominez le marketplace et trouvez les meilleurs sponsors pour votre carrière gaming.
                </p>
                <div class="hero-btns">
                    <a href="{{ path('front_marketplace') }}" class="btn-cyber btn-cyber-primary">Explore Market</a>
                    <a href="{{ path('front_tournaments') }}" class="btn-cyber btn-cyber-outline">Browse Tourneys</a>
                </div>
            </div>
        </section>

        <!-- STATS -->
        <section class="stats-grid">
            <div class="stat-card">
                <span class="stat-number">{{ stats.users|default(0) }}+</span>
                <span class="stat-label">Gamers Actifs</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">{{ stats.tournaments|default(0) }}</span>
                <span class="stat-label">Tournois Live</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">{{ stats.products|default(0) }}</span>
                <span class="stat-label">Items en Vente</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">24/7</span>
                <span class="stat-label">Support Gaming</span>
            </div>
        </section>

        <!-- FEATURES -->
        <section class="section-container">
            <div class="section-header">
                <h2 class="section-title">Nos Univers</h2>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <i class="fa-solid fa-cart-shopping feature-icon"></i>
                    <h3>Marketplace</h3>
                    <p>Achetez et vendez des équipements, des comptes et des services de coaching. Un système sécurisé pour tous les joueurs.</p>
                </div>
                <div class="feature-card">
                    <i class="fa-solid fa-trophy feature-icon"></i>
                    <h3>Tournois</h3>
                    <p>Inscrivez-vous aux compétitions quotidiennes. Gagnez des cash prizes et montez dans le classement mondial.</p>
                </div>
                <div class="feature-card">
                    <i class="fa-solid fa-handshake feature-icon"></i>
                    <h3>Sponsoring</h3>
                    <p>Décrochez des contrats avec des marques prestigieuses. Nous connectons les talents aux opportunités.</p>
                </div>
            </div>
        </section>

        <!-- MARKET PREVIEW -->
        <section class="section-container market-preview">
            <div class="section-header">
                <h2 class="section-title">Dernières Offres</h2>
            </div>
            <div class="product-grid">
                {% for product in latestProducts %}
                    <div class="product-card">
                        <div class="product-img">
                            {% if product.image %}
                                <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}">
                            {% else %}
                                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #1a1a1a; color: #333;">
                                    <i class="fa-solid fa-image fa-3x"></i>
                                </div>
                            {% endif %}
                        </div>
                        <div class="product-info">
                            <span class="product-price">{{ product.price|number_format(2, ',', ' ') }} DT</span>
                            <h4 class="product-name">{{ product.name }}</h4>
                            <a href="{{ path('front_marketplace') }}" class="btn-cyber btn-cyber-outline" style="padding: 8px 20px; font-size: 0.8rem; display: inline-block;">Voir plus</a>
                        </div>
                    </div>
                {% else %}
                    <div style="grid-column: 1/-1; text-align: center; opacity: 0.5; padding: 40px;">
                        Aucun produit disponible pour le moment.
                    </div>
                {% endfor %}
            </div>
        </section>

        <!-- CTA SECTION -->
        <section class="section-container" style="text-align: center;">
            <div style="background: linear-gradient(45deg, var(--primary), var(--secondary)); padding: 80px 40px; border-radius: 30px; box-shadow: 0 0 50px rgba(139, 61, 255, 0.3);">
                <h2 style="font-size: 2.5rem; margin-bottom: 20px; text-transform: uppercase;">Prêt à rejoindre l'arène ?</h2>
                <p style="margin-bottom: 40px; opacity: 0.9; font-size: 1.1rem;">Créez votre profil joueur dès maintenant et commencez votre ascension.</p>
                <a href="{{ path('app_profile_view') }}" class="btn-cyber btn-cyber-primary" style="background: #fff; color: #000;">Mon Dashboard</a>
            </div>
        </section>
    </main>

    <footer class="cyber-footer">
        <a href="#" class="footer-logo">LOBBY.GG</a>
        <div class="social-links">
            <a href="#" class="social-link"><i class="fa-brands fa-discord"></i></a>
            <a href="#" class="social-link"><i class="fa-brands fa-twitter"></i></a>
            <a href="#" class="social-link"><i class="fa-brands fa-instagram"></i></a>
            <a href="#" class="social-link"><i class="fa-brands fa-twitch"></i></a>
        </div>
        <div class="copyright">
            &copy; 2026 LOBBY.GG - ALL RIGHTS RESERVED. POWERED BY NEON CORE.
        </div>
    </footer>
</body>
</html>
</body>
</html>
