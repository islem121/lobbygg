{# templates/home/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🏠 Accueil - LOBBY.GG</title>
    <link rel="stylesheet" href="{{ asset('css/neon-cyber.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            background: url("{{ asset('images/user/home.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
            overflow-x: hidden;
            color: #fff;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 10, 10, 0.6);
            z-index: -1;
        }

        /* --- SINGLE NAVBAR --- */
        .cyber-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 40px; /* Augmenté de 15px à 25px */
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(139, 61, 255, 0.4);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
        }

        /* Left: Logo & User Info */
        .header-logo {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .logo-text {
            font-size: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin: 0;
            color: #fff;
            text-shadow: 0 0 10px rgba(139, 61, 255, 0.8);
            text-decoration: none;
        }

        .user-tag-left {
            text-align: left;
        }

        .user-name {
            display: block;
            color: #ff0080;
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .user-role {
            display: block;
            color: rgba(255, 255, 255, 0.4);
            font-size: 8px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Center: Nav Links */
        .header-nav {
            flex: 2;
            display: flex;
            justify-content: center;
            gap: 40px; /* Augmenté de 25px à 40px pour plus d'espace */
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            text-transform: uppercase;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            position: relative;
            padding: 5px 0;
        }

        .nav-link:hover, .nav-link.active {
            color: #fff;
            text-shadow: 0 0 8px rgba(139, 61, 255, 1);
        }

        .nav-link.active::after {
            content: "";
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 100%;
            height: 2px;
            background: #8B3DFF;
            box-shadow: 0 0 10px #8B3DFF;
        }

        /* Right: Buttons */
        .header-user {
            flex: 1;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 15px;
        }

        .btn-profile {
            background: rgba(139, 61, 255, 0.1);
            border: 1px solid rgba(139, 61, 255, 0.5);
            color: rgba(255, 255, 255, 0.8);
            padding: 8px 20px;
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-profile:hover {
            background: rgba(139, 61, 255, 0.2);
            color: #fff;
            border-color: #8B3DFF;
            box-shadow: 0 0 15px rgba(139, 61, 255, 0.3);
        }

        .btn-dissoudre {
            background: transparent;
            border: 1px solid rgba(255, 0, 128, 0.5);
            color: rgba(255, 0, 128, 0.8);
            padding: 8px 15px;
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-dissoudre:hover {
            background: rgba(255, 0, 128, 0.1);
            color: #ff0080;
            border-color: #ff0080;
            box-shadow: 0 0 15px rgba(255, 0, 128, 0.3);
        }

        /* --- HERO SECTION --- */
        .hero-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 100px 20px;
            text-align: center;
        }

        .hero-title {
            font-size: 4.5rem;
            font-weight: 300;
            text-transform: uppercase;
            letter-spacing: 15px;
            margin-bottom: 20px;
            text-shadow: 0 0 30px rgba(139, 61, 255, 0.8);
            animation: flicker 4s infinite;
        }

        @keyframes flicker {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.95; }
            51% { opacity: 1; }
        }

        .hero-subtitle {
            font-style: italic;
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.1rem;
            letter-spacing: 2px;
            margin-bottom: 50px;
            max-width: 600px;
        }

        /* --- SEARCH BAR --- */
        .cyber-input-group {
            position: relative;
            width: 100%;
            max-width: 600px;
        }

        .cyber-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            padding: 15px 60px 15px 30px;
            color: #fff;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            letter-spacing: 1px;
            outline: none;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
        }

        .cyber-input:focus {
            border-color: #8B3DFF;
            background: rgba(139, 61, 255, 0.1);
            box-shadow: 0 0 20px rgba(139, 61, 255, 0.2);
        }

        .cyber-input::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }

        .cyber-send-btn {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: #fff;
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .cyber-send-btn:hover {
            background: #8B3DFF;
            box-shadow: 0 0 15px #8B3DFF;
        }

        .cyber-send-btn svg {
            width: 18px;
            height: 18px;
            fill: #000;
        }
        /* Adjust content padding for fixed header */
        .hero-section {
            padding-top: 100px;
        }
    </style>
</head>
<body>
    {% include 'partials/_cyber_navbar.html.twig' %}

    <main class="hero-section">
        <h1 class="hero-title">WELCOME TO LOBBY.GG</h1>
    </main>
</body>
</html>
