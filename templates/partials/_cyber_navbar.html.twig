        <a href="{{ path('front_contracts') }}" class="nav-link {{ app.request.get('_route') == 'front_contracts' ? 'active' : '' }}">
            <i class="fa-solid fa-file-contract"></i>
            <span>CONTRATS</span>
        </a>
            
        <a href="{{ path('front_blog') }}" class="nav-link {{ app.request.get('_route') == 'front_blog' ? 'active' : '' }}">
            <i class="fa-solid fa-users"></i>
            <span>COMMUNITY</span>
        </a>
    </nav>

    <div class="header-user-nav">
        <div class="voice-search-container">
            <button id="voiceSearchBtn" class="btn-voice-nav" title="Recherche vocale">
                <i class="fa-solid fa-microphone"></i>
            </button>
        </div>
        <div class="profile-dropdown">
            <div class="btn-profile-nav">
                <i class="fa-solid fa-circle-user"></i>
                <span>COMPTE</span>
                <i class="fa-solid fa-chevron-down" style="font-size: 8px; opacity: 0.5;"></i>
            </div>
            <div class="dropdown-content">
                <a href="{{ path('app_profile_view') }}"><i class="fa-solid fa-user-astronaut"></i> Mon Profil</a>
                <a href="{{ path('app_messages') }}"><i class="fa-solid fa-comments"></i> Mes Messages</a>
                <a href="{{ path('app_settings') }}"><i class="fa-solid fa-gear"></i> Paramètres</a>
                <div style="border-top: 1px solid rgba(255,255,255,0.05); margin: 5px 0;"></div>
                <a href="{{ path('app_logout') }}" style="color: #ff4d4d;"><i class="fa-solid fa-power-off"></i> Déconnexion</a>
            </div>
        </div>
    </div>
    <!-- Voice Overlay -->
    <div class="voice-overlay" id="voiceOverlay">
        <button class="voice-close" id="voiceClose">
            <i class="fa-solid fa-xmark"></i>
        </button>
        
        <div class="voice-content">
            <div class="voice-status" id="voiceStatus">En attente...</div>
            
            <div class="voice-waves" id="voiceWaves" style="opacity: 0; transition: opacity 0.3s;">
                <div class="voice-wave"></div>
                <div class="voice-wave"></div>
                <div class="voice-wave"></div>
                <div class="voice-wave"></div>
                <div class="voice-wave"></div>
            </div>

            <div class="voice-results" id="voiceResults">
                <!-- Results will appear here -->
            </div>
        </div>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const header = document.getElementById('mainHeader');
        const mobileToggle = document.getElementById('mobileToggle');
        const navMenu = document.getElementById('navMenu');

        // Scroll effect
        window.addEventListener('scroll', function() {
            if (window.scrollY > 50) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });

        // Mobile menu toggle
        mobileToggle.addEventListener('click', function() {
            navMenu.classList.toggle('active');
            const icon = mobileToggle.querySelector('i');
            if (navMenu.classList.contains('active')) {
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-xmark');
            } else {
                icon.classList.remove('fa-xmark');
                icon.classList.add('fa-bars');
            }
        });
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const voiceBtn = document.getElementById('voiceSearchBtn');
        const voiceOverlay = document.getElementById('voiceOverlay');
        const voiceStatus = document.getElementById('voiceStatus');
        const voiceResults = document.getElementById('voiceResults');
        const voiceClose = document.getElementById('voiceClose');
        const voiceWaves = document.getElementById('voiceWaves');

        // Web Speech API
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

        if (SpeechRecognition) {
            const recognition = new SpeechRecognition();
            recognition.lang = 'fr-FR';
            recognition.continuous = false;
            recognition.interimResults = false;

            voiceBtn.addEventListener('click', () => {
                voiceOverlay.classList.add('active');
                voiceStatus.textContent = "Je vous écoute...";
                voiceWaves.style.opacity = '1';
                voiceResults.innerHTML = '';
                recognition.start();
            });

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                voiceStatus.textContent = `"${transcript}"`;
                voiceWaves.style.opacity = '0';
                searchProducts(transcript);
            };

            recognition.onerror = (event) => {
                voiceStatus.textContent = "Erreur: " + event.error;
                voiceWaves.style.opacity = '0';
                setTimeout(() => {
                    if (voiceResults.children.length === 0) voiceOverlay.classList.remove('active');
                }, 2000);
            };
            
            recognition.onend = () => {
                voiceWaves.style.opacity = '0';
            };
        } else {
            if(voiceBtn) voiceBtn.style.display = 'none';
            console.log("Web Speech API not supported");
        }

        if(voiceClose) {
            voiceClose.addEventListener('click', () => {
                voiceOverlay.classList.remove('active');
            });
        }

        function searchProducts(transcript) {
            voiceStatus.textContent = "Recherche en cours...";
            
            fetch('/voice/search', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ transcript: transcript })
            })
            .then(response => response.json())
            .then(data => {
                voiceStatus.textContent = data.message;
                voiceResults.innerHTML = '';
                
                // Text to Speech response
                speak(data.message);

                if (data.products && data.products.length > 0) {
                    data.products.forEach(product => {
                        const card = document.createElement('div');
                        card.className = 'voice-product-card';
                        // Handle image path (local vs external)
                        let imgPath = 'https://via.placeholder.com/300x200?text=No+Image';
                        if (product.image) {
                            if (product.image.startsWith('http')) {
                                imgPath = product.image;
                            } else {
                                // Assume image is in public root or uploads, try root first
                                imgPath = '/' + product.image;
                            }
                        }
                        
                        card.innerHTML = `
                            <a href="${product.url}" style="text-decoration: none;">
                                <img src="${imgPath}" class="voice-product-img" alt="${product.name}">
                                <div class="voice-product-info">
                                    <div class="voice-product-title">${product.name}</div>
                                    <div class="voice-product-price">${product.price} TND</div>
                                </div>
                            </a>
                        `;
                        voiceResults.appendChild(card);
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                voiceStatus.textContent = "Une erreur est survenue.";
            });
        }

        function speak(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'fr-FR';
                window.speechSynthesis.speak(utterance);
            }
        }
    });
</script>
