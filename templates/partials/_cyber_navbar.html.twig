            <i class="fa-solid fa-house"></i>
            <span>HOME</span>
        </a>
        <a href="{{ path('front_marketplace') }}" class="nav-link {{ app.request.get('_route') == 'front_marketplace' ? 'active' : '' }}">
            <i class="fa-solid fa-shop"></i>
            <span>MARKET</span>
        </a>
        <a href="{{ path('front_tournaments') }}" class="nav-link {{ app.request.get('_route') == 'front_tournaments' ? 'active' : '' }}">
            <i class="fa-solid fa-trophy"></i>
            <span>TOURNOI</span>
        </a>
            
