<style>
    /* --- SINGLE NAVBAR CYBER --- */
    .cyber-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 40px;
        background: rgba(45, 20, 80, 0.7); /* Violet transparent */
        backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(139, 61, 255, 0.4);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        font-family: 'Courier New', monospace;
    }

    /* Left: Logo & User Info */
    .header-logo {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .nav-logo {
        height: 40px;
        width: auto;
        object-fit: contain;
    }

    .user-tag-left {
        text-align: left;
        margin-top: 5px;
    }

    .user-name-nav {
        display: block;
        color: #ff0080;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .user-role-nav {
        display: block;
        color: rgba(255, 255, 255, 0.4);
        font-size: 8px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* Center: Nav Links */
    .header-nav {
        flex: 2;
        display: flex;
        justify-content: center;
        gap: 40px;
    }

    .nav-link {
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        text-transform: uppercase;
        font-size: 12px;
        font-weight: bold;
        letter-spacing: 2px;
        transition: all 0.3s ease;
        position: relative;
        padding: 5px 0;
    }

    .nav-link:hover, .nav-link.active {
        color: #fff !important;
        text-shadow: 0 0 8px rgba(139, 61, 255, 1);
    }

    .nav-link.active::after {
        content: "";
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 100%;
        height: 2px;
        background: #8B3DFF;
        box-shadow: 0 0 10px #8B3DFF;
    }

    /* Right: Buttons */
    .header-user-nav {
        flex: 1;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 15px;
    }

    .profile-dropdown {
        position: relative;
        display: inline-block;
    }

    .btn-profile-nav {
        background: rgba(139, 61, 255, 0.1);
        border: 1px solid rgba(139, 61, 255, 0.5);
        color: rgba(255, 255, 255, 0.8);
        padding: 8px 20px;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        background: rgba(25, 10, 45, 0.95);
        backdrop-filter: blur(10px);
        min-width: 180px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.5);
        border: 1px solid rgba(139, 61, 255, 0.3);
        z-index: 1001;
        margin-top: 10px;
        border-radius: 4px;
        overflow: visible; /* Changed from hidden to visible for ::before */
    }

    /* Bridge the gap so hover isn't lost */
    .dropdown-content::before {
        content: "";
        position: absolute;
        top: -15px;
        left: 0;
        width: 100%;
        height: 15px;
        background: transparent;
    }

    .dropdown-content a {
        color: rgba(255, 255, 255, 0.8);
        padding: 12px 16px;
        text-decoration: none;
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.2s ease;
        border-bottom: 1px solid rgba(139, 61, 255, 0.1);
    }

    .dropdown-content a:first-child {
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
    }

    .dropdown-content a:last-child {
        border-bottom: none;
        border-bottom-left-radius: 4px;
        border-bottom-right-radius: 4px;
    }

    .dropdown-content a:hover {
        background: rgba(139, 61, 255, 0.2);
        color: #fff;
        padding-left: 20px;
    }

    .profile-dropdown:hover .dropdown-content {
        display: block;
    }

    .profile-dropdown:hover .btn-profile-nav {
        background: rgba(139, 61, 255, 0.2);
        color: #fff;
        border-color: #8B3DFF;
    }

    .btn-dissoudre-nav {
        background: transparent;
        border: 1px solid rgba(255, 0, 128, 0.5);
        color: rgba(255, 0, 128, 0.8);
        padding: 8px 15px;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-dissoudre-nav:hover {
        background: rgba(255, 0, 128, 0.1);
        color: #ff0080;
        border-color: #ff0080;
        box-shadow: 0 0 15px rgba(255, 0, 128, 0.3);
    }

    /* Adjust content padding for fixed header */
    .lobby-content {
        padding-top: 100px !important;
    }

    /* SEARCH BAR STYLES */
    .cyber-search-container {
        position: relative;
        margin-right: 20px;
        margin-left: 50px;
    }

    #user-search-input {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(139, 61, 255, 0.3);
        color: #fff;
        padding: 8px 15px;
        font-family: 'Courier New', monospace;
        font-size: 11px;
        border-radius: 4px;
        width: 150px;
        transition: all 0.3s ease;
    }

    #user-search-input:focus {
        width: 200px;
        border-color: #00f0ff;
        box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
        outline: none;
    }

    .search-results {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: rgba(10, 10, 15, 0.95);
        border: 1px solid rgba(139, 61, 255, 0.5);
        border-top: none;
        max-height: 300px;
        overflow-y: auto;
        display: none;
        z-index: 1002;
    }

    .search-result-item {
        padding: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .search-result-item:hover {
        background: rgba(139, 61, 255, 0.2);
    }

    .search-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #8B3DFF;
    }

    .search-info {
        display: flex;
        flex-direction: column;
    }

    .search-name {
        font-size: 12px;
        color: #fff;
        font-weight: bold;
    }

    .search-role {
        font-size: 9px;
        color: rgba(255, 255, 255, 0.5);
    }
</style>

<header class="cyber-header">
    <div class="header-logo">
        <a href="{{ path('app_home') }}">
            <img src="/assets/images/lobby-logo-white.png" alt="LOBBY.GG" class="nav-logo">
        </a>
        <div class="user-tag-left">
            <span class="user-name-nav">{{ app.user.prenom|default('USER')|upper }}</span>
            <span class="user-role-nav">
                {% if app.user and 'ROLE_SPONSOR' in app.user.roles %}LECTEUR (SPONSOR){% else %}JOUEUR (CLIENT){% endif %}
            </span>
        </div>
    </div>

    <nav class="header-nav">
        <a href="{{ path('app_home') }}" class="nav-link {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}">HOME</a>
        <a href="{{ path('front_marketplace') }}" class="nav-link {{ app.request.get('_route') == 'front_marketplace' ? 'active' : '' }}">MARKET</a>
        <a href="{{ path('front_tournaments') }}" class="nav-link {{ app.request.get('_route') == 'front_tournaments' ? 'active' : '' }}">TOURNOI</a>
            
            {% if is_granted('ROLE_SPONSOR') %}
                <a href="{{ path('front_sponsoring_my_offers') }}" class="nav-link {{ app.request.get('_route') == 'front_sponsoring_my_offers' ? 'active' : '' }}">MES OFFRES</a>
                <a href="{{ path('front_sponsor_requests') }}" class="nav-link {{ app.request.get('_route') == 'front_sponsor_requests' ? 'active' : '' }}">DEMANDES</a>
                <a href="{{ path('front_contracts') }}" class="nav-link {{ app.request.get('_route') == 'front_contracts' ? 'active' : '' }}">CONTRATS</a>
            {% elseif is_granted('ROLE_CLIENT') %}
                <a href="{{ path('front_sponsoring') }}" class="nav-link {{ app.request.get('_route') == 'front_sponsoring' ? 'active' : '' }}">SPONSORING</a>
                <a href="{{ path('front_client_requests') }}" class="nav-link {{ app.request.get('_route') == 'front_client_requests' ? 'active' : '' }}">MES DEMANDES</a>
                <a href="{{ path('front_contracts') }}" class="nav-link {{ app.request.get('_route') == 'front_contracts' ? 'active' : '' }}">CONTRATS</a>
            {% endif %}
            
            <a href="{{ path('front_blog') }}" class="nav-link {{ app.request.get('_route') == 'front_blog' ? 'active' : '' }}">COMMUNITY</a>
            <a href="{{ path('app_chat_index') }}" class="nav-link {{ app.request.get('_route') starts with 'app_chat' ? 'active' : '' }}">MESSAGERIE</a>
    </nav>

    <div class="header-user-nav">
        <!-- Search Bar -->
        <div class="cyber-search-container">
            <input type="text" id="user-search-input" placeholder="SEARCH AGENT..." autocomplete="off">
            <div id="search-results" class="search-results"></div>
        </div>

        <div class="profile-dropdown">
            <span class="btn-profile-nav">PROFILE</span>
            <div class="dropdown-content">
                <a href="{{ path('app_settings') }}"><i class="fa-solid fa-gear"></i> Settings</a>
                <a href="{{ path('app_profile_view') }}"><i class="fa-solid fa-user-astronaut"></i> View Profile</a>
            </div>
        </div>
        <a href="{{ path('app_logout') }}" class="btn-dissoudre-nav">DÉCONNEXION</a>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('user-search-input');
        const searchResults = document.getElementById('search-results');
        let timeout = null;

        searchInput.addEventListener('input', function() {
            clearTimeout(timeout);
            const query = this.value;

            if (query.length < 2) {
                searchResults.style.display = 'none';
                return;
            }

            timeout = setTimeout(() => {
                fetch(`/user/search?q=${encodeURIComponent(query)}`)
                    .then(response => response.json())
                    .then(data => {
                        searchResults.innerHTML = '';
                        if (data.length > 0) {
                            data.forEach(user => {
                                const item = document.createElement('div');
                                item.className = 'search-result-item';
                                const avatarUrl = user.image ? `/uploads/profiles/${user.image}` : `https://ui-avatars.com/api/?name=${user.name}&background=random`;
                                
                                item.innerHTML = `
                                    <img src="${avatarUrl}" class="search-avatar" alt="${user.name}">
                                    <div class="search-info">
                                        <span class="search-name">${user.name}</span>
                                        <span class="search-role">${user.role.replace('ROLE_', '')}</span>
                                    </div>
                                `;
                                item.onclick = () => {
                                    window.location.href = `/user/public/${user.id}`;
                                };
                                searchResults.appendChild(item);
                            });
                            searchResults.style.display = 'block';
                        } else {
                            searchResults.style.display = 'none';
                        }
                    });
            }, 300);
        });

        // Close search when clicking outside
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                searchResults.style.display = 'none';
            }
        });
    });
</script>
