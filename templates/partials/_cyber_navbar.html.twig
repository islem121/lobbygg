                <i class="fa-solid fa-briefcase"></i>
                <span>OFFRES</span>
            </a>
            <a href="{{ path('front_sponsor_requests') }}" class="nav-link {{ app.request.get('_route') == 'front_sponsor_requests' ? 'active' : '' }}">
