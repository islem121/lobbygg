<style>
    /* --- SINGLE NAVBAR CYBER --- */
    .cyber-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;
        background: rgba(15, 5, 30, 0.85); /* Plus sombre pour le contraste */
        backdrop-filter: blur(20px);
        border-bottom: 2px solid rgba(139, 61, 255, 0.3);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(139, 61, 255, 0.1);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        font-family: 'Courier New', monospace;
        transition: all 0.3s ease;
    }

    .cyber-header.scrolled {
        padding: 10px 40px;
        background: rgba(10, 5, 20, 0.95);
        border-bottom-color: var(--primary);
    }

    /* Left: Logo & User Info */
    .header-logo-container {
        display: flex;
        align-items: center;
        gap: 20px;
        flex: 1;
    }

    .nav-logo-link {
        display: flex;
        align-items: center;
    }

    .nav-logo {
        height: 45px;
        width: auto;
        object-fit: contain;
        filter: drop-shadow(0 0 8px rgba(139, 61, 255, 0.5));
    }

    .user-info-mini {
        display: flex;
        flex-direction: column;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        padding-left: 15px;
    }

    .user-name-nav {
        color: #fff;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 1px;
        text-transform: uppercase;
        background: linear-gradient(90deg, #fff, var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .user-role-nav {
        color: rgba(255, 255, 255, 0.4);
        font-size: 9px;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: bold;
    }

    /* Center: Nav Links */
    .header-nav {
        flex: 2;
        display: flex;
        justify-content: center;
        gap: 25px;
    }

    .nav-link {
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        text-transform: uppercase;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 1px;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        padding: 8px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        border-radius: 8px;
    }

    .nav-link i {
        font-size: 16px;
        margin-bottom: 2px;
        transition: transform 0.3s ease;
    }

    .nav-link:hover {
        color: #fff !important;
        background: rgba(139, 61, 255, 0.1);
    }

    .nav-link:hover i {
        transform: translateY(-3px);
        color: var(--accent);
    }

    .nav-link.active {
        color: #fff !important;
        background: rgba(139, 61, 255, 0.15);
        border: 1px solid rgba(139, 61, 255, 0.3);
    }

    .nav-link.active i {
        color: var(--accent);
        filter: drop-shadow(0 0 5px var(--accent));
    }

    .nav-link.active::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 20%;
        width: 60%;
        height: 2px;
        background: var(--accent);
        box-shadow: 0 0 10px var(--accent);
        border-radius: 10px;
    }

    /* Voice Search Styles */
    .btn-voice-nav {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(139, 61, 255, 0.3);
        color: #fff;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-right: 15px;
    }

    .btn-voice-nav:hover {
        background: rgba(139, 61, 255, 0.2);
        box-shadow: 0 0 15px rgba(139, 61, 255, 0.5);
        transform: scale(1.1);
        color: var(--accent);
    }

    .voice-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 5, 20, 0.95);
        backdrop-filter: blur(15px);
        z-index: 9999;
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .voice-overlay.active {
        display: flex;
        opacity: 1;
    }

    .voice-content {
        text-align: center;
        width: 100%;
        max-width: 1000px;
    }

    .voice-status {
        color: #fff;
        font-family: 'Courier New', monospace;
        font-size: 24px;
        margin-bottom: 30px;
        text-shadow: 0 0 10px var(--accent);
        min-height: 30px;
    }

    .voice-waves {
        display: flex;
        gap: 6px;
        height: 60px;
        align-items: center;
        justify-content: center;
        margin-bottom: 40px;
    }

    .voice-wave {
        width: 6px;
        height: 20px;
        background: var(--accent);
        border-radius: 3px;
        animation: wave 1s infinite ease-in-out;
    }

    .voice-wave:nth-child(2) { animation-delay: 0.1s; height: 30px; }
    .voice-wave:nth-child(3) { animation-delay: 0.2s; height: 40px; }
    .voice-wave:nth-child(4) { animation-delay: 0.3s; height: 30px; }
    .voice-wave:nth-child(5) { animation-delay: 0.4s; height: 20px; }

    @keyframes wave {
        0%, 100% { transform: scaleY(1); opacity: 0.5; }
        50% { transform: scaleY(2.5); opacity: 1; box-shadow: 0 0 15px var(--accent); }
    }

    .voice-results {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 25px;
        padding: 20px;
        max-height: 60vh;
        overflow-y: auto;
    }

    .voice-product-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(139, 61, 255, 0.2);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        text-align: left;
    }

    .voice-product-card:hover {
        transform: translateY(-5px);
        border-color: var(--accent);
        box-shadow: 0 5px 20px rgba(139, 61, 255, 0.2);
    }

    .voice-product-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .voice-product-info {
        padding: 15px;
    }

    .voice-product-title {
        color: #fff;
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .voice-product-price {
        color: var(--accent);
        font-weight: 900;
        font-size: 16px;
        letter-spacing: 1px;
    }

    .voice-close {
        position: absolute;
        top: 30px;
        right: 40px;
        color: rgba(255, 255, 255, 0.5);
        font-size: 32px;
        cursor: pointer;
        transition: all 0.3s;
        background: none;
        border: none;
    }

    .voice-close:hover {
        color: #ff4d4d;
        transform: rotate(90deg);
    }

    /* Scrollbar for results */
    .voice-results::-webkit-scrollbar {
        width: 6px;
    }
    .voice-results::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.3);
    }
    .voice-results::-webkit-scrollbar-thumb {
        background: var(--accent);
        border-radius: 3px;
    }

    /* Right: Buttons */
    .header-user-nav {
        flex: 1;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 20px;
    }

    .profile-dropdown {
        position: relative;
    }

    .btn-profile-nav {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        padding: 10px 18px;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        border-radius: 4px;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-profile-nav i {
        font-size: 14px;
        color: var(--primary);
    }

    .btn-profile-nav:hover {
        background: rgba(139, 61, 255, 0.2);
        border-color: var(--primary);
        box-shadow: 0 0 15px rgba(139, 61, 255, 0.3);
    }

    .dropdown-content {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 15px);
        background: rgba(15, 5, 25, 0.98);
        backdrop-filter: blur(15px);
        min-width: 220px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        border: 1px solid var(--primary);
        z-index: 1001;
        border-radius: 12px;
        overflow: hidden;
        animation: fadeInDown 0.3s ease;
    }

    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .dropdown-content a {
        color: rgba(255, 255, 255, 0.7);
        padding: 15px 20px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .dropdown-content a i {
        font-size: 16px;
        width: 20px;
        text-align: center;
        color: var(--primary);
    }

    .dropdown-content a:hover {
        background: rgba(139, 61, 255, 0.15);
        color: #fff;
        padding-left: 25px;
    }

    .dropdown-content a:hover i {
        color: var(--accent);
        transform: scale(1.2);
    }

    .profile-dropdown:hover .dropdown-content {
        display: block;
    }

    .btn-logout-nav {
        background: linear-gradient(45deg, #ff0080, #ff4d4d);
        color: #fff;
        padding: 10px 20px;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1px;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 4px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-logout-nav:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 0, 128, 0.4);
        filter: brightness(1.1);
    }

    /* Mobile Menu Toggle */
    .mobile-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 24px;
        cursor: pointer;
    }

    @media (max-width: 1200px) {
        .header-nav { gap: 10px; }
        .nav-link { font-size: 10px; padding: 8px 5px; }
    }

    @media (max-width: 992px) {
        .mobile-toggle { display: block; }
        .header-nav {
            display: none; /* Will be toggled via JS */
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: rgba(10, 5, 20, 0.98);
            flex-direction: column;
            padding: 20px;
            gap: 15px;
            border-bottom: 2px solid var(--primary);
        }
        .header-nav.active { display: flex; }
        .nav-link { flex-direction: row; gap: 15px; font-size: 14px; width: 100%; justify-content: flex-start; }
        .header-user-nav { flex: 0; }
        .user-info-mini { display: none; }
    }
</style>

<header class="cyber-header" id="mainHeader">
    <div class="header-logo-container">
