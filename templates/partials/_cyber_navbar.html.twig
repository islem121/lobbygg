                <span>DEMANDES</span>
            </a>
        {% elseif is_granted('ROLE_CLIENT') %}
            <a href="{{ path('front_sponsoring') }}" class="nav-link {{ app.request.get('_route') == 'front_sponsoring' ? 'active' : '' }}">
