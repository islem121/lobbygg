{% if form %}
<div id="create-post-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content create-post-modal-content draggable-modal">
        <div class="modal-header">
            <h3><i class="fa-solid fa-pen-nib"></i> Create New Post</h3>
            <button type="button" class="btn-close-modal" onclick="closePostModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="modal-body">
            {% if createAction is defined and createAction %}
                {{ form_start(form, {'action': createAction}) }}
            {% else %}
                {{ form_start(form) }}
            {% endif %}
            <div class="post-user-info">
                <div class="avatar avatar-grad">{{ app.user.username[:2]|upper }}</div>
                <div class="post-meta">
                    <div class="post-username">{{ app.user.username }} <span class="muted">@{{ app.user.username|lower }}</span></div>
                    <div class="post-status">Share your thoughts</div>
                </div>
            </div>

            <div class="post-input-area">
                <div class="input-wrapper">
                    <i class="fa-regular fa-pen-to-square input-icon"></i>
                    {{ form_widget(form.content, {'attr': {'placeholder': "What's on your mind, gamer?", 'class': 'post-input-large'}}) }}
                </div>
                
                <div id="media-preview-modal" class="media-preview-container">
                    <div id="media-empty-state" class="media-empty-state">
                        <i class="fa-solid fa-photo-film"></i>
                        <span>Aucun média chargé</span>
                    </div>
                    <img id="image-preview-modal" src="#" alt="Preview" class="media-preview-item">
                    <video id="video-preview-modal" controls class="media-preview-item"></video>
                    <button type="button" onclick="removeMediaModal()" class="btn-remove-media"><i class="fa-solid fa-xmark"></i></button>
                </div>

                {{ form_widget(form.image, {'attr': {'id': 'post_image_input_modal', 'class': 'file-input-hidden', 'onchange': 'previewMediaModal(this)', 'style': 'display: none;', 'accept': 'image/*,video/*'}}) }}
                <div class="media-error">
                    {{ form_errors(form.image) }}
                </div>
            </div>

            <div class="post-actions-bar">
                <div class="action-left">
                    <button class="chip action-btn action-btn-media" type="button" onclick="triggerPhotoUpload(this)">
                        <i class="fa-solid fa-image" style="color: #4facfe;"></i> <span>Photo</span>
                    </button>
                    <button class="chip action-btn action-btn-media" type="button" onclick="triggerVideoUpload(this)">
                        <i class="fa-solid fa-video" style="color: #7c4dff;"></i> <span>Vidéo</span>
                    </button>
                    <button class="chip action-btn" type="button">
                        <i class="fa-solid fa-trophy" style="color: #ffd700;"></i> <span>Tournament</span>
                    </button>
                </div>
                <div class="action-right" style="display: flex; gap: 10px;">
                    <button class="btn btn-ghost btn-post-cancel" type="button" onclick="closePostModal()">
                        Cancel
                    </button>
                    <button class="btn btn-primary btn-post-submit" type="submit">
                        <i class="fa-solid fa-paper-plane"></i> Post
                    </button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<style>
    /* Modal Animation & Layout */
    .create-post-modal-content {
        width: 1000px;
        max-width: 98%;
        background: rgba(26, 26, 46, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(139, 61, 255, 0.3);
        border-radius: 16px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
        overflow: hidden;
        animation: modalSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        margin: 0;
    }

    @keyframes modalSlideIn {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    /* Header */
    .modal-header {
        padding: 20px 25px;
        background: rgba(22, 33, 62, 0.8);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 1.2rem;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-close-modal {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 1.2rem;
        cursor: pointer;
        transition: color 0.2s;
    }
    .btn-close-modal:hover { color: #fff; }

    /* Body */
    .modal-body { padding: 25px; }

    .post-user-info {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .avatar-grad {
        width: 50px;
        height: 50px;
        font-size: 18px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), var(--secondary));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #fff;
        box-shadow: 0 0 15px rgba(var(--accent-rgb), 0.4);
    }

    .post-meta { margin-left: 15px; }
    .post-username { font-size: 16px; font-weight: 600; color: #fff; }
    .post-username .muted { font-weight: 400; opacity: 0.7; font-size: 0.9em; }
    .post-status { font-size: 13px; color: var(--text-muted); margin-top: 2px; }

    /* Input Area */
    .input-wrapper { position: relative; margin-bottom: 20px; }
    
    .input-icon {
        position: absolute;
        top: 18px;
        left: 18px;
        color: var(--accent);
        font-size: 18px;
        pointer-events: none;
    }

    .post-input-large {
        width: 100%;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        color: #fff;
        outline: none;
        resize: vertical;
        font-family: inherit;
        transition: all 0.3s ease;
        padding: 15px 15px 15px 50px; /* Left padding for icon */
        min-height: 170px;
        font-size: 16px;
        line-height: 1.5;
    }

    .post-input-large:focus {
        background: rgba(0, 0, 0, 0.3);
        border-color: var(--accent);
        box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.15);
    }

    .media-error {
        margin-top: 8px;
        color: #ff7aa2;
        font-size: 12px;
        min-height: 16px;
    }

    /* Media Preview */
    .media-preview-container {
        display: flex;
        margin-bottom: 20px;
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(0, 0, 0, 0.25);
        min-height: 180px;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }

    .media-preview-container .btn-remove-media {
        display: none;
    }

    .media-preview-container.has-media .btn-remove-media {
        display: flex;
    }

    .media-preview-container.has-media .media-empty-state {
        display: none;
    }

    .media-preview-item {
        max-width: 100%;
        max-height: 400px;
        display: none;
        margin: 0 auto;
    }

    .media-empty-state {
        text-align: center;
        color: var(--text-muted);
        display: flex;
        flex-direction: column;
        gap: 6px;
        align-items: center;
    }

    .media-empty-state i {
        font-size: 28px;
        color: #4facfe;
    }

    .btn-remove-media {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }
    .btn-remove-media:hover { background: rgba(255,0,0,0.8); border-color: red; }

    /* Actions Bar */
    .post-actions-bar {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .action-left { display: flex; gap: 10px; }

    .action-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid transparent;
        border-radius: 20px;
        padding: 8px 16px;
        color: var(--text-main);
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
    }

    .action-btn-media {
        cursor: pointer;
    }

    .draggable-modal {
        position: fixed;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }

    .action-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-1px);
    }

    .btn-post-submit {
        padding: 10px 30px;
        border-radius: 30px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(90deg, var(--accent), var(--secondary));
        border: none;
        color: white;
        box-shadow: 0 4px 15px rgba(var(--accent-rgb), 0.4);
        transition: all 0.3s;
    }

    .btn-post-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(var(--accent-rgb), 0.6);
    }

    .btn-post-cancel {
        padding: 10px 20px;
        border-radius: 30px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--text-muted);
        transition: all 0.3s;
    }

    .btn-post-cancel:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.4);
    }
</style>


<script>
    function openPostModal() {
        document.getElementById('create-post-modal').style.display = 'flex';
        resetCreateModalPosition();
    }

    function closePostModal() {
        document.getElementById('create-post-modal').style.display = 'none';
    }

    document.getElementById('create-post-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            closePostModal();
        }
    });

    function previewMediaModal(input) {
        const previewContainer = document.getElementById('media-preview-modal');
        const imgPreview = document.getElementById('image-preview-modal');
        const videoPreview = document.getElementById('video-preview-modal');
        
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const reader = new FileReader();
            
            reader.onload = function(e) {
                previewContainer.classList.add('has-media');
                
                if (file.type.startsWith('image/')) {
                    imgPreview.src = e.target.result;
                    imgPreview.style.display = 'block';
                    videoPreview.style.display = 'none';
                } else if (file.type.startsWith('video/')) {
                    videoPreview.src = e.target.result;
                    videoPreview.style.display = 'block';
                    imgPreview.style.display = 'none';
                }
            }
            
            reader.readAsDataURL(file);
        }
    }

    function removeMediaModal() {
        const input = document.getElementById('post_image_input_modal');
        input.value = '';
        const previewContainer = document.getElementById('media-preview-modal');
        const imgPreview = document.getElementById('image-preview-modal');
        const videoPreview = document.getElementById('video-preview-modal');
        previewContainer.classList.remove('has-media');
        imgPreview.src = '#';
        videoPreview.src = '';
        imgPreview.style.display = 'none';
        videoPreview.style.display = 'none';
    }

    function triggerPhotoUpload(btn) {
        const modal = btn.closest('.create-post-modal-content');
        const input = modal.querySelector('.file-input-hidden');
        if (input) {
            input.accept = 'image/*';
            input.click();
        }
    }

    function triggerVideoUpload(btn) {
        const modal = btn.closest('.create-post-modal-content');
        const input = modal.querySelector('.file-input-hidden');
        if (input) {
            input.accept = 'video/*';
            input.click();
        }
    }

    function resetCreateModalPosition() {
        const modal = document.querySelector('#create-post-modal .modal-content');
        if (!modal) return;
        modal.style.position = 'fixed';
        modal.style.left = '50%';
        modal.style.top = '50%';
        modal.style.transform = 'translate(-50%, -50%)';
    }

    function enableDrag(modalId) {
        const overlay = document.getElementById(modalId);
        if (!overlay) return;
        const modal = overlay.querySelector('.modal-content');
        const handle = overlay.querySelector('.modal-header');
        if (!modal || !handle) return;
        let isDragging = false;
        let offsetX = 0;
        let offsetY = 0;
        handle.style.cursor = 'move';
        handle.addEventListener('mousedown', function(e) {
            isDragging = true;
            const rect = modal.getBoundingClientRect();
            offsetX = e.clientX - rect.left;
            offsetY = e.clientY - rect.top;
            modal.style.position = 'fixed';
            modal.style.left = rect.left + 'px';
            modal.style.top = rect.top + 'px';
            modal.style.transform = 'none';
        });
        document.addEventListener('mousemove', function(e) {
            if (!isDragging) return;
            modal.style.left = e.clientX - offsetX + 'px';
            modal.style.top = e.clientY - offsetY + 'px';
        });
        document.addEventListener('mouseup', function() {
            isDragging = false;
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        enableDrag('create-post-modal');
    });
</script>
{% endif %}
