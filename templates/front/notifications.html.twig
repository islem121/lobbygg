{% extends 'front/base.html.twig' %}

{% block title %}Lobby.gg • Notifications{% endblock %}

{% block content %}
  <section class="page-head">
    <div>
      <h1 class="page-title">Notifications</h1>
      <p class="page-sub">Stay updated with your community interactions.</p>
    </div>
  </section>

  <section class="grid">
    <div class="col span-8">
      <div class="panel">
        <div class="panel-head">
          <h2 class="panel-title"><i class="fa-solid fa-bell"></i> Recent Activity</h2>
        </div>

        <div class="stack" style="gap: 10px;">
          {% for notif in notifications %}
            <a href="{{ path('app_notification_read', {id: notif.id}) }}" class="card notification-card {{ notif.isRead ? '' : 'unread' }}" style="display: flex; align-items: center; gap: 15px; padding: 15px; text-decoration: none; color: inherit; transition: background 0.2s;">
                <div class="avatar avatar-sm">{{ notif.actor.username[:2]|upper }}</div>
                <div style="flex-grow: 1;">
                    <div style="margin-bottom: 4px;">
                        <span style="color: var(--accent); font-weight: bold;">{{ notif.actor.username }}</span>
                        {% if notif.type == 'like' %}
                            liked your post: "{{ notif.post.content|u.truncate(50, '...') }}"
                        {% elseif notif.type == 'comment' %}
                            commented on your post: "{{ notif.post.content|u.truncate(50, '...') }}"
                        {% endif %}
                    </div>
                    <div style="font-size: 12px; color: var(--text-muted);">{{ notif.createdAt|date('M d, H:i') }}</div>
                </div>
                {% if not in notif.isRead %}
                    <div style="width: 10px; height: 10px; background: var(--accent); border-radius: 50%;"></div>
                {% endif %}
            </a>
          {% else %}
            <div class="empty-feed" style="text-align: center; padding: 40px; color: #888;">
                <i class="fa-solid fa-bell-slash" style="font-size: 48px; margin-bottom: 20px;"></i>
                <p>No notifications yet.</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <style>
    .notification-card:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .notification-card.unread {
        background: rgba(139, 61, 255, 0.05);
        border-left: 3px solid var(--accent);
    }
  </style>
{% endblock %}
