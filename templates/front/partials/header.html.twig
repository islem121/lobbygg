{# Header: glow logo, search, notifications micro-animations #}
<header class="lobby-header">
  <div class="header-left">
    <a class="lobby-logo" href="{{ path('front_blog') }}" aria-label="Lobby.gg home">
      <img
        class="logo-img"
        src="/assets/images/lobby-logo-white.png"
        alt="Lobby.gg logo"
      /> {# Logo: replace icon + text with the white PNG as requested #}
      <span class="logo-glow" aria-hidden="true"></span>
    </a>

    <div class="lobby-search" data-search>
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input
        type="search"
        placeholder="Search users, tournaments, marketplace…"
        aria-label="Search"
        autocomplete="off"
      />
      <div class="search-hint" aria-hidden="true">/ to focus</div>
      <div class="search-results" data-search-results aria-hidden="true"></div>
    </div>
  </div>

  <div class="header-right">
    {% if app.user %}
        {% set unread_notifs = app.user.notifications|filter(n => not n.isRead) %}
        <div class="profile-dropdown">
            <button class="header-icon" type="button" data-notif-trigger aria-label="Notifications">
              <i class="fa-solid fa-bell"></i>
              {% if unread_notifs|length > 0 %}
                <span class="pill pill-accent" data-notif-count>{{ unread_notifs|length }}</span>
                <span class="micro-explosion" aria-hidden="true"></span>
              {% endif %}
            </button>
            <div class="dropdown-content" style="width: 300px; max-height: 400px; overflow-y: auto;">
                <div style="padding: 10px; border-bottom: 1px solid rgba(139, 61, 255, 0.1); font-weight: bold; color: #fff;">Notifications</div>
                {% for notif in unread_notifs %}
                    <a href="{{ path('app_notification_read', {id: notif.id}) }}" style="display: flex; align-items: center; gap: 10px; white-space: normal;">
                        <div class="avatar avatar-xs" style="width: 30px; height: 30px; font-size: 10px;">{{ notif.actor.username[:2]|upper }}</div>
                        <div>
                            <span style="color: var(--accent);">{{ notif.actor.username }}</span>
                            {% if notif.type == 'like' %}
                                liked your post.
                            {% elseif notif.type == 'comment' %}
                                commented on your post.
                            {% endif %}
                            <div style="font-size: 10px; color: var(--text-muted);">{{ notif.createdAt|date('H:i') }}</div>
                        </div>
                    </a>
                {% else %}
                    <div style="padding: 15px; text-align: center; color: var(--text-muted); font-size: 12px;">No new notifications</div>
                {% endfor %}
                <a href="{{ path('app_notifications') }}" style="text-align: center; color: var(--text-muted);">View all</a>
            </div>
        </div>
    {% endif %}

    <button class="header-icon" type="button" aria-label="Quick Messages">
      <i class="fa-solid fa-comment-dots"></i>
      <span class="pill">2</span>
    </button>

    <div class="header-user" data-user-menu>
      <div class="user-avatar" aria-hidden="true">
        <span>GG</span>
      </div>
      <div class="user-meta">
        <div class="user-name">Guest Gamer</div>
        <div class="user-tag">@lobby_guest</div>
      </div>
      <button class="chev" type="button" aria-label="Open user menu">
        <i class="fa-solid fa-chevron-down"></i>
      </button>
    </div>
  </div>
</header>

<div class="user-dropdown" data-user-dropdown aria-hidden="true">
  <a class="dd-item" href="{{ path('front_users') }}"><i class="fa-solid fa-user-astronaut"></i> Profile</a>
  <a class="dd-item" href="{{ path('front_marketplace') }}"><i class="fa-solid fa-bag-shopping"></i> Saved items</a>
  <a class="dd-item" href="{{ path('front_tournaments') }}"><i class="fa-solid fa-trophy"></i> My tournaments</a>
  <div class="dd-sep"></div>
  <a class="dd-item" href="{{ path('app_logout') }}"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
</div>


