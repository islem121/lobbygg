{% extends 'front/base.html.twig' %}

{% block title %}Mes Conversations • Lobby.gg{% endblock %}

{% block content %}
<style>
    .messaging-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .convo-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(139, 61, 255, 0.2);
        border-radius: 15px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: all 0.3s ease;
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }

    .convo-card:hover {
        background: rgba(139, 61, 255, 0.08);
        border-color: rgba(139, 61, 255, 0.5);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .convo-avatar {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #8b3dff, #ff0055);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: bold;
        color: white;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .convo-info {
        flex-grow: 1;
    }

    .convo-user {
        font-family: 'Major Mono Display', monospace;
        font-size: 16px;
        color: #fff;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .convo-product {
        font-size: 13px;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 5px;
    }

    .convo-last-msg {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 300px;
    }

    .convo-meta {
        text-align: right;
    }

    .convo-date {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.3);
        margin-bottom: 10px;
    }

    .unread-badge {
        background: #ff0055;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: bold;
        box-shadow: 0 0 10px rgba(255, 0, 85, 0.5);
    }

    .empty-messaging {
        text-align: center;
        padding: 100px 20px;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 30px;
        border: 1px dashed rgba(139, 61, 255, 0.3);
        margin-top: 40px;
    }

    .empty-icon {
        font-size: 80px;
        background: linear-gradient(to bottom, #8b3dff, transparent);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 30px;
        display: block;
    }
</style>

<section class="page-head">
    <div style="text-align: center; width: 100%;">
        <h1 class="page-title" style="font-size: 3rem; margin-bottom: 10px;">MA MESSAGERIE</h1>
        <p class="page-sub" style="font-size: 1.1rem; opacity: 0.7;">Discutez, négociez et gérez vos échanges Marketplace</p>
    </div>
</section>

<div class="messaging-container">
    {% if conversations|length > 0 %}
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(450px, 1fr)); gap: 20px;">
            {% for conversation in conversations %}
                {% set otherUser = (app.user == conversation.buyer) ? conversation.seller : conversation.buyer %}
                {% set lastMessage = conversation.messages|last %}
                {% set unreadCount = 0 %}
                {% for msg in conversation.messages %}
                    {% if not msg.isRead and msg.sender != app.user %}
                        {% set unreadCount = unreadCount + 1 %}
                    {% endif %}
                {% endfor %}

                <a href="{{ path('app_messages_show', {id: conversation.id}) }}" class="convo-card">
                    <div class="convo-avatar">
                        {{ otherUser.username[:2]|upper }}
                    </div>
                    <div class="convo-info">
                        <div class="convo-user">
                            {{ otherUser.username }}
                            {% if unreadCount > 0 %}
                                <span class="unread-badge">{{ unreadCount }} NOUVEAU{{ unreadCount > 1 ? 'X' : '' }}</span>
                            {% endif %}
                        </div>
                        {% if conversation.product %}
                            <div class="convo-product"><i class="fa-solid fa-box-open"></i> {{ conversation.product.name }}</div>
                        {% else %}
                            <div class="convo-product"><i class="fa-solid fa-comments"></i> Discussion générale</div>
                        {% endif %}
                        <div class="convo-last-msg">
                            {% if lastMessage %}
                                {{ lastMessage.sender == app.user ? 'Moi: ' : '' }}{{ lastMessage.content }}
                            {% else %}
                                Aucune discussion encore...
                            {% endif %}
                        </div>
                    </div>
                    <div class="convo-meta">
                        <div class="convo-date">{{ conversation.createdAt|date('d M Y') }}</div>
                        <div class="btn btn-mini btn-ghost">Ouvrir <i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-messaging">
            <i class="fa-solid fa-comments-slash empty-icon"></i>
            <h2 style="font-family: 'Major Mono Display', monospace; margin-bottom: 20px;">Silence radio...</h2>
            <p style="color: rgba(255,255,255,0.6); margin-bottom: 30px; max-width: 500px; margin-left: auto; margin-right: auto;">
                Vous n'avez pas encore de conversations en cours. Contactez un vendeur pour poser des questions ou négocier un prix !
            </p>
            <a href="{{ path('front_marketplace') }}" class="btn btn-primary btn-lg">
                <i class="fa-solid fa-bag-shopping"></i> Explorer le Marketplace
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
