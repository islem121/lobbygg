{% extends 'front/base.html.twig' %}

{% block title %}Discussion avec {{ (app.user == conversation.buyer) ? conversation.seller.username : conversation.buyer.username }} • Lobby.gg{% endblock %}

{% block content %}
<style>
    .chat-container {
        max-width: 900px;
        margin: 20px auto;
        padding: 0 20px;
    }

    .chat-header {
        background: rgba(45, 20, 80, 0.4);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(139, 61, 255, 0.3);
        border-radius: 20px 20px 0 0;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .chat-avatar {
        width: 50px;
        height: 50px;
        background: linear-gradient(45deg, #8b3dff, #ff0055);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 18px;
    }

    .chat-window {
        background: rgba(25, 10, 45, 0.6);
        border-left: 1px solid rgba(139, 61, 255, 0.3);
        border-right: 1px solid rgba(139, 61, 255, 0.3);
        height: 500px;
        overflow-y: auto;
        padding: 30px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .msg-group {
        display: flex;
        flex-direction: column;
        max-width: 80%;
    }

    .msg-group.me {
        align-self: flex-end;
    }

    .msg-group.other {
        align-self: flex-start;
    }

    .msg-bubble {
        padding: 12px 18px;
        border-radius: 18px;
        font-size: 14px;
        line-height: 1.5;
        position: relative;
    }

    .me .msg-bubble {
        background: linear-gradient(135deg, #8b3dff, #6a1b9a);
        color: white;
        border-bottom-right-radius: 4px;
        box-shadow: 0 4px 15px rgba(139, 61, 255, 0.3);
    }

    .other .msg-bubble {
        background: rgba(255, 255, 255, 0.08);
        color: #e0e0e0;
        border-bottom-left-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .msg-meta {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.4);
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .me .msg-meta {
        justify-content: flex-end;
    }

    .chat-footer {
        background: rgba(45, 20, 80, 0.4);
        border: 1px solid rgba(139, 61, 255, 0.3);
        border-radius: 0 0 20px 20px;
        padding: 20px;
    }

    .chat-input-wrapper {
        display: flex;
        gap: 15px;
        background: rgba(0, 0, 0, 0.2);
        padding: 10px;
        border-radius: 15px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .chat-input {
        flex-grow: 1;
        background: transparent;
        border: none;
        color: white;
        padding: 10px;
        font-size: 14px;
        resize: none;
        outline: none;
    }

    .btn-send {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #8b3dff;
        border: none;
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-send:hover {
        background: #a366ff;
        transform: scale(1.05);
        box-shadow: 0 0 20px rgba(139, 61, 255, 0.5);
    }

    /* Voice Message Styles */
    .btn-voice {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-voice:hover {
        background: rgba(255, 0, 85, 0.1);
        border-color: #ff0055;
        color: #ff0055;
    }

    .btn-voice.recording {
        background: #ff0055;
        color: white;
        animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 0, 85, 0.7); }
        70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(255, 0, 85, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 0, 85, 0); }
    }

    .audio-player {
        margin-top: 5px;
        min-width: 200px;
    }

    audio::-webkit-media-controls-panel {
        background-color: rgba(139, 61, 255, 0.2);
    }

    audio::-webkit-media-controls-play-button,
    audio::-webkit-media-controls-current-time-display,
    audio::-webkit-media-controls-time-remaining-display,
    audio::-webkit-media-controls-timeline,
    audio::-webkit-media-controls-volume-slider {
        filter: invert(100%) sepia(0%) saturate(7500%) hue-rotate(53deg) brightness(102%) contrast(106%);
    }

    /* Scrollbar Styling */
    .chat-window::-webkit-scrollbar { width: 6px; }
    .chat-window::-webkit-scrollbar-track { background: transparent; }
    .chat-window::-webkit-scrollbar-thumb { background: rgba(139, 61, 255, 0.3); border-radius: 10px; }
</style>

<div class="chat-container">
    <div class="chat-header">
        <a href="{{ path('app_messages') }}" class="btn btn-mini btn-ghost" style="padding: 10px;"><i class="fa-solid fa-arrow-left"></i></a>
        <div class="chat-avatar">
            {{ ((app.user == conversation.buyer) ? conversation.seller.username : conversation.buyer.username)[:2]|upper }}
        </div>
        <div style="flex-grow: 1;">
            <div style="font-family: 'Major Mono Display', monospace; font-size: 18px; color: #fff;">
                {{ (app.user == conversation.buyer) ? conversation.seller.username : conversation.buyer.username }}
            </div>
            {% if conversation.product %}
                <div style="font-size: 12px; color: var(--accent);">
                    <i class="fa-solid fa-box-open"></i> {{ conversation.product.name }} • {{ conversation.product.price|number_format(2) }} DT
                </div>
            {% endif %}
        </div>
    </div>

    <div class="chat-window" id="chat-window">
        {% if conversation.messages|length > 0 %}
            {% for message in conversation.messages %}
                {% set isMe = (message.sender == app.user) %}
                <div class="msg-group {{ isMe ? 'me' : 'other' }}">
                    <div class="msg-bubble">
                        {% if message.audioPath %}
                            <div class="voice-message">
                                <i class="fa-solid fa-microphone" style="margin-right: 10px; color: var(--accent);"></i>
                                <span>Message vocal</span>
                                <audio controls class="audio-player">
                                    <source src="{{ asset(message.audioPath) }}" type="audio/webm">
                                    Votre navigateur ne supporte pas l'élément audio.
                                </audio>
                            </div>
                        {% else %}
                            {{ message.content|nl2br }}
                        {% endif %}
                    </div>
                    <div class="msg-meta">
                        {{ message.createdAt|date('H:i') }}
                        {% if isMe %}
                            <i class="fa-solid {{ message.isRead ? 'fa-check-double' : 'fa-check' }}" style="{{ message.isRead ? 'color: #00f2ff;' : '' }}"></i>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div style="text-align: center; padding-top: 100px; opacity: 0.5;">
                <i class="fa-solid fa-hand-wave" style="font-size: 40px; margin-bottom: 20px; display: block;"></i>
                <p>Dites bonjour ! Lancez la discussion avec {{ (app.user == conversation.buyer) ? conversation.seller.username : conversation.buyer.username }}.</p>
            </div>
        {% endif %}
    </div>

    <div class="chat-footer">
        <form action="{{ path('app_messages_send', {id: conversation.id}) }}" method="POST" class="chat-input-wrapper" id="chat-form" enctype="multipart/form-data">
            <button type="button" class="btn-voice" id="record-btn" title="Enregistrer un message vocal">
                <i class="fa-solid fa-microphone"></i>
            </button>
            <textarea name="content" class="chat-input" id="chat-textarea" placeholder="Écrivez votre message ici..." required></textarea>
            <button type="submit" class="btn-send">
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </form>
    </div>
</div>

<script>
    const chatWindow = document.getElementById('chat-window');
    chatWindow.scrollTop = chatWindow.scrollHeight;

    // Submit on Enter (but Shift+Enter for newline)
    const textarea = document.getElementById('chat-textarea');
    const chatForm = document.getElementById('chat-form');
    
    textarea.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            chatForm.submit();
        }
    });

    // Voice Recording Logic
    let mediaRecorder;
    let audioChunks = [];
    const recordBtn = document.getElementById('record-btn');

    recordBtn.addEventListener('click', async () => {
        if (!mediaRecorder || mediaRecorder.state === 'inactive') {
            // Start recording
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = (event) => {
                    audioChunks.push(event.data);
                };

                mediaRecorder.onstop = async () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    const formData = new FormData();
                    formData.append('audio', audioBlob, 'voice-message.webm');

                    // Disable UI while sending
                    recordBtn.disabled = true;
                    recordBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                    try {
                        const response = await fetch(chatForm.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            window.location.reload();
                        } else {
                            alert('Erreur lors de l\'envoi du message vocal.');
                            recordBtn.disabled = false;
                            recordBtn.innerHTML = '<i class="fa-solid fa-microphone"></i>';
                        }
                    } catch (error) {
                        console.error('Error sending audio:', error);
                        alert('Erreur réseau lors de l\'envoi.');
                        recordBtn.disabled = false;
                        recordBtn.innerHTML = '<i class="fa-solid fa-microphone"></i>';
                    }
                };

                mediaRecorder.start();
                recordBtn.classList.add('recording');
                recordBtn.innerHTML = '<i class="fa-solid fa-stop"></i>';
                textarea.placeholder = "Enregistrement en cours...";
                textarea.disabled = true;

            } catch (err) {
                console.error('Error accessing microphone:', err);
                alert('Impossible d\'accéder au microphone. Vérifiez les permissions.');
            }
        } else {
            // Stop recording
            mediaRecorder.stop();
            mediaRecorder.stream.getTracks().forEach(track => track.stop());
            recordBtn.classList.remove('recording');
            recordBtn.innerHTML = '<i class="fa-solid fa-microphone"></i>';
            textarea.placeholder = "Envoi du message vocal...";
        }
    });
</script>
{% endblock %}
