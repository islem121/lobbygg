{% extends 'front/base.html.twig' %}

{% block title %}Lobby.gg • Messagerie{% endblock %}

{% block stylesheets %}
  <style>
    .chat-page {
      max-width: 1280px;
      margin: 0 auto;
      padding: 20px;
    }

    .chat-shell {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 18px;
      min-height: 72vh;
    }

    .chat-panel {
      background: rgba(15, 17, 34, 0.78);
      border: 1px solid rgba(139, 61, 255, 0.24);
      border-radius: 16px;
      box-shadow: 0 24px 60px rgba(8, 8, 20, 0.5);
      backdrop-filter: blur(8px);
      overflow: hidden;
    }

    .chat-section-title {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(139, 61, 255, 0.2);
      color: #00f0ff;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 700;
      background: rgba(139, 61, 255, 0.1);
    }

    .chat-list {
      max-height: 62vh;
      overflow-y: auto;
    }

    .chat-list::-webkit-scrollbar {
      width: 7px;
    }

    .chat-list::-webkit-scrollbar-thumb {
      background: rgba(139, 61, 255, 0.5);
      border-radius: 999px;
    }

    .chat-contact {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      text-decoration: none;
      color: var(--text-main);
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      transition: background .2s ease, transform .2s ease;
    }

    .chat-contact:hover {
      background: rgba(139, 61, 255, 0.16);
      transform: translateX(3px);
    }

    .chat-avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 12px;
      background: linear-gradient(140deg, #8b3dff, #ff3ca6);
      color: #fff;
      flex-shrink: 0;
      box-shadow: 0 0 16px rgba(139, 61, 255, 0.45);
    }

    .chat-contact-meta {
      min-width: 0;
    }

    .chat-contact-name {
      display: block;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 2px;
    }

    .chat-contact-last {
      display: block;
      color: var(--text-muted);
      font-size: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .chat-welcome {
      display: grid;
      place-items: center;
      padding: 30px;
      text-align: center;
      background:
        radial-gradient(circle at 20% 20%, rgba(0, 240, 255, 0.16), transparent 40%),
        radial-gradient(circle at 80% 0%, rgba(255, 60, 166, 0.2), transparent 38%),
        rgba(15, 17, 34, 0.78);
    }

    .chat-welcome-card {
      max-width: 560px;
      width: 100%;
      padding: 28px;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(8, 10, 22, 0.7);
    }

    .chat-welcome-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #8b3dff, #00f0ff);
      color: #090b16;
      font-size: 26px;
      box-shadow: 0 0 24px rgba(139, 61, 255, 0.5);
    }

    .chat-welcome h2 {
      margin: 0 0 8px;
      color: #fff;
      font-size: 28px;
      letter-spacing: .5px;
    }

    .chat-welcome p {
      margin: 0;
      color: var(--text-muted);
    }

    @media (max-width: 980px) {
      .chat-shell {
        grid-template-columns: 1fr;
      }
      .chat-list {
        max-height: 46vh;
      }
    }
  </style>
{% endblock %}

{% block content %}
  <section class="chat-page">
    <section class="page-head">
      <div>
        <h1 class="page-title">Messagerie</h1>
        <p class="page-sub">Conversations privées entre joueurs.</p>
      </div>
      <div class="page-actions">
        <a href="{{ path('front_blog') }}" class="btn btn-ghost">
          <i class="fa-solid fa-arrow-left"></i> Retour au feed
        </a>
      </div>
    </section>

    <section class="chat-shell">
      <aside class="chat-panel">
        {% if contacts|length > 0 %}
          <div class="chat-section-title">Conversations récentes</div>
          <div class="chat-list">
            {% for contact in contacts %}
              <a href="{{ path('app_chat_conversation', {id: contact.user.id}) }}" class="chat-contact">
                <div class="chat-avatar">{{ contact.user.username|slice(0, 2)|upper }}</div>
                <div class="chat-contact-meta">
                  <span class="chat-contact-name">{{ contact.user.username }}</span>
                  <span class="chat-contact-last">
                    {% if contact.lastMessage.sender == app.user %}Vous: {% endif %}
                    {{ contact.lastMessage.content }}
                  </span>
                </div>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        <div class="chat-section-title">Nouvelle conversation</div>
        <div class="chat-list">
          {% for user in potentialContacts %}
            <a href="{{ path('app_chat_conversation', {id: user.id}) }}" class="chat-contact">
              <div class="chat-avatar">{{ user.username|slice(0, 2)|upper }}</div>
              <div class="chat-contact-meta">
                <span class="chat-contact-name">{{ user.username }}</span>
                <span class="chat-contact-last">Commencer à discuter</span>
              </div>
            </a>
          {% else %}
            <div style="padding: 16px; color: var(--text-muted); font-size: 12px;">
              Aucun utilisateur disponible.
            </div>
          {% endfor %}
        </div>
      </aside>

      <section class="chat-panel chat-welcome">
        <div class="chat-welcome-card">
          <div class="chat-welcome-icon"><i class="fa-solid fa-comments"></i></div>
          <h2>Messagerie Lobby.gg</h2>
          <p>Sélectionnez un joueur à gauche pour ouvrir une conversation en temps réel.</p>
          <p style="margin-top: 10px;">Modération intelligente et adaptation de ton actives.</p>
        </div>
      </section>
    </section>
  </section>
{% endblock %}
