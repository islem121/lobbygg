{% extends 'front/base.html.twig' %}

{% block title %}Lobby.gg • Chat avec {{ receiver.username }}{% endblock %}

{% block stylesheets %}
  <style>
    .conversation-page {
      max-width: 1080px;
      margin: 0 auto;
      padding: 20px;
    }

    .conversation-shell {
      min-height: 74vh;
      border-radius: 16px;
      border: 1px solid rgba(139, 61, 255, 0.24);
      background: rgba(15, 17, 34, 0.8);
      box-shadow: 0 24px 60px rgba(8, 8, 20, 0.5);
      backdrop-filter: blur(8px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .conversation-head {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      border-bottom: 1px solid rgba(139, 61, 255, 0.22);
      background: rgba(139, 61, 255, 0.08);
    }

    .conversation-back {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: #fff;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: background .2s ease;
    }

    .conversation-back:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .conversation-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 12px;
      color: #fff;
      background: linear-gradient(145deg, #8b3dff, #ff3ca6);
      box-shadow: 0 0 16px rgba(139, 61, 255, 0.45);
    }

    .conversation-meta strong {
      color: #fff;
      display: block;
      line-height: 1.2;
      font-size: 14px;
    }

    .conversation-meta span {
      color: var(--text-muted);
      font-size: 12px;
    }

    .messages-list {
      flex: 1;
      overflow-y: auto;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      background:
        radial-gradient(circle at 20% 0%, rgba(0, 240, 255, 0.12), transparent 34%),
        radial-gradient(circle at 100% 100%, rgba(255, 60, 166, 0.12), transparent 40%),
        rgba(10, 11, 26, 0.7);
    }

    .messages-list::-webkit-scrollbar {
      width: 7px;
    }

    .messages-list::-webkit-scrollbar-thumb {
      background: rgba(139, 61, 255, 0.5);
      border-radius: 999px;
    }

    .message-item {
      max-width: 72%;
      padding: 10px 12px;
      border-radius: 12px;
      line-height: 1.4;
      word-wrap: break-word;
      font-size: 14px;
      border: 1px solid transparent;
    }

    .message-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 6px;
    }

    .msg-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      border-radius: 999px;
      font-size: 10px;
      padding: 3px 8px;
      text-transform: uppercase;
      letter-spacing: .4px;
      font-weight: 700;
    }

    .msg-badge-ai {
      background: rgba(0, 240, 255, 0.16);
      border: 1px solid rgba(0, 240, 255, 0.4);
      color: #8bf7ff;
    }

    .msg-badge-translated {
      background: rgba(139, 61, 255, 0.18);
      border: 1px solid rgba(139, 61, 255, 0.42);
      color: #cfb2ff;
    }

    .msg-content {
      white-space: pre-wrap;
    }

    .toggle-original {
      margin-top: 8px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 11px;
      cursor: pointer;
    }

    .message-sent {
      align-self: flex-end;
      background: rgba(139, 61, 255, 0.2);
      border-color: rgba(139, 61, 255, 0.45);
    }

    .message-received {
      align-self: flex-start;
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.11);
    }

    .message-time {
      display: block;
      font-size: 11px;
      margin-top: 6px;
      color: rgba(255, 255, 255, 0.55);
      text-align: right;
    }

    .message-toxic-warning {
      display: block;
      margin-top: 8px;
      font-size: 11px;
      color: #ffb547;
    }

    .chat-input-area {
      display: flex;
      gap: 10px;
      padding: 14px 16px;
      border-top: 1px solid rgba(139, 61, 255, 0.22);
      background: rgba(15, 17, 34, 0.95);
    }

    .chat-input {
      flex: 1;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.17);
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      padding: 10px 14px;
      font-size: 14px;
    }

    .chat-input:focus {
      outline: none;
      border-color: #00f0ff;
      box-shadow: 0 0 0 3px rgba(0, 240, 255, 0.2);
    }

    .send-btn {
      width: 42px;
      height: 42px;
      border: none;
      border-radius: 50%;
      background: linear-gradient(140deg, #8b3dff, #00f0ff);
      color: #0a0d1f;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: transform .2s ease, box-shadow .2s ease;
      box-shadow: 0 0 16px rgba(139, 61, 255, 0.35);
    }

    .send-btn:hover {
      transform: scale(1.04);
      box-shadow: 0 0 22px rgba(0, 240, 255, 0.4);
    }

    .ai-toast-wrap {
      position: fixed;
      right: 18px;
      bottom: 24px;
      z-index: 3000;
      display: flex;
      flex-direction: column;
      gap: 8px;
      pointer-events: none;
    }

    .ai-toast {
      max-width: 360px;
      color: #fff;
      background: rgba(14, 18, 34, 0.92);
      border: 1px solid rgba(255, 181, 71, 0.45);
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 12px;
      line-height: 1.35;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
      opacity: 0;
      transform: translateY(8px);
      animation: toastIn .22s ease forwards;
    }

    @keyframes toastIn {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
{% endblock %}

{% block content %}
  <section class="conversation-page">
    <section class="page-head">
      <div>
        <h1 class="page-title">Messagerie</h1>
        <p class="page-sub">Conversation privée avec {{ receiver.username }}.</p>
      </div>
      <div class="page-actions">
        <a href="{{ path('app_chat_index') }}" class="btn btn-ghost">
          <i class="fa-solid fa-arrow-left"></i> Toutes les conversations
        </a>
      </div>
    </section>

    <section class="conversation-shell">
      <header class="conversation-head">
        <a class="conversation-back" href="{{ path('app_chat_index') }}" aria-label="Retour">
          <i class="fa-solid fa-chevron-left"></i>
        </a>
        <div class="conversation-avatar">{{ receiver.username|slice(0, 2)|upper }}</div>
        <div class="conversation-meta">
          <strong>{{ receiver.username }}</strong>
          <span>
            {% if receiver.origin %}Origin: {{ receiver.origin }}{% endif %}
            {% if receiver.mood %} • Mood: {{ receiver.mood }}{% endif %}
          </span>
        </div>
      </header>

      <div class="messages-list" id="messagesList">
        {% for message in messages %}
          {% set meta = messageMeta[message.id] ?? null %}
          <div
            class="message-item {{ message.sender == app.user ? 'message-sent' : 'message-received' }}"
            data-id="{{ message.id }}"
            data-original="{{ (meta ? meta.originalContent : message.content)|e('html_attr') }}"
            data-translated="{{ (meta ? meta.translatedContent : message.content)|e('html_attr') }}"
            data-current="{{ (meta ? meta.displayContent : message.content)|e('html_attr') }}"
            data-state="current"
          >
            <div class="message-badges">
              {% if meta and meta.aiAssisted %}
                <span class="msg-badge msg-badge-ai">AI Assisted</span>
              {% endif %}
              {% if meta and meta.isTranslated %}
                <span class="msg-badge msg-badge-translated">Translated from {{ meta.sourceLabel }} -> {{ meta.targetLabel }}</span>
              {% endif %}
            </div>
            <div class="msg-content">{{ meta ? meta.displayContent : message.content }}</div>
            {% if meta and meta.isTranslated %}
              <button type="button" class="toggle-original">Voir original</button>
            {% endif %}
            {% if meta and meta.showModerationNotice %}
              <span class="message-toxic-warning">Ton message a été ajusté pour maintenir un environnement sain.</span>
            {% elseif message.isToxic and message.sender == app.user %}
              <span class="message-toxic-warning">Message modéré (toxicité détectée)</span>
            {% endif %}
            <span class="message-time">{{ message.createdAt|date('H:i') }}</span>
          </div>
        {% endfor %}
      </div>

      <form class="chat-input-area" id="chatForm">
        <input type="text" class="chat-input" id="messageInput" placeholder="Écrivez votre message..." autocomplete="off">
        <button type="submit" class="send-btn" aria-label="Envoyer">
          <i class="fa-solid fa-paper-plane"></i>
        </button>
      </form>
    </section>
    <div class="ai-toast-wrap" id="aiToastWrap" aria-live="polite" aria-atomic="true"></div>
  </section>
{% endblock %}

{% block javascripts %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const messagesList = document.getElementById('messagesList');
      const chatForm = document.getElementById('chatForm');
      const messageInput = document.getElementById('messageInput');
      let lastMessageId = {{ messages|last ? messages|last.id : 0 }};

      messagesList.scrollTop = messagesList.scrollHeight;

      chatForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const content = messageInput.value.trim();
        if (!content) return;

        messageInput.value = '';

        fetch(`{{ path('app_chat_send', {id: receiver.id}) }}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ content: content })
        })
        .then(response => response.json())
        .then(data => {
          if (data.status === 'success') {
            appendMessage(data.message);
            lastMessageId = data.message.id;
          } else {
            alert('Erreur: ' + data.error);
          }
        })
        .catch(error => console.error('Error:', error));
      });

      function appendMessage(msg) {
        const div = document.createElement('div');
        div.className = `message-item ${msg.isSelf ? 'message-sent' : 'message-received'}`;
        div.dataset.id = msg.id;
        div.dataset.original = msg.originalContent || msg.content || '';
        div.dataset.translated = msg.translatedContent || msg.content || '';
        div.dataset.current = msg.content || '';
        div.dataset.state = 'current';

        let html = '<div class="message-badges">';
        if (msg.aiAssisted) {
          html += '<span class="msg-badge msg-badge-ai">AI Assisted</span>';
        }
        if (msg.isTranslated) {
          html += `<span class="msg-badge msg-badge-translated">Translated from ${escapeHtml(msg.translationLabel)}</span>`;
        }
        html += '</div>';
        html += `<div class="msg-content">${escapeHtml(msg.content || '')}</div>`;

        if (msg.isTranslated) {
          html += '<button type="button" class="toggle-original">Voir original</button>';
        }
        if (msg.showModerationNotice) {
          html += '<span class="message-toxic-warning">Ton message a été ajusté pour maintenir un environnement sain.</span>';
          if (msg.playerNotice) {
            showAiToast(msg.playerNotice);
          }
        } else if (msg.isToxic && msg.isSelf) {
          html += '<span class="message-toxic-warning">Message modéré (toxicité détectée)</span>';
        }
        html += `<span class="message-time">${msg.createdAt}</span>`;

        div.innerHTML = html;
        messagesList.appendChild(div);
        messagesList.scrollTop = messagesList.scrollHeight;
      }

      messagesList.addEventListener('click', function(e) {
        if (!e.target.classList.contains('toggle-original')) {
          return;
        }

        const messageNode = e.target.closest('.message-item');
        const contentNode = messageNode.querySelector('.msg-content');
        const isOriginal = messageNode.dataset.state === 'original';

        if (isOriginal) {
          contentNode.textContent = messageNode.dataset.current || messageNode.dataset.translated || '';
          messageNode.dataset.state = 'current';
          e.target.textContent = 'Voir original';
        } else {
          contentNode.textContent = messageNode.dataset.original || '';
          messageNode.dataset.state = 'original';
          e.target.textContent = 'Voir traduit';
        }
      });

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function showAiToast(text) {
        const wrap = document.getElementById('aiToastWrap');
        if (!wrap || !text) return;

        const node = document.createElement('div');
        node.className = 'ai-toast';
        node.textContent = `⚠️ ${text}`;
        wrap.appendChild(node);

        setTimeout(() => {
          node.style.opacity = '0';
          node.style.transform = 'translateY(8px)';
          node.style.transition = 'opacity .2s ease, transform .2s ease';
          setTimeout(() => node.remove(), 220);
        }, 4500);
      }

      setInterval(function() {
        fetch(`{{ path('app_chat_poll', {id: receiver.id}) }}?lastId=${lastMessageId}`)
          .then(response => response.json())
          .then(data => {
            if (data.messages && data.messages.length > 0) {
              data.messages.forEach(msg => {
                appendMessage(msg);
                if (msg.id > lastMessageId) {
                  lastMessageId = msg.id;
                }
              });
            }
          })
          .catch(error => console.error('Error polling messages:', error));
      }, 3000);
    });
  </script>
{% endblock %}
