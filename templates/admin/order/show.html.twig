{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Détails de la Commande #{{ order.id }}{% endblock %}
{% block content_title %}Commande #{{ order.id }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_order_index') }}">Commandes</a></li>
    <li class="breadcrumb-item active">#{{ order.id }}</li>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-6">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-info-circle"></i> Informations Générales</h3>
            </div>
            <div class="card-body">
                <table class="table">
                    <tr>
                        <th>Date de commande :</th>
                        <td>{{ order.orderDate|date('d/m/Y H:i') }}</td>
                    </tr>
                    <tr>
                        <th>Statut actuel :</th>
                        <td>
                            {% if order.status == 'pending' %}
                                <span class="badge bg-warning">En attente</span>
                            {% elseif order.status == 'shipped' %}
                                <span class="badge bg-info">Expédiée</span>
                            {% elseif order.status == 'delivered' %}
                                <span class="badge bg-success">Livrée</span>
                            {% elseif order.status == 'cancelled' %}
                                <span class="badge bg-danger">Annulée</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ order.status }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Quantité :</th>
                        <td>{{ order.quantity }}</td>
                    </tr>
                    <tr>
                        <th>Prix Unitaire :</th>
                        <td>{{ order.product.price }} DT</td>
                    </tr>
                    <tr>
                        <th>Total :</th>
                        <td><strong>{{ order.product.price * order.quantity }} DT</strong></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card card-info card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-person"></i> Client & Produit</h3>
            </div>
            <div class="card-body">
                <h5>Client</h5>
                <p>
                    <strong>Nom :</strong> {{ order.user.nom }} {{ order.user.prenom }}<br>
                    <strong>Email :</strong> {{ order.user.email }}
                </p>
                <hr>
                <h5>Produit</h5>
                <p>
                    <strong>Nom :</strong> {{ order.product.name }}<br>
                    <strong>Catégorie :</strong> {{ order.product.category ? order.product.category.name : 'Aucune' }}
                </p>
                {% if order.product.image %}
                    <img src="{{ order.product.image starts with 'http' ? order.product.image : asset(order.product.image) }}" alt="{{ order.product.name }}" class="img-fluid rounded" style="max-height: 150px;">
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="{{ path('app_admin_order_index') }}" class="btn btn-secondary">Retour à la liste</a>
</div>
{% endblock %}
