{% extends 'admin/layout.html.twig' %}

{% block content_title %}Modifier le Sponsor{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_sponsoring') }}">Sponsor Management</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_sponsor_index') }}">Sponsors</a></li>
    <li class="breadcrumb-item active">Modifier</li>
{% endblock %}

{% block content %}
    <div class="card card-warning">
        <div class="card-header">
            <h3 class="card-title">Modification de l'offre : {{ sponsor.nomSociete }}</h3>
        </div>
        {{ include('admin/sponsor/_form.html.twig', {'button_label': 'Mettre à jour', 'back_path': path('app_admin_sponsor_index')}) }}
    </div>
{% endblock %}
