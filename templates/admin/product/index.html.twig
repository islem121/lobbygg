{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Gestion des Produits{% endblock %}
{% block content_title %}Liste des Produits{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item active">Produits</li>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Produits du Marketplace</h3>
        <div class="card-tools d-flex align-items-center gap-2">
            <a href="{{ path('app_admin_product_new') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i> Nouveau Produit
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        <a href="{{ path('app_admin_product_index', {
                            'q': searchQuery,
                            'sort': 'id',
                            'direction': currentSort == 'id' and currentDirection == 'ASC' ? 'DESC' : 'ASC'
                        }) }}" class="text-dark text-decoration-none">
                            ID 
                            {% if currentSort == 'id' %}
                                <i class="bi bi-arrow-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th>Image</th>
                    <th>
                        <a href="{{ path('app_admin_product_index', {
                            'q': searchQuery,
                            'sort': 'name',
                            'direction': currentSort == 'name' and currentDirection == 'ASC' ? 'DESC' : 'ASC'
                        }) }}" class="text-dark text-decoration-none">
                            Nom
                            {% if currentSort == 'name' %}
                                <i class="bi bi-arrow-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th>Catégorie</th>
                    <th>
                        <a href="{{ path('app_admin_product_index', {
                            'q': searchQuery,
                            'sort': 'price',
                            'direction': currentSort == 'price' and currentDirection == 'ASC' ? 'DESC' : 'ASC'
                        }) }}" class="text-dark text-decoration-none">
                            Prix
                            {% if currentSort == 'price' %}
                                <i class="bi bi-arrow-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_admin_product_index', {
                            'q': searchQuery,
                            'sort': 'stock',
                            'direction': currentSort == 'stock' and currentDirection == 'ASC' ? 'DESC' : 'ASC'
                        }) }}" class="text-dark text-decoration-none">
                            Stock
                            {% if currentSort == 'stock' %}
                                <i class="bi bi-arrow-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_admin_product_index', {
                            'q': searchQuery,
                            'sort': 'createdAt',
                            'direction': currentSort == 'createdAt' and currentDirection == 'ASC' ? 'DESC' : 'ASC'
                        }) }}" class="text-dark text-decoration-none">
                            Date Création
                            {% if currentSort == 'createdAt' %}
                                <i class="bi bi-arrow-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for product in products %}
                <tr>
                    <td>{{ product.id }}</td>
                    <td>
                        {% if product.image %}
                            <img src="{{ product.image starts with 'http' ? product.image : asset(product.image) }}" alt="{{ product.name }}" style="height: 50px; border-radius: 4px;">
                        {% else %}
                            <span class="badge bg-secondary">Pas d'image</span>
                        {% endif %}
                    </td>
                    <td>{{ product.name }}</td>
                    <td>{{ product.category ? product.category.name : 'Aucune' }}</td>
                    <td>{{ product.price }} €</td>
                    <td>{{ product.stock }}</td>
                    <td>{{ product.createdAt ? product.createdAt|date('d/m/Y H:i') : '-' }}</td>
                    <td>
                        <div class="btn-group">
                            <a href="{{ path('app_admin_product_show', {'id': product.id}) }}" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('app_admin_product_delete', {'id': product.id}) }}" style="display:inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                <button class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucun produit trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
