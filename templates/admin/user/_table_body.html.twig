{% for user in users %}
    <tr>
        <td>{{ user.id }}</td>
        <td>{{ user.username }}</td>
        <td>{{ user.nom ?? '-' }}</td>
        <td>{{ user.prenom ?? '-' }}</td>
        <td>{{ user.email }}</td>
        <td>
            <span class="badge {{ user.role == 'admin' ? 'bg-danger' : (user.role == 'sponsor' ? 'bg-warning' : 'bg-success') }}">
                {{ user.role|capitalize }}
            </span>
            {% if user.isBlocked %}
                <span class="badge bg-dark">Bloqué</span>
            {% endif %}
        </td>
        <td>{{ user.dateNaissance ? user.dateNaissance|date('d/m/Y') : '-' }}</td>
        <td>{{ user.genre ?? '-' }}</td>
        <td>{{ user.origin ?? '-' }}</td>
        <td>{{ user.telephone ?? '-' }}</td>
        <td>
            {% if user.faceDescriptor %}
                <span class="badge bg-info">Activé</span>
            {% else %}
                <span class="badge bg-secondary">Non activé</span>
            {% endif %}
        </td>
        <td>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '-' }}</td>
        <td>
            <div class="btn-group">
                <a href="{{ path('app_admin_user_show', {'id': user.id}) }}" class="btn btn-info btn-sm">
                    <i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-sm">
                    <i class="bi bi-pencil"></i>
                </a>
                <form method="post" action="{{ path('app_admin_user_block', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir {{ user.isBlocked ? 'débloquer' : 'bloquer' }} cet utilisateur ?');" style="display: inline-block;">
                    <input type="hidden" name="_token" value="{{ csrf_token('block' ~ user.id) }}">
                    <button class="btn btn-{{ user.isBlocked ? 'success' : 'dark' }} btn-sm" title="{{ user.isBlocked ? 'Débloquer' : 'Bloquer' }}">
                        <i class="bi bi-{{ user.isBlocked ? 'unlock-fill' : 'lock-fill' }}"></i>
                    </button>
                </form>
                {{ include('admin/user/_delete_form.html.twig') }}
            </div>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="12" class="text-center">Aucun utilisateur trouvé</td>
    </tr>
{% endfor %}
