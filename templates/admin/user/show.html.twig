{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Détails de l'Utilisateur{% endblock %}
{% block content_title %}Utilisateur : {{ user.username }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_user_index') }}">Utilisateurs</a></li>
    <li class="breadcrumb-item active">Détails</li>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-4">
        <div class="card card-primary card-outline">
            <div class="card-body box-profile">
                <div class="text-center">
                    <img class="profile-user-img img-fluid img-circle"
                         src="{{ user.image ? asset('uploads/profiles/' ~ user.image) : asset('admin_assets/assets/img/user2-160x160.jpg') }}"
                         alt="User profile picture">
                </div>
                <h3 class="profile-username text-center">{{ user.prenom }} {{ user.nom }}</h3>
                <p class="text-muted text-center">{{ user.role|capitalize }}</p>
                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Email</b> <a class="float-end">{{ user.email }}</a>
                    </li>
                    <li class="list-group-item">
                        <b>Téléphone</b> <a class="float-end">{{ user.telephone ?: '-' }}</a>
                    </li>
                </ul>
                <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-primary btn-block"><b>Modifier</b></a>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header p-2">
                <h3 class="card-title">Informations Complètes</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th>ID</th>
                        <td>{{ user.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom d'utilisateur</th>
                        <td>{{ user.username }}</td>
                    </tr>
                    <tr>
                        <th>Biographie</th>
                        <td>{{ user.bio ?: 'Aucune biographie renseignée' }}</td>
                    </tr>
                    <tr>
                        <th>Date de création</th>
                        <td>{{ user.createdAt|date('d/m/Y H:i:s') }}</td>
                    </tr>
                </table>
            </div>
            <div class="card-footer">
                <a href="{{ path('app_admin_user_index') }}" class="btn btn-default">Retour à la liste</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
