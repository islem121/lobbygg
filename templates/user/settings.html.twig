{% extends 'front/base.html.twig' %}

{% block title %}Settings - LOBBY.GG{% endblock %}

{% block stylesheets %}
<style>
    .settings-container {
        max-width: 800px;
        margin: 40px auto;
        padding: 30px;
        background: rgba(25, 10, 45, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(139, 61, 255, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 30px rgba(139, 61, 255, 0.1);
    }

    .settings-title {
        font-family: 'Courier New', monospace;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 4px;
        margin-bottom: 30px;
        text-shadow: 0 0 10px rgba(139, 61, 255, 0.8);
        border-bottom: 1px solid rgba(139, 61, 255, 0.2);
        padding-bottom: 10px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        color: rgba(255, 255, 255, 0.6);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .form-input {
        width: 100%;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(139, 61, 255, 0.3);
        color: #fff;
        padding: 12px 15px;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        transition: all 0.3s ease;
    }

    .form-input:focus {
        outline: none;
        border-color: #8B3DFF;
        box-shadow: 0 0 15px rgba(139, 61, 255, 0.3);
    }

    .btn-save {
        background: #8B3DFF;
        color: #fff;
        border: none;
        padding: 12px 30px;
        font-family: 'Courier New', monospace;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 20px rgba(139, 61, 255, 0.4);
    }

    .btn-save:hover {
        background: #9d5cff;
        transform: translateY(-2px);
        box-shadow: 0 0 30px rgba(139, 61, 255, 0.6);
    }

    .btn-delete {
        background: #ff0055;
        color: #fff;
        border: none;
        padding: 12px 30px;
        font-family: 'Courier New', monospace;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 20px rgba(255, 0, 85, 0.4);
        margin-right: 10px;
    }

    .btn-delete:hover {
        background: #ff3377;
        transform: translateY(-2px);
        box-shadow: 0 0 30px rgba(255, 0, 85, 0.6);
    }

    .settings-avatar-section {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        padding: 20px;
        background: rgba(139, 61, 255, 0.05);
        border-radius: 8px;
        border: 1px dashed rgba(139, 61, 255, 0.3);
    }

    .settings-avatar-preview {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8B3DFF, #ff0080);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: bold;
        color: #fff;
        overflow: hidden;
        border: 2px solid rgba(255, 255, 255, 0.1);
    }

    .settings-avatar-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .user-current-info {
        background: rgba(139, 61, 255, 0.05);
        padding: 15px;
        border-radius: 4px;
        margin-bottom: 30px;
        border-left: 3px solid #ff0080;
    }

    .info-item {
        margin-bottom: 5px;
        font-size: 13px;
    }

    .info-label {
        color: rgba(255, 255, 255, 0.4);
    }

    .info-value {
        color: #ff0080;
        font-weight: bold;
    }

    .cyber-error {
        color: #ff0055;
        font-size: 11px;
        font-family: 'Courier New', monospace;
        text-transform: uppercase;
        margin-top: 5px;
        display: block;
        text-shadow: 0 0 5px rgba(255, 0, 85, 0.5);
    }
</style>
{% endblock %}

{% block content %}
<div class="settings-container">
    <h1 class="settings-title">User Settings</h1>

    <form id="settings-form" action="{{ path('app_settings_update') }}" method="POST" enctype="multipart/form-data" novalidate>
        <div class="settings-avatar-section">
            <div class="settings-avatar-preview">
                {% if user.image %}
                    <img src="{{ asset('uploads/profiles/' ~ user.image) }}" alt="Profile">
                {% else %}
                    {{ user.prenom|first|upper }}
                {% endif %}
            </div>
            <div style="flex: 1;">
                <label class="form-label">Profile Picture (Optional)</label>
                <input type="file" class="form-input" name="profile_image" accept="image/*">
                <p style="font-size: 10px; color: rgba(255,255,255,0.3); margin-top: 5px;">Recommended: Square image, max 2MB.</p>
                {% if errors.image is defined %}<span class="cyber-error">{{ errors.image }}</span>{% endif %}
            </div>
        </div>

        <div class="user-current-info">
            <div class="info-item">
                <span class="info-label">Account Type:</span> 
                <span class="info-value">{% if 'ROLE_SPONSOR' in user.roles %}SPONSOR{% else %}CLIENT{% endif %}</span>
            </div>
            <div class="info-item">
                <span class="info-label">Member Since:</span> 
                <span class="info-value">{{ "now"|date("M Y") }}</span>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Username</label>
            <input type="text" class="form-input" name="username" value="{{ user.prenom }}" placeholder="New username...">
            {% if errors.username is defined %}<span class="cyber-error">{{ errors.username }}</span>{% endif %}
            {% if errors.prenom is defined %}<span class="cyber-error">{{ errors.prenom }}</span>{% endif %}
        </div>

        <div class="form-group">
            <label class="form-label">Email Address</label>
            <input type="email" class="form-input" name="email" value="{{ user.email }}" placeholder="New email...">
            {% if errors.email is defined %}<span class="cyber-error">{{ errors.email }}</span>{% endif %}
        </div>

        <div class="form-group">
            <label class="form-label">New Password</label>
            <input type="password" class="form-input" name="password" placeholder="Leave blank to keep current...">
            {% if errors.password is defined %}<span class="cyber-error">{{ errors.password }}</span>{% endif %}
        </div>

        <div class="form-group">
            <label class="form-label">Confirm New Password</label>
            <input type="password" class="form-input" name="password_confirm" placeholder="Confirm new password...">
        </div>
    </form>

    <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 40px;">
        <form action="{{ path('app_account_delete') }}" method="POST" onsubmit="return confirm('Are you sure you want to delete your account? This action cannot be undone.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
            <button type="submit" class="btn-delete">Delete Account</button>
        </form>
        <button type="submit" form="settings-form" class="btn-save">Update Profile</button>
    </div>
</div>
{% endblock %}
