{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="cyber-container">
    <div class="cyber-terminal">

        <h2 class="terminal-title">[ RESET_PASSWORD ]</h2>
        <p class="access-text">Entrez votre email pour recevoir un lien</p>

        {% for message in app.flashes('error') %}
            <div class="cyber-alert error">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="cyber-alert success">{{ message }}</div>
        {% endfor %}

        <form method="post" class="neon-form" novalidate>
            <div class="input-group">
                <label>Email</label>
                <input type="email"
                       name="email"
                       class="cyber-input"
                       placeholder="> user@lobby.gg"
                       required>
            </div>

            <button type="submit" class="neon-button">
                [ ENVOYER_LIEN ]
            </button>
        </form>

        <div class="form-footer">
            <a href="{{ path('app_login') }}" class="cyber-link">
                ← Retour connexion
            </a>
        </div>

    </div>
</div>
{% endblock %}
