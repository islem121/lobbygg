<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔐 Inscription - LOBBY.GG</title>
    
    {# CSS Neon Cyber (même que login) #}
    <link rel="stylesheet" href="{{ asset('css/neon-cyber.css') }}">
    
    {# Font Awesome #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Reset et base */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #0a0a14;
            font-family: 'Courier New', monospace;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 10px;
            overflow-x: hidden;
            font-size: 0.85rem;
        }

        /* Container principal ultra compact */
        .login-container.register-container {
            width: 100%;
            max-width: 420px;
            margin: 0 auto;
            padding: 5px;
        }

        /* Terminal super compact */
        .cyber-terminal {
            padding: 12px;
            max-height: 90vh;
            overflow-y: auto;
        }

        /* Scrollbar discrète */
        .cyber-terminal::-webkit-scrollbar {
            width: 3px;
        }
        
        .cyber-terminal::-webkit-scrollbar-track {
            background: rgba(106, 13, 173, 0.1);
        }
        
        .cyber-terminal::-webkit-scrollbar-thumb {
            background: #6A0DAD;
            border-radius: 2px;
        }

        /* Contenu principal ultra compact */
        .cyber-content {
            padding: 8px 5px;
        }

        /* En-tête compact */
        .neon-header {
            margin-bottom: 12px;
        }

        .cyber-logo {
            transform: scale(0.7);
            margin-bottom: 3px;
        }

        .cyber-title {
            font-size: 1.2rem;
            margin: 6px 0;
        }

        .access-text {
            font-size: 0.7rem;
            margin-bottom: 12px;
        }

        /* Grille nom/prénom compacte */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }

        /* Champs compacts */
        .cyber-field {
            margin-bottom: 12px;
            position: relative;
        }

        .cyber-field label {
            font-size: 0.8rem;
            margin-bottom: 4px;
            opacity: 0.7;
            transition: opacity 0.3s, transform 0.3s;
            display: block;
        }

        .cyber-field input:focus + label,
        .cyber-field input:not(:placeholder-shown) + label,
        .cyber-field select:focus + label,
        .cyber-field select:not([value=""]) + label {
            opacity: 0;
            transform: translateY(-5px);
        }

        .cyber-field input,
        .cyber-field select {
            padding: 8px;
            font-size: 0.8rem;
            height: 36px;
            width: 100%;
            background: transparent !important;
            color: #fff !important;
            border: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            cursor: pointer;
        }

        /* CORRECTION DU SELECT DE ROLE */
        .role-select-wrapper {
            position: relative;
        }

        .role-select-wrapper::after {
            content: "▼";
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9D4EDD;
            font-size: 0.7rem;
            pointer-events: none;
            z-index: 10;
        }

        .role-select-wrapper select {
            background: rgba(0, 0, 0, 0.3) !important;
            border: 1px solid rgba(106, 13, 173, 0.5) !important;
            border-radius: 4px;
            padding-right: 25px !important;
        }

        .role-select-wrapper select option {
            background-color: #0a0a14 !important;
            color: #fff !important;
            padding: 8px;
        }

        .role-select-wrapper select:focus {
            outline: none;
            border-color: #9D4EDD !important;
            box-shadow: 0 0 5px rgba(157, 78, 221, 0.5);
        }

        /* Messages d'erreur */
        .cyber-error {
            font-size: 0.65rem;
            margin-top: 3px;
            min-height: 14px;
            color: #FF6B9D;
            display: none;
        }

        .cyber-error.show {
            display: block;
        }

        /* Checkbox compacte */
        .neon-checkbox {
            font-size: 0.75rem;
            margin: 10px 0;
        }

        /* Boutons d'action */
        .form-actions {
            display: flex;
            gap: 8px;
            margin-top: 15px;
        }

        .neon-button {
            padding: 8px 15px;
            font-size: 0.8rem;
            min-height: 36px;
        }

        .btn-secondary {
            padding: 7px 12px;
            font-size: 0.75rem;
            min-height: 36px;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Responsive */
        @media (max-width: 480px) {
            body {
                padding: 8px;
            }
            
            .login-container.register-container {
                max-width: 100%;
                padding: 0;
            }
            
            .cyber-terminal {
                padding: 10px;
            }
            
            .form-grid {
                grid-template-columns: 1fr;
                gap: 8px;
            }
            
            .cyber-field {
                margin-bottom: 10px;
            }
            
            .form-actions {
                flex-direction: column;
                gap: 6px;
            }
        }

        /* Styles spécifiques pour les champs Symfony */
        .field-frame input,
        .field-frame select {
            background: transparent !important;
            position: relative !important;
            z-index: 2 !important;
        }

        .field-border {
            z-index: 1 !important;
        }

        /* Ajustements pour les formulaires Symfony */
        .neon-form .form-error {
            color: #FF6B9D;
            font-size: 0.7rem;
            margin-top: 5px;
            padding: 5px 10px;
            background: rgba(255, 107, 157, 0.1);
            border-radius: 4px;
            border-left: 2px solid #FF6B9D;
        }
    </style>
</head>
<body>
    {# Grille cyberpunk minimale #}
    <div class="cyber-grid">
        <div class="grid-line grid-h-1"></div>
        <div class="grid-line grid-v-1"></div>
    </div>

    <div class="login-container register-container">
        <div class="cyber-terminal">
            <div class="terminal-header">
                <div class="terminal-buttons">
                    <div class="term-btn btn-red"></div>
                    <div class="term-btn btn-yellow"></div>
                    <div class="term-btn btn-green"></div>
                </div>
                <div class="terminal-title">ACCOUNT_CREATION.EXE</div>
            </div>
            
            <div class="cyber-content">
                {# Logo et titre #}
                <div class="neon-header">
                    <div class="cyber-logo">
                        <div class="logo-frame">
                            <div class="logo-core">
                                <svg width="30" height="30" viewBox="0 0 40 40" fill="none">
                                    <path d="M20 10C14.477 10 10 14.477 10 20C10 25.523 14.477 30 20 30C25.523 30 30 25.523 30 20C30 14.477 25.523 10 20 10ZM20 25C17.239 25 15 22.761 15 20C15 17.239 17.239 15 20 15C22.761 15 25 17.239 25 20C25 22.761 22.761 25 20 25Z" fill="#6A0DAD"/>
                                    <path d="M22 18H18V22H22V18Z" fill="#FF6B9D"/>
                                </svg>
                            </div>
                            <div class="logo-scanner"></div>
                        </div>
                        <div class="neon-glow"></div>
                    </div>
                    <h1 class="cyber-title">
                        <span class="title-glitch" data-text="NEW_PROFILE">NEW_PROFILE</span>
                    </h1>
                    <p class="access-text">[ LOBBY.GG_REGISTRATION ]</p>
                </div>
                
                {# Formulaire Symfony #}
                {{ form_start(registrationForm, {
                    'attr': {
                        'class': 'neon-form',
                        'id': 'registerForm',
                        'novalidate': 'novalidate'
                    }
                }) }}
                
                {# Grille pour nom/prénom #}
                <div class="form-grid">
                    {# NOM #}
                    <div class="cyber-field">
                        <div class="field-frame">
                            <div class="field-border"></div>
                            {{ form_widget(registrationForm.nom, {
                                'attr': {
                                    'placeholder': 'Entrez votre nom'
                                }
                            }) }}
                            <label for="{{ registrationForm.nom.vars.id }}">&gt; NOM</label>
                            <div class="cyber-scanner">
                                <div class="scan-line"></div>
                            </div>
                        </div>
                        <span class="cyber-error {% if form_errors(registrationForm.nom) %}show{% endif %}">
                            {{ form_errors(registrationForm.nom) }}
                        </span>
                    </div>
                    
                    {# PRÉNOM #}
                    <div class="cyber-field">
                        <div class="field-frame">
                            <div class="field-border"></div>
                            {{ form_widget(registrationForm.username, {
                                'attr': {
                                    'placeholder': 'Entrez votre prénom'
                                }
                            }) }}
                            <label for="{{ registrationForm.username.vars.id }}">&gt; PRÉNOM</label>
                            <div class="cyber-scanner">
                                <div class="scan-line"></div>
                            </div>
                        </div>
                        <span class="cyber-error {% if form_errors(registrationForm.username) %}show{% endif %}">
                            {{ form_errors(registrationForm.username) }}
                        </span>
                    </div>
                </div>
                
                {# EMAIL #}
                <div class="cyber-field">
                    <div class="field-frame">
                        <div class="field-border"></div>
                        {{ form_widget(registrationForm.email, {
                            'attr': {
                                'placeholder': 'exemple@domaine.com'
                            }
                        }) }}
                        <label for="{{ registrationForm.email.vars.id }}">&gt; EMAIL</label>
                        <div class="cyber-scanner">
                            <div class="scan-line"></div>
                        </div>
                    </div>
                    <span class="cyber-error {% if form_errors(registrationForm.email) %}show{% endif %}">
                        {{ form_errors(registrationForm.email) }}
                    </span>
                </div>
                
                {# ROLE #}
                <div class="cyber-field">
                    <div class="role-select-wrapper">
                        {{ form_widget(registrationForm.role) }}
                        <label for="{{ registrationForm.role.vars.id }}">&gt; ROLE</label>
                    </div>
                    <span class="cyber-error {% if form_errors(registrationForm.role) %}show{% endif %}">
                        {{ form_errors(registrationForm.role) }}
                    </span>
                </div>
                
                {# MOT DE PASSE (password) #}
                <div class="cyber-field">
                    <div class="field-frame">
                        <div class="field-border"></div>
                        {{ form_widget(registrationForm.password, {
                            'attr': {
                                'placeholder': 'Min. 6 caractères, 2 chiffres, 1 majuscule'
                            }
                        }) }}
                        <label>MOT DE PASSE</label>
                        <div class="cyber-scanner">
                            <div class="scan-line"></div>
                        </div>
                    </div>
                    <span class="cyber-error {% if form_errors(registrationForm.password) %}show{% endif %}">
                        {{ form_errors(registrationForm.password) }}
                    </span>
                </div>
                
                {# DATE NAISSANCE #}
                <div class="cyber-field">
                    <div class="field-frame">
                        <div class="field-border"></div>
                        {{ form_widget(registrationForm.dateNaissance) }}
                        <label for="{{ registrationForm.dateNaissance.vars.id }}">&gt; DATE_NAISSANCE</label>
                        <div class="cyber-scanner">
                            <div class="scan-line"></div>
                        </div>
                    </div>
                    <span class="cyber-error {% if form_errors(registrationForm.dateNaissance) %}show{% endif %}">
                        {{ form_errors(registrationForm.dateNaissance) }}
                    </span>
                </div>
                
                {# TELEPHONE #}
                <div class="cyber-field">
                    <div class="field-frame">
                        <div class="field-border"></div>
                        {{ form_widget(registrationForm.telephone, {
                            'attr': {
                                'placeholder': '06 12 34 56 78'
                            }
                        }) }}
                        <label for="{{ registrationForm.telephone.vars.id }}">&gt; TÉLÉPHONE</label>
                        <div class="cyber-scanner">
                            <div class="scan-line"></div>
                        </div>
                    </div>
                    <span class="cyber-error {% if form_errors(registrationForm.telephone) %}show{% endif %}">
                        {{ form_errors(registrationForm.telephone) }}
                    </span>
                </div>
                
                {# BOUTONS #}
                <div class="form-actions">
                    <button type="submit" class="neon-button">
                        <div class="btn-matrix"></div>
                        <span class="btn-text">[ CRÉER ]</span>
                        <div class="btn-loader">
                            <div class="matrix-loader">
                                <div class="matrix-bar"></div>
                                <div class="matrix-bar"></div>
                                <div class="matrix-bar"></div>
                            </div>
                        </div>
                        <div class="btn-glow"></div>
                    </button>
                    
                    <a href="{{ path('app_login') }}" class="btn-secondary">
                        <i class="fas fa-arrow-left"></i> RETOUR
                    </a>
                </div>
                
                {{ form_end(registrationForm) }}
                
                {# Footer #}
                <div class="cyber-footer">
                    <div style="text-align: center; padding-top: 8px; border-top: 1px solid rgba(106, 13, 173, 0.1);">
                        <div style="color: rgba(106, 13, 173, 0.5); font-size: 0.6rem; letter-spacing: 0.3px;">
                            <div>SYSTEM: <span style="color: #6A0DAD;">REG_v3.2</span></div>
                            <div>REQ: <span style="color: #6A0DAD;">13≤AGE≤70 • PWD:6+ 2N 1M</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {# JavaScript minimal pour les interactions #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Gestion des labels flottants
            const inputs = document.querySelectorAll('.neon-form input, .neon-form select');
            
            inputs.forEach(input => {
                // Initialiser l'état du label
                updateLabelVisibility(input);
                
                // Événements pour mettre à jour
                input.addEventListener('input', function() {
                    updateLabelVisibility(this);
                });
                
                input.addEventListener('focus', function() {
                    updateLabelVisibility(this);
                });
                
                input.addEventListener('blur', function() {
                    updateLabelVisibility(this);
                });
            });
            
            function updateLabelVisibility(element) {
                const label = element.previousElementSibling;
                if (label && label.tagName === 'LABEL') {
                    const hasValue = element.value.trim() !== '' || 
                                   (element.tagName === 'SELECT' && element.value !== '');
                    
                    if (hasValue || document.activeElement === element) {
                        label.style.opacity = '0';
                        label.style.transform = 'translateY(-5px)';
                    } else {
                        label.style.opacity = '0.7';
                        label.style.transform = 'translateY(0)';
                    }
                }
            }
            
            // Formatage automatique du téléphone
            const phoneInput = document.querySelector('input[type="tel"]');
            if (phoneInput) {
                phoneInput.addEventListener('input', function() {
                    let value = this.value.replace(/\D/g, '');
                    
                    if (value.length > 10) {
                        value = value.substring(0, 10);
                    }
                    
                    if (value.length > 0) {
                        let formatted = '';
                        for (let i = 0; i < value.length; i++) {
                            if (i > 0 && i % 2 === 0) {
                                formatted += ' ';
                            }
                            formatted += value[i];
                        }
                        this.value = formatted;
                    }
                });
            }
            
            // Limite de date pour la date de naissance (13-70 ans)
            const dateInput = document.querySelector('input[type="date"]');
            if (dateInput) {
                const today = new Date();
                const maxDate = new Date(today.getFullYear() - 13, today.getMonth(), today.getDate());
                const minDate = new Date(today.getFullYear() - 70, today.getMonth(), today.getDate());
                
                dateInput.max = maxDate.toISOString().split('T')[0];
                dateInput.min = minDate.toISOString().split('T')[0];
            }
        });
    </script>
</body>
</html>