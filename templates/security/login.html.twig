{# templates/security/login.html.twig - AVEC VALIDATION SYMFONY #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Cyber Login - Plateforme Gaming</title>
    
    <link rel="stylesheet" href="{{ asset('css/neon-cyber.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
   <style>
    /* Styles pour erreurs Symfony */
    .symfony-error {
        background: rgba(160, 178, 200, 0.05);
        border: 1px solid #A0B2C8;
        padding: 12px 16px;
        margin-bottom: 20px;
        border-radius: 4px;
        color: #A0B2C8;
        font-size: 14px;
        animation: glitch 0.5s infinite;
        display: {% if error %}block{% else %}none{% endif %};
    }
    
    @keyframes glitch {
        0% { transform: translate(0); }
        20% { transform: translate(-0.5px, 0.5px); }
        40% { transform: translate(-0.5px, -0.5px); }
        60% { transform: translate(0.5px, 0.5px); }
        80% { transform: translate(0.5px, -0.5px); }
        100% { transform: translate(0); }
    }
    
    .symfony-links {
        display: flex;
        justify-content: space-between;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid rgba(160, 178, 200, 0.15);
    }
    
    .symfony-link {
        color: #A0B2C8;
        text-decoration: none;
        font-size: 13px;
        opacity: 0.8;
        transition: opacity 0.3s;
    }
    
    .symfony-link:hover { opacity: 1; }
    
    /* Style pour les messages d'erreur de validation */
    .validation-error {
        color: #A0B2C8;
        font-size: 12px;
        margin-top: 5px;
        padding-left: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    
    .validation-error i {
        font-size: 10px;
    }
</style>
</head>
<body>
    <div class="cyber-grid">
        <div class="grid-line grid-h-1"></div>
        <div class="grid-line grid-v-1"></div>
        <div class="grid-line grid-h-2"></div>
        <div class="grid-line grid-v-2"></div>
        <div class="grid-line grid-h-3"></div>
        <div class="cyber-glitch glitch-1"></div>
        <div class="cyber-glitch glitch-2"></div>
    </div>

    <div class="login-container">
        <div class="cyber-terminal">
            <div class="terminal-header">
                <div class="terminal-buttons">
                    <div class="term-btn btn-red"></div>
                    <div class="term-btn btn-yellow"></div>
                    <div class="term-btn btn-green"></div>
                </div>
                <div class="terminal-title">SYSTEM_LOGIN.exe</div>
            </div>
            
            <div class="cyber-content">
                {# Message d'erreur d'authentification Symfony #}
                {% if error %}
                    <div class="symfony-error">
                        <i class="fas fa-exclamation-triangle"></i>
                        ACCESS_DENIED: {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}
                
                {# Messages flash pour validation #}
                {% for message in app.flashes('error') %}
                    <div class="symfony-error">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ message }}
                    </div>
                {% endfor %}
                
                <div class="neon-header">
                    <div class="cyber-logo">
                        <div class="logo-frame">
                            <img src="{{ asset('images/logo.png') }}" alt="Lobby.gg Logo" class="logo-image">
                            <div class="logo-scanner"></div>
                        </div>
                        <div class="neon-glow"></div>
                    </div>
                    <h1 class="cyber-title"><span class="title-glitch">LOBBY.GG</span></h1>
                    <p class="access-text">[ Secure Platform Access ]</p>
                </div>

                {# IMPORTANT: novalidate pour désactiver validation HTML5 #}
                <form method="post" action="{{ path('app_login') }}" class="neon-form" id="loginForm" novalidate>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    
                    {# Champ Email - SANS attributs de validation HTML5 #}
                    <div class="cyber-field {% if email_error %}error{% endif %}">
                        <div class="field-frame">
                            <div class="field-border"></div>
                            {# PAS de required, pattern, maxlength, etc. #}
                            <input type="text"  {# type="text" au lieu de type="email" pour désactiver validation navigateur #}
                                   id="email" 
                                   name="_username" 
                                   value="{{ last_username }}"
                                   autocomplete="email"
                                   autofocus>
                            <label for="email">&gt; Email Address</label>
                            <div class="cyber-scanner">
                                <div class="scan-line"></div>
                            </div>
                        </div>
                        {# Affichage erreur validation Symfony #}
                        {% if email_error %}
                            <div class="validation-error">
                                <i class="fas fa-exclamation-circle"></i>
                                {{ email_error }}
                            </div>
                        {% endif %}
                    </div>

                    {# Champ Mot de passe - SANS attributs de validation HTML5 #}
                    <div class="cyber-field {% if password_error %}error{% endif %}">
                        <div class="field-frame">
                            <div class="field-border"></div>
                            {# PAS de required, minlength, etc. #}
                            <input type="password" 
                                   id="password" 
                                   name="_password" 
                                   autocomplete="current-password">
                            <label for="password">&gt; Access Code</label>
                            <button type="button" class="cyber-toggle" id="passwordToggle" aria-label="Afficher/masquer le mot de passe">
                                <div class="toggle-frame">
                                    <svg class="eye-scan" width="18" height="18" viewBox="0 0 18 18" fill="none">
                                        <path d="M9 3c-4 0-7 3-8 6 1 3 4 6 8 6s7-3 8-6c-1-3-4-6-8-6zm0 10a4 4 0 110-8 4 4 0 010 8zm0-6a2 2 0 100 4 2 2 0 000-4z" fill="currentColor"/>
                                    </svg>
                                    <svg class="eye-blocked" width="18" height="18" viewBox="0 0 18 18" fill="none" style="display:none">
                                        <path d="M3 3l12 12M7 7a3 3 0 003 3m3-3C13 7 10 4 9 4c-1 0-3 1-4 2M9 14c4 0 7-3 8-6-1-1-2-2-3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                            </button>
                            <div class="cyber-scanner">
                                <div class="scan-line"></div>
                            </div>
                        </div>
                        {# Affichage erreur validation Symfony #}
                        {% if password_error %}
                            <div class="validation-error">
                                <i class="fas fa-exclamation-circle"></i>
                                {{ password_error }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="cyber-options">
                        <label class="neon-checkbox">
                            <input type="checkbox" id="remember" name="_remember_me">
                            <span class="checkbox-matrix">
                                <div class="matrix-frame"></div>
                                <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                                    <path d="M1 4l2.5 2.5L9 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <span class="checkbox-text">Maintain Session</span>
                        </label>
                    </div>

                    <button type="submit" class="neon-button">
                        <div class="btn-matrix"></div>
                        <span class="btn-text">[ Initialize Connection ]</span>
                        <div class="btn-glow"></div>
                    </button>
                    
                    <div class="symfony-links">
                        <a href="{{ path('app_forgot_password') }}" class="symfony-link">
                            <i class="fas fa-key"></i> Recover Access
                        </a>
                        <a href="{{ path('app_register') }}" class="symfony-link">
                            <i class="fas fa-user-plus"></i> Create Profile
                        </a>
                    </div>
                </form>

                <div class="cyber-footer">
                    <div class="terminal-status">
                        <div class="status-indicator">
                            <div class="indicator-led led-green"></div>
                            <span class="status-text">System Ready</span>
                        </div>
                        <div class="system-info">
                            <span class="info-line">User: {{ last_username ?: 'Guest' }}</span>
                            <span class="info-line">Status: {% if error %}Error{% else %}Ready{% endif %}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# PAS de validation JavaScript #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle password (aide visuelle seulement, pas de validation)
            const passwordToggle = document.getElementById('passwordToggle');
            const passwordInput = document.getElementById('password');
            
            if (passwordToggle && passwordInput) {
                passwordToggle.addEventListener('click', function() {
                    const type = passwordInput.type === 'password' ? 'text' : 'password';
                    passwordInput.type = type;
                    
                    const eyeScan = this.querySelector('.eye-scan');
                    const eyeBlocked = this.querySelector('.eye-blocked');
                    
                    if (type === 'text') {
                        eyeScan.style.display = 'none';
                        eyeBlocked.style.display = 'block';
                    } else {
                        eyeScan.style.display = 'block';
                        eyeBlocked.style.display = 'none';
                    }
                });
            }
            
            // Pas de validation à la soumission - Symfony s'en occupe
            const form = document.getElementById('loginForm');
            if (form) {
                form.addEventListener('submit', function() {
                    // Juste une animation visuelle, pas de blocage
                    const submitBtn = this.querySelector('.neon-button');
                    if (submitBtn) {
                        submitBtn.querySelector('.btn-text').textContent = 'Processing...';
                    }
                });
            }
        });
    </script>
</body>
</html>