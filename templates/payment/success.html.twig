{% extends 'base.html.twig' %}

{% block title %}Paiement Réussi - Lobby.gg{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card bg-dark text-light border-success shadow-lg">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="display-4 mb-4" style="color: #00ff00; text-shadow: 0 0 10px #00ff00;">Paiement Réussi !</h1>
                    <p class="lead mb-4">Merci pour votre achat. Votre commande a été validée avec succès.</p>
                    
                    <div class="text-start mb-4 p-3 border border-secondary rounded bg-black">
                        <h5 class="text-info border-bottom border-info pb-2 mb-3">Détails de la commande</h5>
                        <ul class="list-unstyled">
                            <li><strong>ID Commande :</strong> #{{ order.id }}</li>
                            <li><strong>Produit :</strong> {{ order.product.name }}</li>
                            <li><strong>Quantité :</strong> {{ order.quantity }}</li>
                            <li><strong>Statut :</strong> <span class="badge bg-success">Payé</span></li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2 d-md-block">
                        <a href="{{ path('front_marketplace') }}" class="btn btn-outline-info btn-lg px-5">Retour au Marketplace</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #050505;
        color: #e0e0e0;
    }
    .card {
        border-width: 2px;
    }
    .btn-outline-info {
        border-color: #00d2ff;
        color: #00d2ff;
    }
    .btn-outline-info:hover {
        background-color: #00d2ff;
        color: #000;
        box-shadow: 0 0 15px #00d2ff;
    }
</style>
{% endblock %}
