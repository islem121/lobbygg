{% extends 'base.html.twig' %}

{% block title %}Paiement Annulé - Lobby.gg{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card bg-dark text-light border-danger shadow-lg">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-times-circle text-danger" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="display-4 mb-4" style="color: #ff003c; text-shadow: 0 0 10px #ff003c;">Paiement Annulé</h1>
                    <p class="lead mb-4">Le processus de paiement a été annulé. Votre commande n'a pas été finalisée.</p>
                    
                    <div class="text-start mb-4 p-3 border border-secondary rounded bg-black">
                        <h5 class="text-danger border-bottom border-danger pb-2 mb-3">Détails de la commande</h5>
                        <ul class="list-unstyled">
                            <li><strong>ID Commande :</strong> #{{ order.id }}</li>
                            <li><strong>Produit :</strong> {{ order.product.name }}</li>
                            <li><strong>Statut :</strong> <span class="badge bg-warning text-dark">En attente / Annulé</span></li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2 d-md-block">
                        <a href="{{ path('front_marketplace_cart') }}" class="btn btn-outline-danger btn-lg px-5">Retour au Panier</a>
                        <a href="{{ path('front_marketplace') }}" class="btn btn-outline-secondary btn-lg px-5">Continuer mes achats</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #050505;
        color: #e0e0e0;
    }
    .card {
        border-width: 2px;
    }
    .btn-outline-danger {
        border-color: #ff003c;
        color: #ff003c;
    }
    .btn-outline-danger:hover {
        background-color: #ff003c;
        color: #fff;
        box-shadow: 0 0 15px #ff003c;
    }
</style>
{% endblock %}
