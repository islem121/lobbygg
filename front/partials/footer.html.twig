{# Footer stats area (not the fixed action bar) #}
<footer class="lobby-footer" aria-label="Live stats"> {# Fix: avoid applying fixed bottom-bar styles to the footer #}
  <div class="footer-stats">
    <div class="stat" data-stat>
      <div class="stat-icon">
        <i class="fa-solid fa-signal"></i>
      </div>
      <div class="stat-meta">
        <div class="stat-value" data-countup data-to="18234">0</div>
        <div class="stat-label">Players online</div>
      </div>
    </div>

    <div class="stat" data-stat>
      <div class="stat-icon">
        <i class="fa-solid fa-trophy"></i>
      </div>
      <div class="stat-meta">
        <div class="stat-value" data-countup data-to="128">0</div>
        <div class="stat-label">Active tournaments</div>
      </div>
    </div>

    <div class="stat" data-stat>
      <div class="stat-icon">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
      </div>
      <div class="stat-meta">
        <div class="stat-value" data-countup data-to="540912">0</div>
        <div class="stat-label">Posts today</div>
      </div>
    </div>
  </div>
</footer>

