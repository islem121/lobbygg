{% extends 'admin/layout.html.twig' %}

{% block content_title %}Gestion des Sponsors{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_sponsoring') }}">Sponsor Management</a></li>
    <li class="breadcrumb-item active">Sponsors</li>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Liste des Offres de Sponsoring</h3>
        <div class="card-tools">
            <a href="{{ path('app_admin_sponsor_new') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Nouvelle Offre
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Société</th>
                    <th>Description</th>
                    <th>Cible</th>
                    <th>Montant</th>
                    <th>Dossier</th>
                    <th>Propriétaire</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for sponsor in sponsors %}
                <tr>
                    <td>{{ sponsor.id }}</td>
                    <td>{{ sponsor.nomSociete }}</td>
                    <td>{{ sponsor.description|length > 30 ? sponsor.description|slice(0, 30) ~ '...' : sponsor.description }}</td>
                    <td>
                        <span class="badge {{ sponsor.targetType == 'client' ? 'bg-success' : 'bg-info' }}">
                            {{ sponsor.targetType|upper }}
                        </span>
                    </td>
                    <td>{{ sponsor.amount|number_format(2, ',', ' ') }} DT</td>
                    <td>
                        {% if sponsor.dossier %}
                            <span class="badge bg-secondary">OUI</span>
                        {% else %}
                            <span class="badge bg-light text-dark">NON</span>
                        {% endif %}
                    </td>
                    <td>{{ sponsor.sponsor.username }}</td>
                    <td>{{ sponsor.createdAt ? sponsor.createdAt|date('d/m/Y H:i') : '' }}</td>
                    <td>
                        <div class="btn-group">
                            <a href="{{ path('app_admin_sponsor_show', {'id': sponsor.id}) }}" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('app_admin_sponsor_edit', {'id': sponsor.id}) }}" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('app_admin_sponsor_delete', {'id': sponsor.id}) }}" style="display:inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sponsor.id) }}">
                                <button class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="text-center text-muted">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
