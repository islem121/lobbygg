<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style>
        body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color: #111; }
        h1 { margin: 0 0 8px; font-size: 20px; }
        .meta { margin-bottom: 12px; }
        .meta span { display: inline-block; margin-right: 16px; margin-bottom: 4px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #777; padding: 6px; text-align: left; vertical-align: top; }
        th { background: #ececec; }
        .muted { color: #666; font-size: 11px; }
    </style>
</head>
<body>
    <h1>{{ title }}</h1>
    <div class="meta">
        <span><strong>Generated:</strong> {{ generatedAt|date('Y-m-d H:i') }}</span>
        <span><strong>Search:</strong> {{ filters.q ?? '-' }}</span>
        <span><strong>Status:</strong> {{ filters.status ?? '-' }}</span>
        <span><strong>Date from:</strong> {{ filters.dateFrom ?? '-' }}</span>
        <span><strong>Date to:</strong> {{ filters.dateTo ?? '-' }}</span>
        <span><strong>Sort:</strong> {{ sort.by }} ({{ sort.dir|upper }})</span>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Mode</th>
                <th>Entry Fee</th>
                <th>Prize Pool</th>
                <th>Start</th>
                <th>End</th>
                <th>Max Players</th>
                <th>Participants</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            {% set tournament = row[0] %}
            <tr>
                <td>{{ tournament.id }}</td>
                <td>{{ tournament.title }}</td>
                <td>{{ tournament.status }}</td>
                <td>{{ tournament.mode|upper }}</td>
                <td>{{ tournament.entryFee|number_format(2, '.', ',') }}</td>
                <td>{{ tournament.entryFee > 0 ? (tournament.entryFee * row.participantsCount)|number_format(2, '.', ',') : '-' }}</td>
                <td>{{ tournament.startDate ? tournament.startDate|date('Y-m-d H:i') : '-' }}</td>
                <td>{{ tournament.endDate ? tournament.endDate|date('Y-m-d') : '-' }}</td>
                <td>{{ tournament.maxPlayers }}</td>
                <td>{{ row.participantsCount }}</td>
                <td>{{ tournament.description|default('-') }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">No tournaments found.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</body>
</html>
