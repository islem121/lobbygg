{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion du Blog{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Liste des Articles</h3>
            <div class="card-tools">
                <a href="{{ path('app_admin_post_new') }}" class="btn btn-primary btn-sm">Créer un article</a>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Titre</th>
                        <th>Type</th>
                        <th>Auteur</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for post in posts %}
                    <tr>
                        <td>{{ post.id }}</td>
                        <td>
                            {% if post.image %}
                                <img src="{{ post.image starts with 'http' ? post.image : asset(post.image) }}" alt="{{ post.title }}" style="height: 40px; border-radius: 4px;">
                            {% else %}
                                <span class="badge bg-secondary">No image</span>
                            {% endif %}
                        </td>
                        <td>{{ post.title }}</td>
                        <td><span class="badge bg-info">{{ post.type|capitalize }}</span></td>
                        <td>{{ post.user.nom }} {{ post.user.prenom }}</td>
                        <td>{{ post.createdAt|date('d/m/Y H:i') }}</td>
                        <td>
                            <a href="{{ path('app_admin_post_show', {'id': post.id}) }}" class="btn btn-info btn-xs"><i class="fas fa-eye"></i></a>
                            <a href="{{ path('app_admin_post_edit', {'id': post.id}) }}" class="btn btn-primary btn-xs"><i class="fas fa-edit"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">Aucun article trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
