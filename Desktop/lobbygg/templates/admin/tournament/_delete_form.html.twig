<form method="post" action="{{ path('app_admin_tournament_delete', {'id': tournament.id}) }}" onsubmit="return confirm('Are you sure you want to delete this tournament?');" class="mt-3">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tournament.id) }}">
    <button class="btn btn-danger">Delete</button>
</form>

