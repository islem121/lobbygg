{% extends 'admin/layout.html.twig' %}

{% block content_title %}Modifier le Contrat{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_sponsoring') }}">Sponsor Management</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_contract_index') }}">Contrats</a></li>
    <li class="breadcrumb-item active">Modifier</li>
{% endblock %}

{% block content %}
    <div class="card card-warning">
        <div class="card-header">
            <h3 class="card-title">Modification du contrat ID : {{ contract.id }}</h3>
        </div>
        {{ include('admin/contract/_form.html.twig', {'button_label': 'Mettre à jour', 'back_path': path('app_admin_contract_index')}) }}
    </div>
{% endblock %}
