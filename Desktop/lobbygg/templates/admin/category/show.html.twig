{% extends 'admin/layout.html.twig' %}

{% block title %}Détails de la Catégorie{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Catégorie : {{ category.name }}</h3>
            <div class="card-tools">
                <a href="{{ path('app_admin_category_index') }}" class="btn btn-secondary btn-sm">Retour à la liste</a>
                <a href="{{ path('app_admin_category_edit', {'id': category.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th style="width: 200px;">ID</th>
                        <td>{{ category.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ category.name }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ category.description|nl2br }}</td>
                    </tr>
                </tbody>
            </table>

            <h4 class="mt-4">Produits dans cette catégorie</h4>
            <table class="table table-striped mt-2">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for product in category.products %}
                    <tr>
                        <td>{{ product.id }}</td>
                        <td>{{ product.name }}</td>
                        <td>{{ product.price }} €</td>
                        <td>
                            <a href="{{ path('app_admin_product_show', {'id': product.id}) }}" class="btn btn-info btn-xs">Voir</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted">Aucun produit dans cette catégorie.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            {{ include('admin/category/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
