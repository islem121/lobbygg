<div class="comments-header">
    <h3>Comments ({{ comments|length }})</h3>
    <button type="button" class="btn-close" onclick="closeCommentsModal()"><i class="fa-solid fa-xmark"></i></button>
</div>

<div class="comments-body">
    {% for comment in comments %}
        {% if comment.parent is null %}
            {% include 'front/modules/_comment_item.html.twig' with {'comment': comment} %}
        {% endif %}
    {% else %}
        <div class="empty-state">No comments yet. Be the first to share your thoughts!</div>
    {% endfor %}
</div>

<div class="comments-footer">
    <div class="comment-input-wrapper">
        <div class="avatar avatar-xs">{{ app.user.username[:2]|upper }}</div>
        <textarea id="new-comment-content" class="form-control" rows="1" placeholder="Write a comment..."></textarea>
        <button type="button" class="btn-send" onclick="submitComment({{ post.id }})"><i class="fa-solid fa-paper-plane"></i></button>
    </div>
</div>
