{% extends 'front/base.html.twig' %}

{% block title %}Lobby.gg - Tournaments{% endblock %}

{% block content %}
  <div
    class="tournaments-page"
    data-controller="tournaments"
    data-tournaments-endpoint-value="{{ path('front_tournaments_ajax_list') }}"
  >
  <section class="page-head">
    <div>
      <h1 class="page-title">Tournaments</h1>
      <p class="page-sub">Manage tournaments, join events, and track participants in real time.</p>
    </div>
    <div class="page-actions">
      {% if is_granted('ROLE_USER') %}
        <a class="btn btn-ghost" href="{{ path('front_tournament_vouchers') }}"><i class="fa-solid fa-ticket"></i> My Vouchers</a>
      {% endif %}
      {% if is_granted('ROLE_ADMIN') %}
        <a class="btn btn-primary" href="{{ path('front_tournaments_new') }}"><i class="fa-solid fa-plus"></i> New Tournament</a>
        <a class="btn btn-ghost" href="{{ path('front_tournaments_new', {ai: 1}) }}"><i class="fa-solid fa-wand-magic-sparkles"></i> AI Tournament</a>
      {% endif %}
    </div>
  </section>

  <section class="grid">
    <div class="col span-12">
      <div class="tour-center">
        <div class="panel tournaments-list-panel">
          <form method="get" class="tour-filters" data-tournaments-target="form" data-action="submit->tournaments#filter change->tournaments#filter">
            <div class="tour-filters-row">
              <div class="tour-field tour-field-search">
                <label>Search</label>
                <input class="form-control" type="text" name="q" placeholder="Title or description" value="{{ filters.q ?? '' }}" data-tournaments-target="searchInput">
              </div>
              <div class="tour-field">
                <label>Status</label>
                <select class="form-control" name="status">
                  <option value="">All</option>
                  {% for value in ['upcoming', 'live', 'finished', 'cancelled'] %}
                    <option value="{{ value }}" {{ (filters.status ?? '') == value ? 'selected' : '' }}>{{ value|upper }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="tour-field">
                <label>Mode</label>
                <select class="form-control" name="mode">
                  <option value="">All</option>
                  {% for value in ['solo', 'duo', 'squad'] %}
                    <option value="{{ value }}" {{ (filters.mode ?? '') == value ? 'selected' : '' }}>{{ value|upper }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="tour-field">
                <label>From</label>
                <input class="form-control" type="date" name="date_from" value="{{ filters.dateFrom ?? '' }}">
              </div>
              <div class="tour-field">
                <label>To</label>
                <input class="form-control" type="date" name="date_to" value="{{ filters.dateTo ?? '' }}">
              </div>
            </div>
            <div class="tour-filters-row">
              <div class="tour-field">
                <label>Sort</label>
                <select class="form-control" name="sort_by">
                  <option value="startDate" {{ sort.by == 'startDate' ? 'selected' : '' }}>Start</option>
                  <option value="endDate" {{ sort.by == 'endDate' ? 'selected' : '' }}>End</option>
                  <option value="title" {{ sort.by == 'title' ? 'selected' : '' }}>Title</option>
                  <option value="status" {{ sort.by == 'status' ? 'selected' : '' }}>Status</option>
                  <option value="maxPlayers" {{ sort.by == 'maxPlayers' ? 'selected' : '' }}>Slots</option>
                  <option value="participantsCount" {{ sort.by == 'participantsCount' ? 'selected' : '' }}>Participants</option>
                </select>
              </div>
              <div class="tour-field">
                <label>Direction</label>
                <select class="form-control" name="sort_dir">
                  <option value="asc" {{ sort.dir == 'asc' ? 'selected' : '' }}>ASC</option>
                  <option value="desc" {{ sort.dir == 'desc' ? 'selected' : '' }}>DESC</option>
                </select>
              </div>
              <div class="tour-filter-actions">
                <button class="btn btn-primary" type="submit"><i class="fa-solid fa-filter"></i> Apply</button>
                <a class="btn btn-ghost" href="{{ path('front_tournaments') }}">Reset</a>
                <a class="btn btn-ghost" href="{{ path('front_tournaments_export_pdf', app.request.query.all) }}"><i class="fa-solid fa-file-pdf"></i> PDF</a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="grid">
    <div class="col span-12">
      <div class="tour-center">
        <div class="panel">
          <div class="panel-head">
            <h2 class="panel-title"><i class="fa-solid fa-trophy"></i> All Tournaments</h2>
          </div>
          <div data-tournaments-target="results">
            {% include 'front/modules/_tournaments_results.html.twig' with { tournaments: tournaments } %}
          </div>

          <div class="tour-pagination" data-tournaments-target="pagination">
            {% if pagination.totalPages > 1 %}
              {% set prevPage = pagination.page - 1 %}
              {% set nextPage = pagination.page + 1 %}
              {% if pagination.page > 1 %}
                <a class="btn btn-mini btn-ghost" href="{{ path('front_tournaments', app.request.query.all|merge({page: prevPage})) }}" data-action="click->tournaments#paginate">&larr; Prev</a>
              {% endif %}
              <span class="tour-page-info">Page {{ pagination.page }} / {{ pagination.totalPages }}</span>
              {% if pagination.page < pagination.totalPages %}
                <a class="btn btn-mini btn-ghost" href="{{ path('front_tournaments', app.request.query.all|merge({page: nextPage})) }}" data-action="click->tournaments#paginate">Next &rarr;</a>
              {% endif %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="grid">
    <div class="col span-12">
      <div class="tour-center">
        <div class="panel">
          <div class="panel-head">
            <h2 class="panel-title"><i class="fa-solid fa-earth-africa"></i> External Tournaments &#127757;</h2>
          </div>
          <p id="external-events-notice" style="margin: 0 0 12px; color: rgba(255,255,255,.7);"></p>
          <div id="external-tournaments" class="external-tournaments-grid">
            <p>No external tournaments available.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {% include 'front/partials/_tournament_chatbot.html.twig' with { chatbot_tournament_id: null } %}
  </div>

<style>
  .tournaments-page .tour-center { width: 100%; max-width: none; margin: 0 auto; padding: 0 20px; }
  .tournaments-page .tour-filters { display: grid; gap: 12px; }
  .tournaments-page .tour-filters-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
  .tournaments-page .tour-field { min-width: 150px; flex: 1 1 180px; }
  .tournaments-page .tour-field-search { flex: 2 1 320px; }
  .tournaments-page .tour-filter-actions { display: flex; gap: 8px; margin-left: auto; }

  .tournaments-page .tour-grid-wrap { width: 100%; overflow: visible; }
  .tournaments-page .tournament-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    min-width: 0;
    margin: 20px 0;
  }

  .tournaments-page .tournament-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    aspect-ratio: 1 / 1;
    min-height: 0;
    padding: 16px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    background: linear-gradient(165deg, rgba(30,30,52,.96), rgba(20,20,35,.95));
    box-sizing: border-box;
    position: relative;
    overflow: hidden !important;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .tournaments-page .tg-hover:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,.7);
    box-shadow: 0 12px 30px -14px rgba(139,92,246,.9);
  }
  .tournaments-page .tour-accent {
    position: absolute;
    left: 0; top: 0; width: 100%; height: 3px;
    background: linear-gradient(90deg,#00d1ff,#8b5cf6,#ff4dd2);
  }

  .tournaments-page .tour-top {
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    gap: 8px;
    align-items: start;
    margin-bottom: 8px;
  }
  .tournaments-page .tour-name {
    margin: 0;
    font-size: .98rem;
    line-height: 1.25;
    font-weight: 700;
    min-width: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .tournaments-page .tg-pill {
    padding: 4px 8px;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .tournaments-page .tg-pill-upcoming { background:#3b82f6; color:#fff; }
  .tournaments-page .tg-pill-live { background:#ef4444; color:#fff; }
  .tournaments-page .tg-pill-finished { background:#6b7280; color:#fff; }
  .tournaments-page .tg-pill-cancelled { background:#9ca3af; color:#fff; }

  .tournaments-page .tour-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 8px;
    padding: 10px;
    margin-bottom: 12px;
    border-radius: 9px;
    background: rgba(0,0,0,.18);
  }
  .tournaments-page .tour-meta-item { display:flex; align-items:center; gap:6px; min-width:0; font-size:.82rem; }
  .tournaments-page .tour-meta-item i { width: 14px; flex: 0 0 14px; color:#8b5cf6; }
  .tournaments-page .tour-meta-item span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tournaments-page .tour-description {
    margin: 0 0 12px;
    font-size: .82rem;
    line-height: 1.3;
    color: rgba(255,255,255,.74);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .tournaments-page .tour-footer {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,.1);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tournaments-page .tour-countdown {
    font-size: .74rem;
    font-weight: 600;
    color: #fbbf24;
    background: rgba(251,191,36,.12);
    padding: 4px 8px;
    border-radius: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    flex: 1 1 auto;
  }
  .tournaments-page .tour-actions { display: flex; gap: 6px; flex: 0 0 auto; }
  .tournaments-page .tour-actions .btn-mini { width: 32px; height: 32px; padding: 0; display:flex; align-items:center; justify-content:center; border-radius: 6px; }
  .tournaments-page .tour-actions .btn-facebook-share {
    height: 32px;
    padding: 0 10px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: .72rem;
    white-space: nowrap;
  }
  .tournaments-page .inline-form { display: inline; }

  .tournaments-page .tour-pagination { display:flex; justify-content:center; align-items:center; gap:16px; margin-top: 24px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.1); }
  .tournaments-page .tour-page-info { font-size: .9rem; color: rgba(255,255,255,.65); }
  .tournaments-page .external-tournaments-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .tournaments-page .external-card {
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.12);
    background: linear-gradient(165deg, rgba(26,26,44,.95), rgba(19,19,31,.94));
    padding: 14px;
    display: grid;
    gap: 10px;
  }
  .tournaments-page .external-card-title {
    margin: 0;
    font-size: .98rem;
    line-height: 1.3;
  }
  .tournaments-page .external-meta {
    display: grid;
    gap: 4px;
    font-size: .84rem;
    color: rgba(255,255,255,.76);
  }
  .tournaments-page .external-actions {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  /* Remove the big wrapper-card look around tournament cards */
  .tournaments-page .tournaments-list-panel {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  @media (max-width: 768px) {
    .tournaments-page .tournament-grid { grid-template-columns: 1fr; gap: 16px; }
    .tournaments-page .tour-center { padding: 0 12px; }
    .tournaments-page .tour-filters-row { flex-direction: column; align-items: stretch; }
    .tournaments-page .tour-field { max-width: 100%; }
    .tournaments-page .tour-filter-actions { margin-left: 0; }
    .tournaments-page .external-tournaments-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 1100px) {
    .tournaments-page .external-tournaments-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .tournaments-page,
.tournaments-page .content-wrapper,
.tournaments-page .container,
.tournaments-page .container-fluid {
  max-width: 100% !important;
  width: 100% !important;
}

/* Remove bootstrap container limitation */
.tournaments-page .container {
  padding-left: 0 !important;
  padding-right: 0 !important;
}

/* Make grid truly full width */
.tournaments-page .tournament-grid {
  grid-template-columns: repeat(3, minmax(320px, 1fr)) !important;
  width: 100%;}
  
</style>

<script>
  (function() {
    function updateCountdowns() {
      document.querySelectorAll('.tour-countdown').forEach(function(el) {
        const startDate = el.dataset.start;
        if (!startDate) return;
        const start = new Date(startDate).getTime();
        const now = Date.now();
        const diff = start - now;
        if (diff <= 0) {
          el.textContent = 'LIVE NOW';
          el.style.color = '#ef4444';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        if (days > 0) {
          el.textContent = `Starts in ${days}d ${hours}h`;
        } else {
          const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          el.textContent = `Starts in ${hours}h ${minutes}m`;
        }
      });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 60000);
  })();

  (function () {
    const popupFeatures = 'width=600,height=400,menubar=no,toolbar=no,status=no,scrollbars=yes,resizable=yes';
    const showShareHint = function () {
      let hint = document.getElementById('facebook-share-hint');
      if (!hint) {
        hint = document.createElement('div');
        hint.id = 'facebook-share-hint';
        hint.style.position = 'fixed';
        hint.style.right = '16px';
        hint.style.bottom = '16px';
        hint.style.zIndex = '9999';
        hint.style.padding = '10px 12px';
        hint.style.borderRadius = '8px';
        hint.style.background = 'rgba(20,20,35,.95)';
        hint.style.border = '1px solid rgba(255,255,255,.18)';
        hint.style.color = '#fff';
        hint.style.fontSize = '13px';
        hint.style.boxShadow = '0 10px 30px rgba(0,0,0,.25)';
        document.body.appendChild(hint);
      }
      hint.textContent = 'Text copied. Press Ctrl+V in Facebook.';
      hint.style.display = 'block';
      clearTimeout(window.__fbShareHintTimer);
      window.__fbShareHintTimer = setTimeout(function () {
        hint.style.display = 'none';
      }, 3200);
    };

    const copyText = async function (text) {
      if (!text) return;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }
      } catch (e) {}

      const fallback = document.createElement('textarea');
      fallback.value = text;
      fallback.setAttribute('readonly', '');
      fallback.style.position = 'absolute';
      fallback.style.left = '-9999px';
      document.body.appendChild(fallback);
      fallback.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(fallback);
    };

    document.addEventListener('click', function (event) {
      const trigger = event.target.closest('[data-facebook-share]');
      if (!trigger) {
        return;
      }

      event.preventDefault();

      const shareUrl = trigger.getAttribute('data-share-url') || '';
      const shareQuote = trigger.getAttribute('data-share-quote') || '';
      const shareTarget = trigger.getAttribute('data-share-target') || '';
      copyText(shareQuote);
      showShareHint();
      if (shareTarget) {
        const popup = window.open(shareTarget, 'facebook-share', popupFeatures);
        if (popup && typeof popup.focus === 'function') {
          popup.focus();
        }
        return;
      }

      if (!shareUrl) {
        return;
      }

      const facebookUrl = 'https://www.facebook.com/sharer/sharer.php?u='
        + encodeURIComponent(shareUrl)
        + '&quote='
        + encodeURIComponent(shareQuote);

      const popup = window.open(facebookUrl, 'facebook-share', popupFeatures);
      if (popup && typeof popup.focus === 'function') {
        popup.focus();
      }
    });
  })();

  (function () {
    const grid = document.getElementById('external-tournaments');
    const notice = document.getElementById('external-events-notice');
    if (!grid || !notice) return;

    const escapeHtml = function (value) {
      const map = {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'};
      return String(value || '').replace(/[&<>"']/g, function (ch) { return map[ch]; });
    };

    const setNotice = function (message, isError) {
      notice.textContent = message || '';
      notice.style.color = isError ? '#ff6b81' : 'rgba(255,255,255,.7)';
    };

    const bindFavoriteButtons = function () {
      grid.querySelectorAll('[data-external-favorite]').forEach(function (button) {
        button.addEventListener('click', async function () {
          const title = button.getAttribute('data-title') || 'Tournament';
          alert(`Added to favorites: ${title}`);
        });
      });
    };

    // Render scraped events from /api/external-tournaments into discovery cards.
    const renderExternalTournaments = function (events) {
      if (!Array.isArray(events) || events.length === 0) {
        grid.innerHTML = '<p>No external tournaments available.</p>';
        return;
      }

      grid.innerHTML = events.map(function (event) {
        return `
          <article class="external-card">
            <h3 class="external-card-title">${escapeHtml(event.title)}</h3>
            <div class="external-meta">
              <div><strong>Game:</strong> ${escapeHtml(event.game || 'N/A')}</div>
              <div><strong>Date:</strong> ${escapeHtml(event.date || event.startDate || 'TBA')}</div>
              <div><strong>Prize Pool:</strong> ${escapeHtml(event.prizePool || 'N/A')}</div>
              <div><strong>Platform:</strong> ${escapeHtml(event.platform || event.source || 'Unknown')}</div>
            </div>
            <div class="external-actions">
              <a class="btn btn-mini btn-ghost" target="_blank" rel="noopener noreferrer" href="${escapeHtml(event.url)}">View Tournament</a>
              <button class="btn btn-mini btn-primary" type="button" data-external-favorite data-title="${escapeHtml(event.title)}">Add to favorites</button>
            </div>
          </article>
        `;
      }).join('');

      bindFavoriteButtons();
    };

    // Frontend load flow for scraped tournaments API.
    const loadExternalEvents = async function () {
      try {
        const response = await fetch('{{ path('api_external_tournaments') }}', {
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await response.json();
        const events = Array.isArray(data) ? data : [];
        setNotice(events.length > 0 ? 'Loaded external tournaments.' : '', false);
        renderExternalTournaments(events);
      } catch (e) {
        grid.innerHTML = '<p>No external tournaments available.</p>';
        setNotice('Could not load external tournaments right now.', true);
      }
    };

    loadExternalEvents();
  })();
</script>
{% endblock %}


