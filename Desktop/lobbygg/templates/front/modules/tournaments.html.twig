{% extends 'front/base.html.twig' %}

{% block title %}Lobby.gg - Tournaments{% endblock %}

{% block content %}
  <section class="page-head">
    <div>
      <h1 class="page-title">Tournaments</h1>
      <p class="page-sub">Manage tournaments, join events, and track participants in real time.</p>
    </div>
    <div class="page-actions">
      {% if is_granted('ROLE_ADMIN') %}
        <a class="btn btn-primary" href="{{ path('front_tournaments_new') }}">
          <i class="fa-solid fa-plus"></i> New Tournament
        </a>
      {% endif %}
    </div>
  </section>

  <section class="grid">
    <div class="col span-12">
      <div class="panel">
        <form method="get" style="display:grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap:10px; align-items:end;">
          <div style="grid-column: span 2;">
            <label>Search</label>
            <input class="form-control" type="text" name="q" placeholder="Title or description" value="{{ filters.q ?? '' }}">
          </div>
          <div>
            <label>Status</label>
            <select class="form-control" name="status">
              <option value="">All</option>
              {% for value in ['upcoming', 'live', 'finished', 'cancelled'] %}
                <option value="{{ value }}" {{ (filters.status ?? '') == value ? 'selected' : '' }}>{{ value|upper }}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <label>From</label>
            <input class="form-control" type="date" name="date_from" value="{{ filters.dateFrom ?? '' }}">
          </div>
          <div>
            <label>To</label>
            <input class="form-control" type="date" name="date_to" value="{{ filters.dateTo ?? '' }}">
          </div>
          <div>
            <label>Sort</label>
            <select class="form-control" name="sort_by">
              <option value="startDate" {{ sort.by == 'startDate' ? 'selected' : '' }}>Start</option>
              <option value="endDate" {{ sort.by == 'endDate' ? 'selected' : '' }}>End</option>
              <option value="title" {{ sort.by == 'title' ? 'selected' : '' }}>Title</option>
              <option value="status" {{ sort.by == 'status' ? 'selected' : '' }}>Status</option>
              <option value="maxPlayers" {{ sort.by == 'maxPlayers' ? 'selected' : '' }}>Slots</option>
              <option value="participantsCount" {{ sort.by == 'participantsCount' ? 'selected' : '' }}>Participants</option>
            </select>
          </div>
          <div>
            <label>Dir</label>
            <select class="form-control" name="sort_dir">
              <option value="asc" {{ sort.dir == 'asc' ? 'selected' : '' }}>ASC</option>
              <option value="desc" {{ sort.dir == 'desc' ? 'selected' : '' }}>DESC</option>
            </select>
          </div>
          <div style="display:flex; gap:8px;">
            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-filter"></i> Apply</button>
            <a class="btn btn-ghost" href="{{ path('front_tournaments') }}">Reset</a>
            <a class="btn btn-ghost" href="{{ path('front_tournaments_export_pdf', app.request.query.all) }}"><i class="fa-solid fa-file-pdf"></i> PDF</a>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="grid">
    <div class="col span-12">
      <div class="panel">
        <div class="panel-head">
          <h2 class="panel-title"><i class="fa-solid fa-trophy"></i> All Tournaments</h2>
        </div>

        {% if tournaments is empty %}
          <p>No tournaments found.</p>
        {% else %}
          <div class="tour-grid">
            {% for row in tournaments %}
              {% set t = row.entity %}
              <div class="card tour-card big">
                <div class="tour-top">
                  <div class="tour-name">{{ t.title }}</div>
                  <div class="pill">{{ t.status|upper }}</div>
                </div>
                <div class="tour-meta">
                  <span><i class="fa-solid fa-users"></i> {{ row.participantsCount }} / {{ t.maxPlayers }}</span>
                  <span><i class="fa-solid fa-calendar"></i> {{ t.startDate ? t.startDate|date('Y-m-d H:i') : 'N/A' }}</span>
                  <span><i class="fa-solid fa-clock"></i> {{ t.endDate ? t.endDate|date('Y-m-d H:i') : 'N/A' }}</span>
                </div>
                <p style="margin-top:8px;">{{ t.description|default('No description') }}</p>

                <div class="row-actions">
                  <a class="btn btn-mini btn-ghost" href="{{ path('front_tournaments_show', {id: t.id}) }}">
                    <i class="fa-solid fa-eye"></i> View
                  </a>

                  {% if is_granted('ROLE_USER') %}
                    {% if row.isJoined %}
                      <form method="post" action="{{ path('front_tournaments_leave', {id: t.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('leave_tournament_' ~ t.id) }}">
                        <button class="btn btn-mini btn-ghost" type="submit">
                          <i class="fa-solid fa-right-from-bracket"></i> Leave
                        </button>
                      </form>
                    {% else %}
                      <form method="post" action="{{ path('front_tournaments_join', {id: t.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('join_tournament_' ~ t.id) }}">
                        <button class="btn btn-mini btn-primary" type="submit">
                          <i class="fa-solid fa-bolt"></i> Join
                        </button>
                      </form>
                    {% endif %}
                  {% endif %}

                  {% if is_granted('ROLE_ADMIN') %}
                    <a class="btn btn-mini btn-ghost" href="{{ path('front_tournaments_edit', {id: t.id}) }}">
                      <i class="fa-solid fa-pen"></i> Edit
                    </a>
                    <form method="post" action="{{ path('front_tournaments_delete', {id: t.id}) }}" onsubmit="return confirm('Delete tournament?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete_tournament_' ~ t.id) }}">
                      <button class="btn btn-mini btn-ghost" type="submit">
                        <i class="fa-solid fa-trash"></i> Delete
                      </button>
                    </form>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endblock %}

