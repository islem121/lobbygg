{% extends 'front/base.html.twig' %}

{% block title %}Lobby.gg - Tournaments{% endblock %}

{% block content %}
  <section class="page-head">
    <div>
      <h1 class="page-title">Tournaments</h1>
      <p class="page-sub">Manage tournaments, join events, and track participants in real time.</p>
    </div>
    <div class="page-actions">
      {% if is_granted('ROLE_ADMIN') %}
        <a class="btn btn-primary" href="{{ path('front_tournaments_new') }}"><i class="fa-solid fa-plus"></i> New Tournament</a>
        <a class="btn btn-ghost" href="{{ path('front_tournaments_new', {ai: 1}) }}"><i class="fa-solid fa-wand-magic-sparkles"></i> AI Tournament</a>
      {% endif %}
    </div>
  </section>

  <section class="grid">
    <div class="col span-12">
      <div class="tour-center">
        <div class="panel">
          <form method="get" class="tour-filters">
            <div class="tour-filters-row">
              <div class="tour-field tour-field-search">
                <label>Search</label>
                <input class="form-control" type="text" name="q" placeholder="Title or description" value="{{ filters.q ?? '' }}">
              </div>
              <div class="tour-field">
                <label>Status</label>
                <select class="form-control" name="status">
                  <option value="">All</option>
                  {% for value in ['upcoming', 'live', 'finished', 'cancelled'] %}
                    <option value="{{ value }}" {{ (filters.status ?? '') == value ? 'selected' : '' }}>{{ value|upper }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="tour-field">
                <label>Mode</label>
                <select class="form-control" name="mode">
                  <option value="">All</option>
                  {% for value in ['solo', 'duo', 'squad'] %}
                    <option value="{{ value }}" {{ (filters.mode ?? '') == value ? 'selected' : '' }}>{{ value|upper }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="tour-field">
                <label>From</label>
                <input class="form-control" type="date" name="date_from" value="{{ filters.dateFrom ?? '' }}">
              </div>
              <div class="tour-field">
                <label>To</label>
                <input class="form-control" type="date" name="date_to" value="{{ filters.dateTo ?? '' }}">
              </div>
            </div>
            <div class="tour-filters-row">
              <div class="tour-field">
                <label>Sort</label>
                <select class="form-control" name="sort_by">
                  <option value="startDate" {{ sort.by == 'startDate' ? 'selected' : '' }}>Start</option>
                  <option value="endDate" {{ sort.by == 'endDate' ? 'selected' : '' }}>End</option>
                  <option value="title" {{ sort.by == 'title' ? 'selected' : '' }}>Title</option>
                  <option value="status" {{ sort.by == 'status' ? 'selected' : '' }}>Status</option>
                  <option value="maxPlayers" {{ sort.by == 'maxPlayers' ? 'selected' : '' }}>Slots</option>
                  <option value="participantsCount" {{ sort.by == 'participantsCount' ? 'selected' : '' }}>Participants</option>
                </select>
              </div>
              <div class="tour-field">
                <label>Direction</label>
                <select class="form-control" name="sort_dir">
                  <option value="asc" {{ sort.dir == 'asc' ? 'selected' : '' }}>ASC</option>
                  <option value="desc" {{ sort.dir == 'desc' ? 'selected' : '' }}>DESC</option>
                </select>
              </div>
              <div class="tour-filter-actions">
                <button class="btn btn-primary" type="submit"><i class="fa-solid fa-filter"></i> Apply</button>
                <a class="btn btn-ghost" href="{{ path('front_tournaments') }}">Reset</a>
                <a class="btn btn-ghost" href="{{ path('front_tournaments_export_pdf', app.request.query.all) }}"><i class="fa-solid fa-file-pdf"></i> PDF</a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="grid">
    <div class="col span-12">
      <div class="tour-center">
        <div class="panel">
          <div class="panel-head">
            <h2 class="panel-title"><i class="fa-solid fa-trophy"></i> All Tournaments</h2>
          </div>
          {% if tournaments is empty %}
            <p>No tournaments found.</p>
          {% else %}
            <div class="tg-grid-wrap">
              <div class="tournament-grid">
                {% for row in tournaments %}
                  {% set t = row.entity %}
                  {% set desc = t.description|default('No description') %}
                  <article class="card tour-card tg-card-hover tournament-card">
                    <div class="tg-accent"></div>
                    <div class="tg-top">
                      <h3 class="tg-name" title="{{ t.title }}">{{ t.title }}</h3>
                      <div class="pill pill-{{ t.status }}">{{ t.status|upper }}</div>
                    </div>

                    <div class="tg-meta">
                      <div class="tg-meta-item"><i class="fa-solid fa-gamepad"></i><span>{{ t.mode|upper }}</span></div>
                      <div class="tg-meta-item"><i class="fa-solid fa-users"></i><span>{{ row.participantsCount }}/{{ t.maxPlayers }}</span></div>
                      <div class="tg-meta-item"><i class="fa-solid fa-coins"></i><span>{{ t.entryFee > 0 ? t.entryFee ~ ' DT' : 'FREE' }}</span></div>
                      <div class="tg-meta-item"><i class="fa-solid fa-calendar"></i><span>{{ t.startDate ? t.startDate|date('d/m H:i') : 'N/A' }}</span></div>
                    </div>

                    <p class="tg-description">{{ desc|length > 120 ? desc|slice(0, 117) ~ '...' : desc }}</p>

                    <div class="tg-footer">
                      <div class="tg-countdown" data-start="{{ t.startDate ? t.startDate|date('c') : '' }}"></div>
                      <div class="tg-actions">
                        <a class="btn btn-mini btn-ghost" href="{{ path('front_tournaments_show', {id: t.id}) }}" title="View"><i class="fa-solid fa-eye"></i></a>
                        {% if is_granted('ROLE_USER') %}
                          {% if row.isJoined %}
                            <form method="post" action="{{ path('front_tournaments_leave', {id: t.id}) }}" class="inline-form">
                              <input type="hidden" name="_token" value="{{ csrf_token('leave_tournament_' ~ t.id) }}">
                              <button class="btn btn-mini btn-ghost" type="submit" title="Leave"><i class="fa-solid fa-right-from-bracket"></i></button>
                            </form>
                          {% else %}
                            <form method="post" action="{{ path('front_tournaments_join', {id: t.id}) }}" class="inline-form">
                              <input type="hidden" name="_token" value="{{ csrf_token('join_tournament_' ~ t.id) }}">
                              <button class="btn btn-mini btn-primary" type="submit" title="Join"><i class="fa-solid fa-bolt"></i></button>
                            </form>
                          {% endif %}
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                          <a class="btn btn-mini btn-ghost" href="{{ path('front_tournaments_edit', {id: t.id}) }}" title="Edit"><i class="fa-solid fa-pen"></i></a>
                          <form method="post" action="{{ path('front_tournaments_delete', {id: t.id}) }}" class="inline-form" onsubmit="return confirm('Delete tournament?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_tournament_' ~ t.id) }}">
                            <button class="btn btn-mini btn-ghost" type="submit" title="Delete"><i class="fa-solid fa-trash"></i></button>
                          </form>
                        {% endif %}
                      </div>
                    </div>
                  </article>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {% if pagination.totalPages > 1 %}
            <div class="tg-pagination">
              {% set prevPage = pagination.page - 1 %}
              {% set nextPage = pagination.page + 1 %}
              {% if pagination.page > 1 %}
                <a class="btn btn-mini btn-ghost" href="{{ path('front_tournaments', app.request.query.all|merge({page: prevPage})) }}">&larr; Prev</a>
              {% endif %}
              <span class="tg-page-info">Page {{ pagination.page }} / {{ pagination.totalPages }}</span>
              {% if pagination.page < pagination.totalPages %}
                <a class="btn btn-mini btn-ghost" href="{{ path('front_tournaments', app.request.query.all|merge({page: nextPage})) }}">Next &rarr;</a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% include 'front/partials/_tournament_chatbot.html.twig' with { chatbot_tournament_id: null } %}

<style>
  .tour-center { width: 100%; max-width: 1440px; margin: 0 auto; padding: 0 20px; }
  .tour-filters { display: grid; gap: 12px; }
  .tour-filters-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; justify-content: flex-start; }
  .tour-field { min-width: 150px; flex: 1 1 180px; }
  .tour-field-search { flex: 2 1 320px; }
  .tour-filter-actions { display: flex; gap: 8px; margin-left: auto; }

  .tg-grid-wrap { width: 100%; display: flex; justify-content: center; }
  .tournament-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
    margin: 20px auto;
    width: min(100%, 1360px);
    overflow: visible;
  }
  .tournament-grid > * { min-width: 0; }

  .tournament-card {
    background: linear-gradient(165deg, rgba(30, 30, 52, 0.96), rgba(20, 20, 35, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    min-height: 0;
    width: 100%;
    backdrop-filter: blur(10px);
    box-sizing: border-box;
    align-self: start;
    position: relative;
    overflow: visible;
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }
  .tg-accent {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #00d1ff, #8b5cf6, #ff4dd2);
  }
  .tg-card-hover:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 92, 246, .72);
    box-shadow: 0 14px 34px -14px rgba(139, 92, 246, .9);
  }

  .tg-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 10px;
    margin: 2px 0 12px;
  }
  .tg-name {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
    min-width: 0;
    word-break: break-word;
    display: block;
  }

  .tournament-card .pill {
    position: relative !important;
    top: auto !important;
    right: auto !important;
    left: auto !important;
    bottom: auto !important;
    padding: 4px 8px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
    min-width: auto;
    height: auto;
    flex-shrink: 0;
    z-index: 2;
  }
  .pill-upcoming { background: #3b82f6; color: white; }
  .pill-live { background: #ef4444; color: white; animation: pulse 2s infinite; }
  .pill-finished { background: #6b7280; color: white; }
  .pill-cancelled { background: #9ca3af; color: white; }
  @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.7; } 100% { opacity: 1; } }

  .tg-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
    margin-bottom: 12px;
    background: rgba(0, 0, 0, 0.18);
    padding: 10px;
    border-radius: 9px;
  }
  .tg-meta-item { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; min-width: 0; }
  .tg-meta-item i { width: 16px; color: #8b5cf6; flex: 0 0 16px; }
  .tg-meta-item span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .tg-description {
    font-size: 0.86rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.74);
    margin-bottom: 12px;
    display: block;
    overflow-wrap: anywhere;
  }

  .tg-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .tg-countdown {
    font-size: 0.75rem;
    font-weight: 600;
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    padding: 4px 8px;
    border-radius: 4px;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tg-actions { display: flex; gap: 6px; margin-left: auto; }
  .tg-actions .btn-mini { width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 6px; }
  .inline-form { display: inline; }

  .tg-pagination { display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .tg-page-info { font-size: 0.9rem; color: rgba(255, 255, 255, 0.6); }

  @media (max-width: 980px) {
    .tournament-grid { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (max-width: 768px) {
    .tour-center { padding: 0 12px; }
    .tour-filters-row { flex-direction: column; align-items: stretch; }
    .tour-field { max-width: 100%; }
    .tour-filter-actions { margin-left: 0; }
    .tg-meta { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) { .tournament-grid { gap: 12px; } }
</style>

<script>
  (function() {
    function updateCountdowns() {
      document.querySelectorAll('.tg-countdown').forEach(function(el) {
        const startDate = el.dataset.start;
        if (!startDate) return;
        const start = new Date(startDate).getTime();
        const now = Date.now();
        const diff = start - now;
        if (diff <= 0) {
          el.textContent = 'LIVE NOW';
          el.style.color = '#ef4444';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        if (days > 0) {
          el.textContent = `Starts in ${days}d ${hours}h`;
        } else {
          const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          el.textContent = `Starts in ${hours}h ${minutes}m`;
        }
      });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 60000);
  })();
</script>
{% endblock %}
