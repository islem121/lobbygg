<div class="floating-tchat" data-tchat-root data-tournament-id="{{ chatbot_tournament_id is defined and chatbot_tournament_id ? chatbot_tournament_id : '' }}">
  <button class="floating-tchat-toggle" type="button" data-tchat-toggle aria-label="Open tournament chatbot">
    <i class="fa-solid fa-robot"></i>
  </button>

  <div class="floating-tchat-panel" data-tchat-panel hidden>
    <div class="floating-tchat-head">
      <strong><i class="fa-solid fa-robot"></i> Tournament AI</strong>
      <button type="button" data-tchat-close aria-label="Close chatbot">✕</button>
    </div>

    <div class="floating-tchat-history" data-tchat-history>
      <div class="tchat-msg tchat-msg-ai">Ask anything about tournaments.</div>
    </div>

    <div class="floating-tchat-input">
      <input type="text" class="form-control" data-tchat-input placeholder="Type your question..." />
      <button class="btn btn-primary" type="button" data-tchat-send>Send</button>
    </div>

    <div class="tchat-status" data-tchat-status></div>
  </div>
</div>

<style>
  .floating-tchat {
    position: fixed;
    right: 20px;
    bottom: calc(92px + env(safe-area-inset-bottom));
    z-index: 2200;
  }
  .floating-tchat-toggle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(99, 102, 241, .35);
    transition: transform .2s ease;
  }
  .floating-tchat-toggle:hover { transform: scale(1.08); }
  .floating-tchat-panel {
    width: min(360px, calc(100vw - 24px));
    margin-top: 10px;
    background: rgba(15, 18, 30, .95);
    border: 1px solid rgba(139, 92, 246, .4);
    border-radius: 12px;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }
  .floating-tchat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(139, 92, 246, .25);
  }
  .floating-tchat-head button {
    border: none;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .floating-tchat-history {
    height: 220px;
    overflow-y: auto;
    padding: 10px;
    display: grid;
    gap: 8px;
    background: rgba(0, 0, 0, .2);
  }
  .tchat-msg {
    padding: 8px 10px;
    border-radius: 8px;
    font-size: .9rem;
    line-height: 1.35;
  }
  .tchat-msg-user { background: rgba(99, 102, 241, .25); justify-self: end; max-width: 90%; }
  .tchat-msg-ai { background: rgba(255, 255, 255, .08); justify-self: start; max-width: 90%; }
  .tchat-msg-error { background: rgba(239, 68, 68, .2); justify-self: start; max-width: 90%; }
  .floating-tchat-input {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    padding: 10px;
  }
  .tchat-status {
    min-height: 22px;
    padding: 0 10px 10px;
    font-size: .82rem;
    color: rgba(255,255,255,.7);
  }
  @media (max-width: 480px) {
    .floating-tchat { right: 12px; bottom: calc(86px + env(safe-area-inset-bottom)); }
  }
</style>

<script>
  (function () {
    const root = document.querySelector('[data-tchat-root]');
    if (!root) return;

    const panel = root.querySelector('[data-tchat-panel]');
    const toggle = root.querySelector('[data-tchat-toggle]');
    const closeBtn = root.querySelector('[data-tchat-close]');
    const history = root.querySelector('[data-tchat-history]');
    const input = root.querySelector('[data-tchat-input]');
    const send = root.querySelector('[data-tchat-send]');
    const status = root.querySelector('[data-tchat-status]');
    const tournamentId = root.getAttribute('data-tournament-id');

    const appendMessage = (text, cls) => {
      const div = document.createElement('div');
      div.className = 'tchat-msg ' + cls;
      div.textContent = text;
      history.appendChild(div);
      history.scrollTop = history.scrollHeight;
    };

    const ask = async () => {
      const question = (input.value || '').trim();
      if (!question) {
        status.textContent = 'Please enter a question.';
        return;
      }

      appendMessage(question, 'tchat-msg-user');
      input.value = '';
      status.textContent = 'Thinking...';

      try {
        const payload = { question };
        if (tournamentId) payload.tournamentId = parseInt(tournamentId, 10);

        const res = await fetch('/api/chatbot/tournament', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (!data.success) {
          appendMessage(data.answer || data.error || 'Request rejected.', 'tchat-msg-error');
        } else {
          appendMessage(data.answer || 'No answer.', 'tchat-msg-ai');
        }
        status.textContent = '';
      } catch (e) {
        appendMessage('Network error while contacting chatbot.', 'tchat-msg-error');
        status.textContent = '';
      }
    };

    toggle.addEventListener('click', () => { panel.hidden = !panel.hidden; });
    closeBtn.addEventListener('click', () => { panel.hidden = true; });
    send.addEventListener('click', ask);
    input.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') {
        ev.preventDefault();
        ask();
      }
    });
  })();
</script>
