{% extends 'admin/layout.html.twig' %}

{% block content_title %}Détails de la Demande{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_sponsoring') }}">Sponsor Management</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_document_index') }}">Documents</a></li>
    <li class="breadcrumb-item active">Détails</li>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Informations sur la demande</h3>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th>ID</th>
                        <td>{{ document.id }}</td>
                    </tr>
                    <tr>
                        <th>Client</th>
                        <td>{{ document.client.username }}</td>
                    </tr>
                    <tr>
                        <th>Offre Sponsor</th>
                        <td>{{ document.offer.nomSociete }}</td>
                    </tr>
                    <tr>
                        <th>Message</th>
                        <td>{{ document.message }}</td>
                    </tr>
                    <tr>
                        <th>Motivation</th>
                        <td>{{ document.motivation }}</td>
                    </tr>
                    <tr>
                        <th>Statut</th>
                        <td>
                            <span class="badge bg-{{ document.status == 'validé' ? 'success' : (document.status == 'en attente' ? 'warning' : 'danger') }}">
                                {{ document.status|upper }}
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Date de Création</th>
                        <td>{{ document.createdAt ? document.createdAt|date('d/m/Y H:i') : '' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <a href="{{ path('app_admin_document_index') }}" class="btn btn-secondary">Retour à la liste</a>
            <a href="{{ path('app_admin_document_edit', {'id': document.id}) }}" class="btn btn-warning">Modifier / Valider</a>
        </div>
    </div>
{% endblock %}
