{% extends 'admin/layout.html.twig' %}

{% block content_title %}Sponsor Management{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item active">Sponsor Management</li>
{% endblock %}

{% block content %}
<div class="row">
    <!-- Sponsors Card -->
    <div class="col-md-4">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-briefcase me-1"></i>
                    Sponsors
                </h3>
            </div>
            <div class="card-body text-center">
                <p>Manage all sponsorship offers and companies.</p>
                <a href="{{ path('app_admin_sponsor_index') }}" class="btn btn-primary btn-sm">Manage Sponsors</a>
            </div>
        </div>
    </div>

    <!-- Documents Card -->
    <div class="col-md-4">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-file-earmark-text me-1"></i>
                    Documents
                </h3>
            </div>
            <div class="card-body text-center">
                <p>Review and validate uploaded documents.</p>
                <a href="{{ path('app_admin_document_index') }}" class="btn btn-success btn-sm">Manage Documents</a>
            </div>
        </div>
    </div>

    <!-- Contracts Card -->
    <div class="col-md-4">
        <div class="card card-info card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-file-earmark-check me-1"></i>
                    Contracts
                </h3>
            </div>
            <div class="card-body text-center">
                <p>Oversee all signed sponsorship contracts.</p>
                <a href="{{ path('app_admin_contract_index') }}" class="btn btn-info btn-sm">Manage Contracts</a>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h3 class="card-title">Recent Activity</h3>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>User</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="4" class="text-center text-muted">No recent activity found.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
