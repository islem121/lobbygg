{% extends 'admin/layout.html.twig' %}

{% block content_title %}Détails du Contrat{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_sponsoring') }}">Sponsor Management</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_contract_index') }}">Contrats</a></li>
    <li class="breadcrumb-item active">Détails</li>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Informations sur le contrat</h3>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th>ID</th>
                        <td>{{ contract.id }}</td>
                    </tr>
                    <tr>
                        <th>Sponsor</th>
                        <td>{{ contract.sponsor.username }}</td>
                    </tr>
                    <tr>
                        <th>Client</th>
                        <td>{{ contract.client.username }}</td>
                    </tr>
                    <tr>
                        <th>Demande (Document)</th>
                        <td>ID #{{ contract.request.id }}</td>
                    </tr>
                    <tr>
                        <th>Date de Signature</th>
                        <td>{{ contract.createdAt ? contract.createdAt|date('d/m/Y H:i') : '' }}</td>
                    </tr>
                    <tr>
                        <th>Contenu</th>
                        <td><pre>{{ contract.content }}</pre></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <a href="{{ path('app_admin_contract_index') }}" class="btn btn-secondary">Retour à la liste</a>
            <a href="{{ path('app_admin_contract_edit', {'id': contract.id}) }}" class="btn btn-warning">Modifier</a>
        </div>
    </div>
{% endblock %}
