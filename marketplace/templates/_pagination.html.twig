{% if pages > 1 %}
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            {# Previous Button #}
            <li class="page-item {{ current_page <= 1 ? 'disabled' : '' }}">
                <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({'page': current_page - 1})) }}" aria-label="Précédent">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            {# Page Numbers #}
            {% for i in 1..pages %}
                {% if i == 1 or i == pages or (i >= current_page - 2 and i <= current_page + 2) %}
                    <li class="page-item {{ i == current_page ? 'active' : '' }}">
                        <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({'page': i})) }}">
                            {{ i }}
                        </a>
                    </li>
                {% elseif i == current_page - 3 or i == current_page + 3 %}
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                {% endif %}
            {% endfor %}

            {# Next Button #}
            <li class="page-item {{ current_page >= pages ? 'disabled' : '' }}">
                <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({'page': current_page + 1})) }}" aria-label="Suivant">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
{% endif %}
