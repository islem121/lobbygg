{% extends 'front/base.html.twig' %}

{% block title %}Ma Messagerie{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row g-0 shadow-lg rounded-3 overflow-hidden" style="height: 80vh; background: rgba(25, 10, 45, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(139, 61, 255, 0.3); color: #fff;">
        <!-- Liste des conversations (Sidebar) -->
        <div class="col-md-4 border-end bg-dark bg-opacity-25 d-flex flex-column" style="border-color: rgba(139, 61, 255, 0.2) !important;">
            <div class="p-3 border-bottom bg-dark bg-opacity-50" style="border-color: rgba(139, 61, 255, 0.2) !important;">
                <h5 class="mb-3 fw-bold text-white"><i class="fa-solid fa-comments me-2" style="color: #8B3DFF;"></i> Discussions</h5>
                
                <!-- Barre de recherche de contacts -->
                <form action="{{ path('app_messages_index') }}" method="GET" class="position-relative">
                    <input type="text" name="q" value="{{ searchQuery }}" class="form-control form-control-sm border-0 bg-dark bg-opacity-50 text-white rounded-pill px-3" 
                           placeholder="Rechercher un contact..." style="border: 1px solid rgba(139, 61, 255, 0.2) !important;">
                    <button type="submit" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-white-50 p-0 me-2" style="border:none;">
                        <i class="fa-solid fa-search small"></i>
                    </button>
                </form>
            </div>

            <div class="overflow-auto flex-grow-1" style="height: calc(80vh - 120px);">
                {% if searchResults is defined and searchResults|length > 0 %}
                    <div class="p-2 bg-primary bg-opacity-10 small fw-bold text-uppercase text-white-50 px-3">Résultats de recherche</div>
                    {% for result in searchResults %}
                        <a href="{{ path('app_messages_conversation', {id: result.id}) }}" 
                           class="list-group-item list-group-item-action border-0 p-3 d-flex align-items-center"
                           style="background: transparent; transition: all 0.3s ease; color: #fff;">
                            <div class="flex-shrink-0">
                                <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 40px; height: 40px;">
                                    {{ result.nom|first|upper }}{{ result.prenom|first|upper }}
                                </div>
                            </div>
                            <div class="ms-3 flex-grow-1">
                                <h6 class="mb-0 fw-bold text-white small">{{ result.nom }} {{ result.prenom }}</h6>
                                <small class="text-white-50">Démarrer une discussion</small>
                            </div>
                        </a>
                    {% endfor %}
                    <div class="border-bottom my-2" style="border-color: rgba(139, 61, 255, 0.1) !important;"></div>
                {% endif %}

                {% for lastMsg in lastMessages %}
                    {% set contact = (lastMsg.sender == app.user ? lastMsg.receiver : lastMsg.sender) %}
                    <a href="{{ path('app_messages_conversation', {id: contact.id}) }}" 
                       class="list-group-item list-group-item-action border-0 p-3 d-flex align-items-center {{ activeContact and activeContact.id == contact.id ? 'bg-primary bg-opacity-25 border-start border-primary border-4' : '' }}"
                       style="background: transparent; transition: all 0.3s ease; color: #fff;">
                        <div class="flex-shrink-0">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow" style="width: 48px; height: 48px; background: linear-gradient(45deg, #8B3DFF, #ff0080) !important;">
                                {{ contact.nom|first|upper }}{{ contact.prenom|first|upper }}
                            </div>
                        </div>
                        <div class="ms-3 flex-grow-1 overflow-hidden">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="mb-0 fw-bold text-truncate text-white">{{ contact.nom }} {{ contact.prenom }}</h6>
                                <small class="text-white-50" style="font-size: 0.75rem;">{{ lastMsg.createdAt|date('H:i') }}</small>
                            </div>
                            <p class="mb-0 text-white-50 text-truncate small">
                                {% if lastMsg.sender == app.user %}<i class="fa-solid fa-reply me-1 small"></i>{% endif %}
                                {{ lastMsg.content }}
                            </p>
                        </div>
                        {% if not lastMsg.isRead and lastMsg.receiver == app.user %}
                            <span class="badge bg-danger rounded-pill ms-2 shadow-sm">NEW</span>
                        {% endif %}
                    </a>
                {% else %}
                    <div class="p-4 text-center text-white-50">
                        <i class="fa-solid fa-message d-block mb-2 fs-1 opacity-25"></i>
                        <p>Aucune discussion pour le moment.</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Zone de chat (Main) -->
        <div class="col-md-8 d-flex flex-column bg-dark bg-opacity-10">
            {% if activeContact %}
                <!-- Header -->
                <div class="p-3 border-bottom bg-dark bg-opacity-50 d-flex align-items-center justify-content-between shadow-sm" style="border-color: rgba(139, 61, 255, 0.2) !important;">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold me-3" style="width: 40px; height: 40px; background: linear-gradient(45deg, #8B3DFF, #ff0080) !important;">
                            {{ activeContact.nom|first|upper }}{{ activeContact.prenom|first|upper }}
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-white">{{ activeContact.nom }} {{ activeContact.prenom }}</h6>
                            <small class="text-success fw-bold"><i class="fa-solid fa-circle me-1 small"></i> En ligne</small>
                        </div>
                    </div>
                </div>

                <!-- Messages -->
                <div id="message-container" class="flex-grow-1 overflow-auto p-4" style="background: rgba(0,0,0,0.2);">
                    {% for msg in messages %}
                        <div class="d-flex mb-3 {{ msg.sender == app.user ? 'justify-content-end' : '' }}">
                            <div class="max-width-75">
                                <div class="p-3 shadow-sm {{ msg.sender == app.user ? 'bg-primary text-white' : 'bg-dark bg-opacity-75 text-white border border-secondary' }}" 
                                     style="min-width: 100px; border-radius: 20px; {{ msg.sender == app.user ? 'border-bottom-right-radius: 4px;' : 'border-bottom-left-radius: 4px;' }}">
                                    {{ msg.content }}
                                </div>
                                <div class="mt-1 small text-white-50 {{ msg.sender == app.user ? 'text-end' : '' }}" style="font-size: 0.7rem;">
                                    {{ msg.createdAt|date('H:i') }}
                                    {% if msg.sender == app.user %}
                                        <i class="fa-solid fa-check-double ms-1 {{ msg.isRead ? 'text-info' : '' }}"></i>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Input -->
                <div class="p-3 bg-dark bg-opacity-50 border-top" style="border-color: rgba(139, 61, 255, 0.2) !important;">
                    <form id="chat-form" class="d-flex gap-2">
                        <input type="text" id="message-input" class="form-control border-0 bg-dark bg-opacity-50 text-white rounded-pill px-4" 
                               placeholder="Écrivez votre message..." autocomplete="off" style="border: 1px solid rgba(139, 61, 255, 0.3) !important;">
                        <button type="submit" class="btn btn-primary rounded-circle shadow" style="width: 45px; height: 45px; background: #8B3DFF; border: none;">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            {% else %}
                <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center text-white-50">
                    <i class="fa-solid fa-paper-plane d-block mb-3 display-1 opacity-10"></i>
                    <h5 class="fw-bold">Sélectionnez une conversation</h5>
                    <p>Commencez à discuter avec vos partenaires.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% if activeContact %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('message-container');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('message-input');
    
    // Scroll to bottom
    container.scrollTop = container.scrollHeight;

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        const content = input.value.trim();
        if (!content) return;

        input.value = '';
        input.disabled = true;

        fetch("{{ path('app_messages_send', {id: activeContact.id}) }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: content })
        })
        .then(response => response.json())
        .then(data => {
            input.disabled = false;
            input.focus();
            if (data.success) {
                const msgHtml = `
                    <div class="d-flex mb-3 justify-content-end">
                        <div class="max-width-75">
                            <div class="p-3 rounded-3 shadow-sm bg-primary text-white" style="min-width: 100px; border-radius: 18px !important; border-bottom-right-radius: 0 !important;">
                                ${data.message.content}
                            </div>
                            <div class="mt-1 small text-muted text-end" style="font-size: 0.7rem;">
                                ${data.message.createdAt} <i class="fa-solid fa-check ms-1"></i>
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', msgHtml);
                container.scrollTop = container.scrollHeight;
            } else {
                alert(data.error);
            }
        })
        .catch(error => {
            input.disabled = false;
            console.error('Error:', error);
        });
    });
});
</script>
{% endif %}

<style>
.max-width-75 { max-width: 75%; }
.bg-primary-subtle { background-color: #e7f1ff !important; }
.list-group-item:hover { background-color: #f8f9fa !important; }
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #ced4da; border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: #adb5bd; }
</style>
{% endblock %}
