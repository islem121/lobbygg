{% extends 'front/base.html.twig' %}

{% block title %}Lobby.gg • Marketplace{% endblock %}

{% block content %}
  <section class="page-head">
    <div>
      <h1 class="page-title">Marketplace</h1>
      <p class="page-sub">Browse drops and gear. Save items, share deals, and flex your setup.</p>
    </div>
    <div class="page-actions">
      <a class="btn btn-primary" href="{{ path('front_marketplace_cart') }}"><i class="fa-solid fa-bag-shopping"></i> Mon Panier</a>
      <button class="btn btn-ghost" type="button"><i class="fa-solid fa-bookmark"></i> Saved</button>
    </div>
  </section>

  <div class="panel">
    <div class="panel-head">
      <h2 class="panel-title"><i class="fa-solid fa-infinity"></i> Infinite Scroll Carousel</h2>
      <button class="btn btn-mini btn-ghost" type="button" data-carousel-pause><i class="fa-solid fa-pause"></i> Pause</button>
    </div>

    <div class="market-carousel big" data-infinite-carousel>
      <div class="market-track">
        {% for item in [
          {name:'Violet Rift Skin', price:'29.99', tag:'Epic'},
          {name:'Neon Mousepad XL', price:'19.90', tag:'Drop'},
          {name:'ARGB Keycaps', price:'39.00', tag:'Hot'},
          {name:'Headset Stand', price:'24.50', tag:'New'},
          {name:'Pro Controller', price:'69.00', tag:'Top'},
          {name:'Streamer Mic Arm', price:'44.00', tag:'Pro'},
          {name:'RGB Light Bars', price:'27.00', tag:'Glow'},
        ] %}
          <div class="market-item card" data-tilt>
            <div class="market-badge">{{ item.tag }}</div>
            <div class="market-name">{{ item.name }}</div>
            <div class="market-price">
              <span class="accent">{{ item.price }}</span> <span class="muted">DT</span>
            </div>
            <div class="row-actions">
              <button class="btn btn-mini btn-primary" type="button"><i class="fa-solid fa-bag-shopping"></i> Add</button>
              <button class="btn btn-mini btn-ghost" type="button"><i class="fa-solid fa-pen"></i> Edit</button>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <section class="grid">
    <div class="col span-8">
      <div class="panel">
        <div class="panel-head">
          <h2 class="panel-title"><i class="fa-solid fa-box-open"></i> Produits</h2>
        </div>

        {% if products is defined and products|length > 0 %}
          <div class="market-grid">
            {% for product in products %}
              <div class="market-item card" data-tilt>
                {% if product.image %}
                  <div class="market-image-container" style="height: 150px; overflow: hidden; border-radius: 4px; margin-bottom: 10px;">
                    <img src="{{ product.image starts with 'http' ? product.image : asset(product.image) }}" alt="{{ product.name }}" style="width: 100%; height: 100%; object-fit: cover;">
                  </div>
                {% endif %}
                <div class="market-badge">{{ product.category ? product.category.name : 'Général' }}</div>
                <div class="market-name">{{ product.name }}</div>
                <div class="market-price">
                  <span class="accent">{{ product.price|number_format(2, '.', ' ') }}</span> <span class="muted">DT</span>
                </div>
                <div class="market-stock">Stock: <span class="accent">{{ product.stock }}</span></div>
                <div class="row-actions">
                  <a class="btn btn-mini btn-primary" href="{{ path('front_marketplace_add', {id: product.id}) }}"><i class="fa-solid fa-bag-shopping"></i> Ajouter</a>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="empty-state">
            <p>Aucun produit disponible pour le moment.</p>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="col span-4">
      <div class="panel">
        <div class="panel-head">
          {% if cartItems is defined %}
            <h2 class="panel-title"><i class="fa-solid fa-bag-shopping"></i> Mon Panier</h2>
          {% else %}
            <h2 class="panel-title"><i class="fa-solid fa-wave-square"></i> Signals</h2>
          {% endif %}
        </div>
        {% if cartItems is defined %}
          <div class="table">
            <div class="row head">
              <div>Produit</div>
              <div>Qté</div>
              <div>Total</div>
            </div>
            {% for item in cartItems %}
              <div class="row">
                <div class="brand">{{ item.product.name }}</div>
                <div class="accent">{{ item.qty }}</div>
                <div>{{ item.lineTotal|number_format(2, '.', ' ') }} DT</div>
              </div>
            {% endfor %}
            <div class="row">
              <div class="brand">Total</div>
              <div></div>
              <div class="accent">{{ cartTotal|number_format(2, '.', ' ') }} DT</div>
            </div>
            <div class="row-actions" style="padding: 12px">
              <a class="btn btn-primary" href="{{ path('front_marketplace_checkout') }}"><i class="fa-solid fa-credit-card"></i> Passer la commande</a>
            </div>
          </div>
        {% else %}
          <div class="mini-kpis">
            <div class="kpi card">
              <div class="kpi-label">Conversions</div>
              <div class="kpi-value accent" data-countup data-to="931">0</div>
            </div>
            <div class="kpi card">
              <div class="kpi-label">Refunds</div>
              <div class="kpi-value" data-countup data-to="17">0</div>
            </div>
            <div class="kpi card">
              <div class="kpi-label">Avg. order</div>
              <div class="kpi-value" data-countup data-to="42">0</div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endblock %}


