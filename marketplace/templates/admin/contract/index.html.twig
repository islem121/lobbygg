{% extends 'admin/layout.html.twig' %}

{% block content_title %}Gestion des Contrats{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_admin_sponsoring') }}">Sponsor Management</a></li>
    <li class="breadcrumb-item active">Contrats</li>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Liste des Contrats Signés</h3>
        <div class="card-tools d-flex align-items-center">
            <div class="input-group input-group-sm mr-3" style="width: 200px;">
                <input type="text" id="contract-search" class="form-control float-right" placeholder="Rechercher...">
                <div class="input-group-append">
                    <button type="button" class="btn btn-default">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <button type="button" class="btn btn-info btn-sm mr-2" data-bs-toggle="modal" data-bs-target="#statsModal">
                <i class="bi bi-pie-chart-fill"></i> Statistiques
            </button>
            <a href="{{ path('app_admin_contract_new') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Nouveau Contrat
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th class="sortable" data-sort="id" style="cursor: pointer;">ID <i class="bi bi-arrow-down-up small"></i></th>
                    <th>Sponsor</th>
                    <th>Client</th>
                    <th class="sortable" data-sort="nomSociete" style="cursor: pointer;">Société <i class="bi bi-arrow-down-up small"></i></th>
                    <th>Contenu</th>
                    <th class="sortable" data-sort="createdAt" style="cursor: pointer;">Date <i class="bi bi-arrow-down-up small"></i></th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="contract-table-body">
                {{ include('admin/contract/_list.html.twig') }}
            </tbody>
        </table>
    </div>
    <div class="card-footer clearfix">
        {% include '_pagination.html.twig' %}
    </div>
</div>

<!-- Modal Statistiques -->
<div class="modal fade" id="statsModal" tabindex="-1" aria-labelledby="statsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content" style="background: #1a1a2e; color: #fff; border: 1px solid #8B3DFF;">
            <div class="modal-header" style="border-bottom: 1px solid #8B3DFF;">
                <h5 class="modal-title" id="statsModalLabel"><i class="bi bi-pie-chart-fill"></i> Contrats par Société</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div style="max-width: 400px; margin: 0 auto;">
                    <canvas id="contractStatsChart"></canvas>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #8B3DFF;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('contract-search');
    const tableBody = document.getElementById('contract-table-body');
    const sortableHeaders = document.querySelectorAll('.sortable');
    
    let timeout = null;
    let controller = null;
    let currentSort = 'id';
    let currentDirection = 'DESC';

    function updateTable() {
        if (controller) controller.abort();
        controller = new AbortController();

        const query = searchInput.value.trim();
        const url = `{{ path('app_admin_contract_search') }}?q=${encodeURIComponent(query)}&sort=${currentSort}&direction=${currentDirection}`;

        fetch(url, { signal: controller.signal })
            .then(response => response.text())
            .then(html => {
                tableBody.innerHTML = html;
            })
            .catch(error => {
                if (error.name !== 'AbortError') {
                    console.error('Erreur lors de la mise à jour:', error);
                }
            });
    }

    searchInput.addEventListener('input', function() {
        clearTimeout(timeout);
        timeout = setTimeout(updateTable, 300);
    });

    sortableHeaders.forEach(header => {
        header.addEventListener('click', function() {
            const sort = this.getAttribute('data-sort');
            
            if (currentSort === sort) {
                currentDirection = currentDirection === 'ASC' ? 'DESC' : 'ASC';
            } else {
                currentSort = sort;
                currentDirection = 'ASC';
            }

            sortableHeaders.forEach(h => {
                const icon = h.querySelector('i');
                icon.className = 'bi bi-arrow-down-up small';
            });
            const currentIcon = this.querySelector('i');
            currentIcon.className = currentDirection === 'ASC' ? 'bi bi-arrow-up small' : 'bi bi-arrow-down small';

            updateTable();
        });
    });

    // Graphique Stats
    let myChart = null;
    const statsModal = document.getElementById('statsModal');
    
    if (statsModal) {
        statsModal.addEventListener('shown.bs.modal', function () {
            fetch('{{ path('app_admin_contract_stats_data') }}')
                .then(response => response.json())
                .then(data => {
                    const labels = data.map(item => item.company);
                    const counts = data.map(item => item.count);

                    const ctx = document.getElementById('contractStatsChart').getContext('2d');
                    
                    if (myChart) {
                        myChart.destroy();
                    }

                    myChart = new Chart(ctx, {
                        type: 'pie',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: counts,
                                backgroundColor: [
                                    '#8B3DFF', '#00d2ff', '#ff0055', '#ffcc00', '#00ffcc', 
                                    '#9900ff', '#ff6600', '#33cc33', '#cc00cc', '#0066ff'
                                ],
                                borderWidth: 1,
                                borderColor: '#1a1a2e'
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: { color: '#fff' }
                                }
                            }
                        }
                    });
                })
                .catch(error => console.error('Erreur stats:', error));
        });
    }
});
</script>
{% endblock %}
