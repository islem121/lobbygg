{% extends 'admin/layout.html.twig' %}

{% block title %}Détails du Produit{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Produit : {{ product.name }}</h3>
            <div class="card-tools">
                <a href="{{ path('app_admin_product_index') }}" class="btn btn-secondary btn-sm">Retour à la liste</a>
                <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    {% if product.image %}
                        <img src="{{ product.image starts with 'http' ? product.image : asset(product.image) }}" alt="{{ product.name }}" class="img-fluid rounded shadow-sm">
                    {% else %}
                        <div class="bg-light d-flex align-items-center justify-content-center rounded shadow-sm" style="height: 200px;">
                            <span class="text-muted">Aucune image</span>
                        </div>
                    {% endif %}
                </div>
                <div class="col-md-8">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 200px;">ID</th>
                                <td>{{ product.id }}</td>
                            </tr>
                            <tr>
                                <th>Nom</th>
                                <td>{{ product.name }}</td>
                            </tr>
                            <tr>
                                <th>Catégorie</th>
                                <td>{{ product.category ? product.category.name : 'Non définie' }}</td>
                            </tr>
                            <tr>
                                <th>Prix</th>
                                <td>{{ product.price }} €</td>
                            </tr>
                            <tr>
                                <th>Stock</th>
                                <td>{{ product.stock }}</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>{{ product.description|nl2br }}</td>
                            </tr>
                            <tr>
                                <th>Date de création</th>
                                <td>{{ product.createdAt ? product.createdAt|date('d/m/Y H:i') : '-' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card-footer">
            {{ include('admin/product/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
