{% extends 'front/base.html.twig' %}

{% block title %}Profile View - LOBBY.GG{% endblock %}

{% block stylesheets %}
<style>
    .profile-view-container {
        max-width: 1100px;
        margin: 40px auto;
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 30px;
    }

    /* Left Sidebar: User Stats */
    .profile-sidebar {
        background: rgba(25, 10, 45, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(139, 61, 255, 0.3);
        border-radius: 12px;
        padding: 30px;
        height: fit-content;
    }

    .profile-avatar-large {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #8B3DFF, #ff0080);
        border-radius: 50%;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        font-weight: bold;
        color: #fff;
        box-shadow: 0 0 30px rgba(139, 61, 255, 0.4);
        border: 4px solid rgba(255, 255, 255, 0.1);
        position: relative;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .profile-avatar-large img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .avatar-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        font-size: 24px;
        color: #fff;
    }

    .profile-avatar-large:hover .avatar-overlay {
        opacity: 1;
    }

    .profile-avatar-large:hover {
        transform: scale(1.05);
        box-shadow: 0 0 40px rgba(139, 61, 255, 0.6);
    }

    .profile-name-big {
        text-align: center;
        font-family: 'Courier New', monospace;
        color: #fff;
        font-size: 20px;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .profile-role-tag {
        text-align: center;
        color: #ff0080;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 30px;
    }

    .stat-box {
        background: rgba(0, 0, 0, 0.3);
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 15px;
        border-left: 2px solid #8B3DFF;
    }

    .stat-label {
        color: rgba(255, 255, 255, 0.4);
        font-size: 10px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .stat-value {
        color: #fff;
        font-size: 18px;
        font-weight: bold;
        font-family: 'Courier New', monospace;
    }

    /* Main Content: History */
    .profile-main {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .history-panel {
        background: rgba(25, 10, 45, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(139, 61, 255, 0.3);
        border-radius: 12px;
        padding: 30px;
    }

    .panel-title {
        font-family: 'Courier New', monospace;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(139, 61, 255, 0.2);
        padding-bottom: 10px;
    }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .history-item {
        background: rgba(0, 0, 0, 0.2);
        padding: 15px;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
    }

    .history-item:hover {
        background: rgba(139, 61, 255, 0.05);
        border-color: rgba(139, 61, 255, 0.2);
    }

    .item-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .item-icon {
        width: 40px;
        height: 40px;
        background: rgba(139, 61, 255, 0.1);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8B3DFF;
    }

    .item-name {
        color: #fff;
        font-size: 14px;
        font-weight: bold;
    }

    .item-date {
        color: rgba(255, 255, 255, 0.4);
        font-size: 11px;
    }

    .item-price {
        color: #ff0080;
        font-family: 'Courier New', monospace;
        font-weight: bold;
    }

    .item-details {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.5);
        margin-top: 4px;
    }

    .contract-period {
        display: inline-block;
        padding: 2px 8px;
        background: rgba(139, 61, 255, 0.1);
        border: 1px solid rgba(139, 61, 255, 0.3);
        border-radius: 4px;
        color: #8B3DFF;
        font-size: 10px;
        margin-left: 10px;
    }

    .empty-msg {
        color: rgba(255, 255, 255, 0.3);
        text-align: center;
        padding: 20px;
        font-style: italic;
        font-size: 13px;
    }
</style>
{% endblock %}

{% block content %}
<div class="profile-view-container">
    <!-- Sidebar -->
    <aside class="profile-sidebar">
        <form id="avatar-form" action="{{ path('app_user_update_image') }}" method="POST" enctype="multipart/form-data">
            <div class="profile-avatar-large" onclick="document.getElementById('avatar-input').click();">
                {% if user.image %}
                    <img src="{{ asset('uploads/profiles/' ~ user.image) }}" alt="Profile Picture">
                {% else %}
                    {{ user.prenom|first|upper }}
                {% endif %}
                <div class="avatar-overlay">
                    <i class="fa-solid fa-camera"></i>
                </div>
            </div>
            <input type="file" id="avatar-input" name="profile_image" style="display: none;" onchange="document.getElementById('avatar-form').submit();" accept="image/*">
        </form>
        <h2 class="profile-name-big">{{ user.prenom|upper }}</h2>
        <p class="profile-role-tag">{% if 'ROLE_SPONSOR' in user.roles %}SPONSOR{% else %}JOUEUR CLIENT{% endif %}</p>

        <div class="stat-box">
            <div class="stat-label">Total Spent</div>
            <div class="stat-value">0.00 DT</div>
        </div>

        <div class="stat-box">
            <div class="stat-label">Tournaments Joined</div>
            <div class="stat-value">0</div>
        </div>

        <div class="stat-box">
            <div class="stat-label">Marketplace Items</div>
            <div class="stat-value">0</div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="profile-main">
        <!-- Marketplace History -->
        <section class="history-panel">
            <h3 class="panel-title"><i class="fa-solid fa-cart-shopping"></i> Marketplace History</h3>
            <div class="history-list">
                {% if marketplace_history %}
                    {% for item in marketplace_history %}
                        <div class="history-item">
                            <div class="item-info">
                                <div class="item-icon"><i class="fa-solid fa-tag"></i></div>
                                <div>
                                    <div class="item-name">{{ item.name }}</div>
                                    <div class="item-date">Purchased on {{ item.date }}</div>
                                </div>
                            </div>
                            <div class="item-price">{{ item.price }} DT</div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-msg">No items purchased yet. Start shopping in the marketplace!</div>
                {% endif %}
            </div>
        </section>

        <!-- Games/Tournaments -->
        <section class="history-panel">
            <h3 class="panel-title"><i class="fa-solid fa-trophy"></i> Activity & Tournaments</h3>
            <div class="history-list">
                {% if games_played %}
                    {% for game in games_played %}
                        <div class="history-item">
                            <div class="item-info">
                                <div class="item-icon"><i class="fa-solid fa-gamepad"></i></div>
                                <div>
                                    <div class="item-name">{{ game.name }}</div>
                                    <div class="item-date">Played on {{ game.date }}</div>
                                </div>
                            </div>
                            <div class="item-price">{{ game.result }}</div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-msg">No tournament activity found. Join your first tournament today!</div>
                {% endif %}
            </div>
        </section>

        <!-- Sponsoring History -->
        <section class="history-panel">
            <h3 class="panel-title"><i class="fa-solid fa-handshake"></i> Sponsoring History</h3>
            <div class="history-list">
                {% if sponsoring_history %}
                    {% for contract in sponsoring_history %}
                        <div class="history-item">
                            <div class="item-info">
                                <div class="item-icon"><i class="fa-solid fa-file-contract"></i></div>
                                <div>
                                    <div class="item-name">Sponsorship with {{ contract.sponsor_name }}</div>
                                    <div class="item-details">
                                        Contract signed: {{ contract.sign_date }}
                                        <span class="contract-period">
                                            <i class="fa-regular fa-calendar-days"></i> {{ contract.start_year }} - {{ contract.end_year }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="item-price">{{ contract.status|upper }}</div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-msg">No sponsoring contracts found yet.</div>
                {% endif %}
            </div>
        </section>
    </main>
</div>
{% endblock %}
